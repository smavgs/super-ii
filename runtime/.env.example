# Bind to localhost unless a private reverse proxy is configured.
SUPERII_HOST=127.0.0.1
SUPERII_PORT=8788
SUPERII_STORAGE_ROOT=./data
SUPERII_DATABASE_URL=
SUPERII_RUNTIME_TOKEN=
SUPERII_MAX_UPLOAD_BYTES=10737418240
SUPERII_CLAMAV_COMMAND=clamdscan
SUPERII_CLAMAV_CONFIG_FILE=/etc/clamav/clamd-client.conf
SUPERII_GITLEAKS_COMMAND=gitleaks
SUPERII_LLAMA_CLI_COMMAND=llama-cli
SUPERII_LLAMA_SERVER_COMMAND=llama-server
SUPERII_PUBLIC_BASE_URL=http://127.0.0.1:8788
SUPERII_SPACES_IMAGE=superii/gradio-space:0.1.0
SUPERII_SEMANTIC_SEARCH_ENABLED=false
SUPERII_VLLM_ENABLED=false

# Offline is mandatory for repository inspection and inference.
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
TRANSFORMERS_OFFLINE=1
