<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>site.superii.transfer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SUPERII_RUNTIME_ROOT__/run-transfer-macos.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SUPERII_RUNTIME_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__SUPERII_LOG_ROOT__/superii-transfer.log</string>
  <key>StandardErrorPath</key>
  <string>__SUPERII_LOG_ROOT__/superii-transfer-error.log</string>
</dict>
</plist>
