{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "super-ii-site",
  "main": "./src/worker.ts",
  "triggers": { "crons": ["17 * * * *"] },
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 10000 },
  "ratelimits": [
    { "name": "REQUEST_RATE_LIMITER", "namespace_id": "2026112001", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "2026112002", "simple": { "limit": 240, "period": 60 } }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "r2_buckets": [
    {
      "binding": "SHOWCASE_MEDIA",
      "bucket_name": "superii-showcase-media"
    }
  ],
  "routes": [
    {
      "pattern": "superii.site",
      "custom_domain": true
    },
    {
      "pattern": "www.superii.site",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  }
}
