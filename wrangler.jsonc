{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "super-ii-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "r2_buckets": [
    {
      "binding": "SHOWCASE_MEDIA",
      "bucket_name": "superii-showcase-media"
    }
  ],
  "routes": [
    {
      "pattern": "superii.site",
      "custom_domain": true
    },
    {
      "pattern": "www.superii.site",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  }
}
