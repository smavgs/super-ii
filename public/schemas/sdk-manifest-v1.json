{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superii.site/schemas/sdk-manifest-v1.json",
  "title": "Super ii immutable SDK manifest",
  "type": "object",
  "required": [
    "schema",
    "repository",
    "revision",
    "files",
    "compatibility",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "https://superii.site/schemas/sdk-manifest-v1.json"
    },
    "repository": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "slug",
        "visibility"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "id",
        "commit_sha",
        "manifest_sha256",
        "total_size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "commit_sha": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "total_size_bytes": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "download_url"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "size_bytes": {
            "$ref": "#/$defs/size"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "download_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "compatibility": {
      "type": [
        "object",
        "null"
      ]
    },
    "publication": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "payload",
        "signature",
        "key_id"
      ],
      "properties": {
        "payload": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    }
  }
}
