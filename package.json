{
  "name": "super-ii-website",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "The fast, public AI collaboration hub for Super ii.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "./scripts/build.sh",
    "check": "astro check",
    "preview": "wrangler dev",
    "validate": "python3 tools/validate_site.py && python3 tools/validate_notebooks.py && ./scripts/verify-use-model.sh && go run ./tools/releasecheck ./src/content/site.json && node tools/check-use-model.mjs && node tools/check-routes.mjs && node tools/check-super-assistant.mjs && node --experimental-strip-types tools/check-security-hardening.mjs && node tools/check-social-metadata.mjs && node tools/check-responsive-layout.mjs && node tools/check-social-web.mjs && node tools/check-participation.mjs",
    "db:check": "python3 tools/validate_migrations.py",
    "db:test": "./scripts/test-postgres.sh",
    "runtime:verify": "./scripts/verify-runtime.sh",
    "use-model:verify": "./scripts/verify-use-model.sh",
    "social:check": "node tools/check-social-metadata.mjs",
    "social-web:check": "node tools/check-social-web.mjs",
    "responsive:check": "node tools/check-responsive-layout.mjs",
    "deploy": "./scripts/deploy.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@clerk/astro": "4.0.19",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@neondatabase/serverless": "1.1.0",
    "@noble/hashes": "2.4.0",
    "@phosphor-icons/web": "2.1.2",
    "agents": "0.22.0",
    "astro": "7.2.8",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.10",
    "markdown-it": "15.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/node": "26.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.126.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "nanoid": "5.1.16",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true,
    "fsevents": false
  }
}
