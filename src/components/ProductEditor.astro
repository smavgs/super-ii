---
import { translateProduct } from "@/lib/product-localization";
import type { ProductDraft } from "@/lib/products";
import {
  emptyCompany,
  emptyProduct,
  productKinds,
  productStages,
  resourceKinds,
} from "@/lib/products";
import type { companyWorkspace } from "@/lib/product-store";
import "@/styles/products.css";
interface Props {
  draft?: ProductDraft | null;
  workspace?: Awaited<ReturnType<typeof companyWorkspace>>;
  signedIn?: boolean;
  unavailable?: boolean;
}
const {
  draft = null,
  workspace = { companies: [], products: [] },
  signedIn = false,
  unavailable = false,
} = Astro.props;
const t = (text: string) => translateProduct(text, Astro.locals.locale);
const company = draft?.company ?? emptyCompany();
const product = draft?.product ?? emptyProduct();
const companyFields = [
  ["name", "Company name", 160],
  ["name_zh", "Company name in Chinese", 160],
  ["summary", "About the company", 600],
  ["summary_zh", "About the company in Chinese", 600],
  ["website", "Company website", 2048],
  ["logo_url", "Logo link (optional)", 2048],
] as const;
const productFields = [
  ["name", "Product name", 160],
  ["name_zh", "Product name in Chinese", 160],
  ["summary", "What does it do?", 600],
  ["summary_zh", "Purpose in Chinese", 600],
  ["description", "Product details", 12000],
  ["description_zh", "Product details in Chinese", 12000],
  ["source_url", "Original product page (optional)", 2048],
] as const;
---

<section
  class="shell product-editor"
  data-product-editor
  data-signed-in={String(signedIn)}
  data-initial={JSON.stringify({ draft, workspace })}
>
  <nav class="product-breadcrumb">
    <a href="/account">Workspace</a><span aria-hidden="true"> / </span><a
      href="/workspace/products">Company and products</a
    >
  </nav>
  <header>
    <p class="eyebrow">Your company. Your product.</p><h1>
      {draft ? "Edit your product page" : "Give your product a home"}
    </h1><p>
      Help people understand it, find its resources and reach the right person.
    </p>
  </header>
  {
    unavailable && (
      <p role="alert">
        Saved work is temporarily unavailable. Refresh before continuing.
      </p>
    )
  }
  {
    !signedIn && (
      <p class="product-notice">
        Try the preview first. Sign in to save your company and product. Nothing
        is published automatically.
      </p>
    )
  }
  <noscript
    ><p>
      This editor needs JavaScript. Public product pages and resource links
      remain readable without it.
    </p></noscript
  >
  <div class="product-editor-layout">
    <form data-product-form novalidate>
      <details name="product-editor-section" open>
        <summary>1. Company</summary><div class="product-fields">
          {
            !draft && (
              <>
                <label>
                  Company owner
                  <select data-company-owner>
                    <option value="">Create my company</option>
                    {workspace.companies.map((org) => (
                      <option value={org.id} data-no-translate>
                        {org.name || org.handle}
                      </option>
                    ))}
                  </select>
                </label>
                <label data-company-handle-label>
                  Company address
                  <>
                    <input
                      name="handle"
                      maxlength="40"
                      pattern="[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?"
                      placeholder="your-company"
                      data-no-translate
                    />
                    <small>
                      Lowercase letters, numbers and hyphens. This becomes your
                      company URL.
                    </small>
                  </>
                </label>
              </>
            )
          }
          <div class="product-source-entry">
            <label
              >Start from a website (optional)<input
                type="url"
                data-source-url
                placeholder="https://…"
                maxlength="2048"
                data-no-translate
              /></label
            ><button
              class="button button--secondary button--small"
              type="button"
              data-source-read>Suggest details</button
            ><p>
              Use a public company or product page, or enter your details below.
            </p><div data-source-result hidden>
              <p data-source-notice></p><a
                data-source-link
                rel="noopener noreferrer"
                target="_blank"></a><p data-source-summary data-no-translate>
              </p><button
                type="button"
                class="button button--secondary button--small"
                data-source-apply>Use these suggestions in empty fields</button
              >
            </div>
          </div>
          {
            companyFields.map(([key, label, max]) => (
              <label>
                {t(label)}
                {max === 600 ? (
                  <textarea
                    name={`company.${key}`}
                    maxlength={max}
                    rows="2"
                    data-no-translate
                    set:text={company[key]}
                  />
                ) : (
                  <input
                    name={`company.${key}`}
                    type={
                      key.endsWith("url") || key === "website" ? "url" : "text"
                    }
                    value={company[key]}
                    maxlength={max}
                    data-no-translate
                  />
                )}
              </label>
            ))
          }
          <p>Chinese fields are optional. Your own wording is preserved.</p>
        </div>
      </details>
      <details name="product-editor-section">
        <summary>2. Product</summary><div class="product-fields">
          <div class="product-field-pair">
            <label
              >Product type<select name="product.kind"
                >{
                  productKinds.map((kind) => (
                    <option value={kind} selected={product.kind === kind}>
                      {kind}
                    </option>
                  ))
                }</select
              ></label
            ><label
              >Availability<select name="product.stage"
                >{
                  productStages.map((stage) => (
                    <option value={stage} selected={product.stage === stage}>
                      {stage}
                    </option>
                  ))
                }</select
              ></label
            >
          </div>
          {
            !draft && (
              <label>
                Product address
                <>
                  <input
                    name="slug"
                    maxlength="80"
                    placeholder="your-product"
                    data-no-translate
                  />
                  <small>
                    Choose once. Your shared links keep this address.
                  </small>
                </>
              </label>
            )
          }
          {
            productFields.map(([key, label, max]) => (
              <label>
                {t(label)}
                {max === 600 || max === 12000 ? (
                  <textarea
                    name={`product.${key}`}
                    maxlength={max}
                    rows={max === 12000 ? 5 : 2}
                    data-no-translate
                    set:text={product[key]}
                  />
                ) : (
                  <input
                    name={`product.${key}`}
                    value={product[key]}
                    maxlength={max}
                    type={key === "source_url" ? "url" : "text"}
                    data-no-translate
                  />
                )}
              </label>
            ))
          }
        </div>
      </details>
      <details name="product-editor-section">
        <summary>3. Images</summary><div class="product-fields">
          <p>
            Choose up to three company images. Reusing an image uses no new
            upload.
          </p><div data-product-media class="product-media-options"></div>
          <p data-image-quota>
            Three successful Showcase uploads per member account, for its
            lifetime. Removing an image does not restore an upload.
          </p>
          <p>
            Company images are public whenever the company page is public,
            including images uploaded while editing a draft.
          </p>
          <label
            >Choose a product image<input
              type="file"
              accept="image/*"
              data-image-file
            /></label
          ><img
            data-image-preview
            alt="Selected image preview"
            hidden
            width="384"
            height="240"
          />
          <label
            >Describe the image<input
              data-image-alt
              maxlength="240"
              placeholder="Describe what a visitor can see"
            /></label
          ><button
            class="button button--secondary"
            type="button"
            data-image-upload>Save and upload image</button
          >
        </div>
      </details>
      <details name="product-editor-section">
        <summary>4. Specifications and resources</summary><div
          class="product-fields"
        >
          <p>
            Link a datasheet, SDK, source, video or existing Super ii
            repository. Private source code can stay private.
          </p>
          <h3>Specifications</h3><div data-specs></div><button
            class="text-button"
            type="button"
            data-add-spec>Add a specification</button
          >
          <h3>Technical resources</h3><div data-resources></div><button
            class="text-button"
            type="button"
            data-add-resource>Add a resource link</button
          >
        </div>
      </details>
      <details name="product-editor-section">
        <summary>5. Contact and ownership</summary><div class="product-fields">
          <p>
            Add at least one public contact method. These details belong to the
            company; your personal Card remains yours.
          </p>
          {
            (["email", "phone", "wechat"] as const).map((key) => (
              <label>
                {key === "email"
                  ? "Company email"
                  : key === "phone"
                    ? "Company phone"
                    : "WeChat ID"}
                <input
                  name={`company.${key}`}
                  type={
                    key === "email" ? "email" : key === "phone" ? "tel" : "text"
                  }
                  value={company[key]}
                  maxlength={key === "email" ? 254 : key === "phone" ? 40 : 100}
                  data-no-translate
                />
              </label>
            ))
          }
          <label
            >Representative Card (optional)<select data-card-choice
              ><option value="">Choose one of my published Cards</option
              ></select
            ></label
          >
          <label
            >Or paste a company member’s published Card link<input
              name="company.representative_card_url"
              type="url"
              value={company.representative_card_url}
              maxlength="200"
              data-no-translate
            /></label
          >
          <p>
            Linking a Card makes its published information discoverable from
            this product. Pausing or rotating the Card removes this link.
          </p><a href="/account#cards" target="_blank" rel="noopener"
            >{t("Open my Cards ↗")}</a
          >
          <details class="product-optional">
            <summary>Optional website control check</summary><p>
              Confirm control of your exact website hostname with a DNS TXT
              record. This does not verify company identity or product quality.
            </p><button
              class="button button--secondary button--small"
              type="button"
              data-website-start>Get TXT record</button
            ><pre data-website-record hidden></pre><button
              type="button"
              class="button button--secondary button--small"
              data-website-check
              hidden>Check TXT record</button
            ><p data-website-status role="status"></p>
          </details>
        </div>
      </details>
      <div class="product-save-bar">
        <button class="button button--dark" type="submit" disabled={unavailable}
          >Save draft</button
        ><span data-draft-state>Private until you publish</span>
      </div>
      <p
        class="product-editor-status"
        data-editor-status
        role="status"
        aria-live="polite"
      >
      </p>
      <section class="product-publish">
        <h2>Ready to share?</h2><p>
          Publishing updates this product and the shared company details on all
          its product pages.
        </p>
        <label class="product-check"
          ><input type="checkbox" data-authorized />I am authorized to publish
          for this company and have reviewed the public details, images and Card
          link.</label
        >
        <button
          class="button button--dark"
          type="button"
          data-publish
          disabled={unavailable}>Publish company and product</button
        >
        <button
          type="button"
          class="text-button"
          data-pause
          hidden={!draft || draft.status !== "published"}
          >Pause this product page</button
        >
        <div data-share-result hidden>
          <h3>Your page is ready to share</h3><a
            data-public-link
            target="_blank"
            rel="noopener">Open product page ↗</a
          ><div class="button-row">
            <button
              type="button"
              data-copy-link
              class="button button--secondary">Copy page link</button
            ><a data-sheet-link>Bilingual product sheet</a><a
              data-qr-link
              download>Download QR</a
            >
          </div><img
            data-share-qr
            alt="Product page QR code"
            width="140"
            height="140"
          />
        </div>
      </section>
    </form>
    <aside class="product-live-preview" aria-label="Product preview">
      <button
        type="button"
        class="product-preview-toggle"
        data-preview-toggle
        aria-expanded="false">Preview your product</button
      ><p class="eyebrow">Live preview · not published</p><div
        class="product-preview-body"
        data-preview
      >
        <img data-preview-logo alt="" width="48" height="48" hidden /><p
          data-preview-company
          data-no-translate
        >
        </p><img data-preview-image alt="" hidden /><p
          class="eyebrow"
          data-preview-kind
        >
        </p><h2 data-preview-title data-no-translate></h2><p
          data-preview-summary
          data-no-translate
        >
        </p><p data-preview-description data-no-translate></p><div
          data-preview-specs
          data-no-translate
        >
        </div><div data-preview-resources data-no-translate></div><h3>Contact</h3><p
          data-preview-contact
          data-no-translate
        >
        </p>
      </div><p>Company-provided information. Preview updates as you type.</p>
    </aside>
  </div>
  <template data-spec-template
    ><fieldset class="product-repeat">
      <legend>Specification</legend><label
        >Label<input
          data-field="label"
          maxlength="100"
          data-no-translate
        /></label
      ><label
        >Value<input
          data-field="value"
          maxlength="500"
          data-no-translate
        /></label
      ><label
        >Chinese label (optional)<input
          data-field="label_zh"
          maxlength="100"
          data-no-translate
        /></label
      ><label
        >Chinese value (optional)<input
          data-field="value_zh"
          maxlength="500"
          data-no-translate
        /></label
      ><label
        >Source link (optional)<input
          type="url"
          data-field="source_url"
          maxlength="2048"
          data-no-translate
        /></label
      ><button type="button" class="text-button" data-remove-row>Remove</button>
    </fieldset></template
  >
  <template data-resource-template
    ><fieldset class="product-repeat">
      <legend>Resource</legend><label
        >Label<input
          data-field="label"
          maxlength="100"
          data-no-translate
        /></label
      ><label
        >Chinese label (optional)<input
          data-field="label_zh"
          maxlength="100"
          data-no-translate
        /></label
      ><label
        >Resource type<select data-field="kind"
          >{
            resourceKinds.map((kind) => <option value={kind}>{kind}</option>)
          }</select
        ></label
      ><label
        >Resource link<input
          type="url"
          data-field="url"
          maxlength="2048"
          data-no-translate
        /></label
      ><button type="button" class="text-button" data-remove-row>Remove</button>
    </fieldset></template
  >
</section>
<script>
  import "@/scripts/product-editor";
</script>
