---
import CreatorLink from '@/components/CreatorLink.astro';
import BrandMark from '@/components/BrandMark.astro';
import type { LinkedWorkItem } from '@/lib/linked-work';
import { ollamaPagePath } from '@/lib/ollama';
import { hfPagePath } from '@/lib/hf-catalogue';
interface Props { item: LinkedWorkItem; showOwner?: boolean; profileFilter?: boolean }
const {item,showOwner=true,profileFilter=false}=Astro.props;
const provider=item.provider==='ollama'?'Ollama':item.provider==='google-drive'?'Google Drive':'Hugging Face';
const local=item.provider!=='huggingface'||item.is_curated;
const href=item.is_curated?hfPagePath(item):item.provider==='ollama'?ollamaPagePath(item):item.provider==='google-drive'?`/linked/${item.id}`:item.source_url;
---
<article class="catalog-card catalog-card--external" data-profile-work-item={profileFilter||undefined} data-kind={profileFilter?item.kind:undefined}>
  <div class="catalog-card__topline">{showOwner?<CreatorLink compact kind={item.owner_type} handle={item.owner_handle} displayName={item.owner_display_name} avatarUrl={item.owner_avatar_url} />:<span data-no-translate>{item.provider==='google-drive'?item.owner_display_name:item.provider_repo_id}</span>}<span class="origin-badge origin-badge--external">{item.provider==='ollama'?<img src="/brand/ollama.svg" width="20" height="20" alt="" loading="lazy" style="background:white;padding:2px;border-radius:3px" />:<BrandMark brand={item.provider} size="xs" />}<span data-no-translate>External · {provider}</span></span></div>
  <h3><a class="catalog-card__title-link" href={href} target={local?undefined:'_blank'} rel={local?undefined:'ugc nofollow noopener noreferrer'} data-no-translate>{item.title}</a></h3>
  <p data-no-translate>{item.summary||`Files remain with ${provider}.`}</p>
  <div class="catalog-card__metadata"><span>{item.kind === 'space' ? 'App' : item.kind === 'dataset' ? 'Dataset' : 'Model'}</span>{item.is_curated&&<span>Curated listing</span>}{item.is_curated&&<span><span>Source publisher</span>: <span data-no-translate>{item.provider_namespace}</span></span>}{item.is_curated&&Boolean(item.source_metadata.gated)&&<span>Access required</span>}{item.is_curated&&item.kind==='space'&&!['RUNNING','RUNNING_BUILDING','SLEEPING'].includes(String(item.source_metadata.runtime_stage))&&<span>Currently unavailable on Hugging Face</span>}{item.license&&<span data-no-translate>{item.license}</span>}{['task','library','format'].map(key=>typeof item.source_metadata[key]==='string'&&<span data-no-translate>{String(item.source_metadata[key])}</span>)}{item.provider==='ollama'&&<span>{item.file_count>0?'Source files available':'Check source availability'}</span>}{item.provider==='huggingface'&&item.provider_downloads!==null&&<span title="Downloads reported by Hugging Face">HF ⬇️ {Number(item.provider_downloads).toLocaleString()}</span>}{item.provider==='huggingface'&&item.provider_likes!==null&&<span title="Likes reported by Hugging Face">HF ❤️ {Number(item.provider_likes).toLocaleString()}</span>}</div>
  <a class="catalog-card__open" href={href} target={local?undefined:'_blank'} rel={local?undefined:'ugc nofollow noopener noreferrer'} aria-label={`Open ${item.title}`}><span>{item.provider==='ollama'?<img src="/brand/ollama.svg" width="20" height="20" alt="" loading="lazy" style="background:white;padding:2px;border-radius:3px" />:<BrandMark brand={item.provider} size="xs" />}{item.provider==='ollama'?'Open model':item.provider==='google-drive'?'Open shared page':item.is_curated?(item.kind==='dataset'?'Open dataset':'Open app'):'Open on Hugging Face'}</span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
</article>
