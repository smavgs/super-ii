---
import '@/styles/workrooms.css';
---
<section class="workroom-hub" data-workroom-hub aria-labelledby="workrooms-title">
  <div class="workspace-panel-heading"><div><h3 id="workrooms-title">Work in progress</h3><p>Keep your goal, next action and results together.</p></div><a class="button button--secondary button--small" href="/workspace/workrooms/new"><i class="ph ph-plus-square" aria-hidden="true"></i>New workroom</a></div>
  <div class="workroom-filter" hidden data-room-filters>
    <label>Find a workroom<input type="search" data-room-search placeholder="Search your work" /></label>
    <label>Status<select data-room-filter><option value="current">In progress</option><option value="complete">Complete</option><option value="archived">Archived</option><option value="all">All work</option></select></label>
  </div>
  <p data-room-list-status role="status">Loading your workrooms…</p>
  <div data-room-list class="workroom-list"></div>
  <button type="button" class="text-button" data-room-more hidden>Show more workrooms</button>
  <noscript><p>Enable JavaScript to load and save your private workrooms. Your repositories remain available below.</p></noscript>
</section>
<script>import '../scripts/workrooms';</script>
