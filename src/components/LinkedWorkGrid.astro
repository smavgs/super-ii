---
import LinkedWorkCard from '@/components/LinkedWorkCard.astro';
import type { LinkedWorkItem } from '@/lib/linked-work';
interface Props { items: LinkedWorkItem[]; heading?: string; showOwner?: boolean }
const {items,heading,showOwner=false}=Astro.props;
---
{items.length>0&&<section class="linked-work-section">
  {heading&&<div class="repository-section__heading"><div><p class="eyebrow">External work</p><h2>{heading}</h2></div><span>{items.length}</span></div>}
  <div class="catalog-results linked-work-grid">{items.map(item=><LinkedWorkCard item={item} showOwner={showOwner} />)}</div>
</section>}
