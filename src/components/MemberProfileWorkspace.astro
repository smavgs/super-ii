---
import type { EditableMemberProfile } from '@/lib/member-profile';

type WorkspaceProfile = EditableMemberProfile & {
  id: string;
  handle: string;
  display_name: string;
  avatar_url: string | null;
};

interface Props {
  profile: WorkspaceProfile;
  showcase: Array<{ id: string; title: string; caption: string; alt_text: string; link_url: string | null; position: number; width: number; height: number }>;
  uploadsRemaining: number;
}

const { profile, showcase, uploadsRemaining } = Astro.props;
const emptySlots = Math.max(0, Math.min(3 - showcase.length, uploadsRemaining));
---

<section class="account-card member-profile-workspace" id="profile" data-member-profile-workspace>
  <div class="member-profile-workspace__heading">
    <div>
      <p class="eyebrow">Public profile</p>
      <h2>How people find you</h2>
      <p>Add a short introduction, your interests, and the places where people can see more of your work.</p>
    </div>
    <a class="button button--secondary button--small" href={`/people/${encodeURIComponent(profile.handle)}`}>View public profile <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
  </div>

  <div class="member-profile-workspace__identity">
    {profile.avatar_url
      ? <img src={profile.avatar_url} alt="" referrerpolicy="no-referrer" />
      : <span aria-hidden="true">{profile.display_name.slice(0, 1).toUpperCase()}</span>}
    <div><strong>{profile.display_name}</strong><small>@{profile.handle}</small></div>
    <p>Your name and photo come from your login profile. You can change them in <a href="#identity">Identity and security</a>.</p>
  </div>

  <form class="member-profile-form" data-member-profile-form>
    <label class="member-profile-form__wide">
      <span>Profile type</span>
      <select name="profile_kind">
        <option value="person" selected={profile.profile_kind === 'person'}>Person</option>
        <option value="studio" selected={profile.profile_kind === 'studio'}>Independent studio</option>
        <option value="company" selected={profile.profile_kind === 'company'}>Single-owner company</option>
      </select>
      <small>Studio and company profiles remain single-owner member profiles. Use an Organization when you need shared roles or verified team governance.</small>
    </label>
    <label class="member-profile-form__wide">
      <span>About you</span>
      <textarea name="bio" maxlength="500" rows="4" placeholder="What are you building or exploring?">{profile.bio ?? ''}</textarea>
      <small>Up to 500 characters.</small>
    </label>
    <label class="member-profile-form__wide">
      <span>Interests</span>
      <input name="interests" type="text" maxlength="1000" value={profile.interests.join(', ')} placeholder="Local AI, agents, datasets" />
      <small>Separate up to 12 interests with commas.</small>
    </label>
    <label>
      <span><i class="ph ph-x-logo" aria-hidden="true"></i> X username</span>
      <input name="x_username" type="text" maxlength="51" value={profile.x_username ?? ''} autocomplete="off" placeholder="superiisite" />
    </label>
    <label>
      <span><i class="ph ph-github-logo" aria-hidden="true"></i> GitHub username</span>
      <input name="github_username" type="text" maxlength="40" value={profile.github_username ?? ''} autocomplete="off" placeholder="your-name" />
    </label>
    <label>
      <span><i class="ph ph-linkedin-logo" aria-hidden="true"></i> LinkedIn</span>
      <input name="linkedin_url" type="url" maxlength="2048" value={profile.linkedin_url ?? ''} inputmode="url" placeholder="https://www.linkedin.com/in/…" />
    </label>
    <label>
      <span><i class="ph ph-globe" aria-hidden="true"></i> Website</span>
      <input name="website_url" type="url" maxlength="2048" value={profile.website_url ?? ''} inputmode="url" placeholder="https://…" />
    </label>
    <label class="member-profile-form__wide">
      <span><i class="ph ph-youtube-logo" aria-hidden="true"></i> YouTube</span>
      <input name="youtube_url" type="url" maxlength="2048" value={profile.youtube_url ?? ''} inputmode="url" placeholder="https://www.youtube.com/@…" />
    </label>
    <div class="member-profile-form__footer member-profile-form__wide">
      <p><i class="ph ph-info" aria-hidden="true"></i> These are public links you provide; they are not verified connections.</p>
      <button class="button button--dark button--small" type="submit">Save public profile</button>
    </div>
    <p class="form-status member-profile-form__wide" data-member-profile-status aria-live="polite"></p>
  </form>

  <section class="showcase-editor" data-showcase-editor>
    <div class="showcase-editor__heading">
      <div><p class="eyebrow">Public Showcase ✨</p><h3>Selected work</h3></div>
    </div>
    <p>Choose a small set of images that quickly show what you or your company builds. This is a curated portfolio, not a social feed.</p>
    <div class="showcase-editor__grid">
      {showcase.map((item) => <article class="showcase-editor__item" data-showcase-id={item.id}>
        <img src={`/showcase-images/${item.id}.jpg`} alt={item.alt_text} width={item.width} height={item.height} />
        <form data-showcase-item={item.id}>
          <label>Title <input name="title" maxlength="100" value={item.title} /></label>
          <label>Caption <textarea name="caption" maxlength="400" rows="2">{item.caption}</textarea></label>
          <label>Image description <input name="alt_text" maxlength="240" value={item.alt_text} required /></label>
          <label>Optional link <input name="link_url" type="url" maxlength="2048" value={item.link_url ?? ''} placeholder="https://…" /></label>
          <label>Position <select name="position">{[1, 2, 3].map((position) => <option value={position} selected={Number(item.position) === position}>{position}</option>)}</select></label>
          <div class="button-row"><button class="button button--secondary button--small" type="submit">Save</button><button class="text-button" type="button" data-remove-showcase>Remove</button></div>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </article>)}
      {Array.from({ length: emptySlots }, (_, index) => <div class="showcase-editor__empty" aria-hidden="true"><span>0{showcase.length + index + 1}</span><i class="ph ph-image" aria-hidden="true"></i><small>Open showcase slot</small></div>)}
    </div>
    {showcase.length < 3 && uploadsRemaining > 0 && <form class="showcase-upload" data-showcase-upload>
      <label>Describe the image for people using screen readers <input name="alt_text" maxlength="240" required placeholder="Robot prototype on a workbench" /></label>
      <label>Choose an image <input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" required /></label>
      <button class="button button--dark button--small" type="submit"><i class="ph ph-upload-simple" aria-hidden="true"></i> Add to Showcase</button>
      <small>JPG, PNG, WebP and phone photos are cropped to 8:5, re-encoded, and stripped of camera metadata before public storage.</small>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>}
    {uploadsRemaining === 0 && <p class="form-status">Image uploads are complete. Existing titles, descriptions, links, and ordering remain editable.</p>}
  </section>
</section>

<script>
  const workspace = document.querySelector<HTMLElement>('[data-member-profile-workspace]');
  const form = workspace?.querySelector<HTMLFormElement>('[data-member-profile-form]');
  const status = workspace?.querySelector<HTMLElement>('[data-member-profile-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    const interests = String(data.get('interests') ?? '')
      .split(',')
      .map((value) => value.trim())
      .filter(Boolean);
    const payload = {
      profile_kind: String(data.get('profile_kind') ?? 'person'),
      bio: String(data.get('bio') ?? ''),
      interests,
      x_username: String(data.get('x_username') ?? ''),
      github_username: String(data.get('github_username') ?? ''),
      linkedin_url: String(data.get('linkedin_url') ?? ''),
      website_url: String(data.get('website_url') ?? ''),
      youtube_url: String(data.get('youtube_url') ?? ''),
    };
    if (submit) submit.disabled = true;
    if (status) status.textContent = 'Saving your public profile…';
    try {
      const response = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({})) as { error?: string };
      if (!response.ok) throw new Error(result.error || 'Your profile could not be saved.');
      if (status) status.textContent = 'Public profile saved.';
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Your profile could not be saved.';
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  const showcaseEditor = workspace?.querySelector<HTMLElement>('[data-showcase-editor]');
  async function loadImage(file: File): Promise<{ source: CanvasImageSource; width: number; height: number; close: () => void }> {
    if ('createImageBitmap' in window) {
      try {
        const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
        return { source: bitmap, width: bitmap.width, height: bitmap.height, close: () => bitmap.close() };
      } catch { /* Safari can use its native decoder below. */ }
    }
    const objectUrl = URL.createObjectURL(file);
    const image = new Image(); image.decoding = 'async'; image.src = objectUrl; await image.decode();
    return { source: image, width: image.naturalWidth, height: image.naturalHeight, close: () => URL.revokeObjectURL(objectUrl) };
  }
  const canvasJpeg = (canvas: HTMLCanvasElement, quality: number) => new Promise<Blob>((resolve, reject) => canvas.toBlob(
    (blob) => blob ? resolve(blob) : reject(new Error('This browser could not prepare the image')),
    'image/jpeg', quality,
  ));
  async function prepareShowcaseImage(file: File): Promise<Blob> {
    if (!file.type.startsWith('image/') && !/\.(heic|heif)$/iu.test(file.name)) throw new Error('Choose an image file');
    if (file.size > 16 * 1024 * 1024) throw new Error('Choose an image smaller than 16 MB');
    const loaded = await loadImage(file);
    try {
      if (loaded.width < 384 || loaded.height < 240) throw new Error('Choose an image at least 384 by 240 pixels');
      const targetRatio = 8 / 5;
      let cropWidth = loaded.width; let cropHeight = loaded.height;
      if (cropWidth / cropHeight > targetRatio) cropWidth = Math.round(cropHeight * targetRatio);
      else cropHeight = Math.round(cropWidth / targetRatio);
      const sourceX = Math.floor((loaded.width - cropWidth) / 2);
      const sourceY = Math.floor((loaded.height - cropHeight) / 2);
      let outputWidth = Math.min(1600, cropWidth);
      let quality = 0.88; let result: Blob | null = null;
      for (let attempt = 0; attempt < 9; attempt += 1) {
        const canvas = document.createElement('canvas');
        canvas.width = outputWidth; canvas.height = Math.round(outputWidth / targetRatio);
        const context = canvas.getContext('2d', { alpha: false });
        if (!context) throw new Error('This browser could not prepare the image');
        context.fillStyle = '#ffffff'; context.fillRect(0, 0, canvas.width, canvas.height);
        context.drawImage(loaded.source, sourceX, sourceY, cropWidth, cropHeight, 0, 0, canvas.width, canvas.height);
        result = await canvasJpeg(canvas, quality);
        if (result.size <= 600_000) break;
        if (quality > 0.6) quality -= 0.07;
        else outputWidth = Math.max(640, Math.round(outputWidth * 0.82));
      }
      if (!result || result.size > 600_000) throw new Error('This image could not be reduced safely. Choose a different image.');
      return result;
    } finally { loaded.close(); }
  }

  showcaseEditor?.querySelectorAll<HTMLFormElement>('[data-showcase-item]').forEach((itemForm) => itemForm.addEventListener('submit', async (event) => {
    event.preventDefault(); const itemStatus = itemForm.querySelector<HTMLElement>('[role=status]'); const submit = itemForm.querySelector<HTMLButtonElement>('button[type=submit]');
    const data = new FormData(itemForm); if (submit) submit.disabled = true; if (itemStatus) itemStatus.textContent = 'Saving Showcase details…';
    try {
      const response = await fetch(`/api/showcase/media/${itemForm.dataset.showcaseItem}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title: data.get('title'), caption: data.get('caption'), alt_text: data.get('alt_text'), link_url: data.get('link_url'), position: Number(data.get('position')) }) });
      const result = await response.json() as { error?: string }; if (!response.ok) throw new Error(result.error || 'Showcase details could not be saved.');
      if (itemStatus) itemStatus.textContent = 'Showcase details saved.';
      setTimeout(() => location.reload(), 450);
    } catch (error) { if (itemStatus) itemStatus.textContent = error instanceof Error ? error.message : 'Showcase details could not be saved.'; if (submit) submit.disabled = false; }
  }));

  showcaseEditor?.querySelectorAll<HTMLButtonElement>('[data-remove-showcase]').forEach((button) => button.addEventListener('click', async () => {
    const article = button.closest<HTMLElement>('[data-showcase-id]'); const itemStatus = article?.querySelector<HTMLElement>('[role=status]');
    if (!article || !confirm('Remove this public Showcase image? Removing it does not restore an upload.')) return;
    button.disabled = true; if (itemStatus) itemStatus.textContent = 'Removing image…';
    const response = await fetch(`/api/showcase/media/${article.dataset.showcaseId}`, { method: 'DELETE' });
    if (response.ok) location.reload(); else { if (itemStatus) itemStatus.textContent = 'Image could not be removed.'; button.disabled = false; }
  }));

  const uploadForm = showcaseEditor?.querySelector<HTMLFormElement>('[data-showcase-upload]');
  uploadForm?.addEventListener('submit', async (event) => {
    event.preventDefault(); const uploadStatus = uploadForm.querySelector<HTMLElement>('[role=status]'); const submit = uploadForm.querySelector<HTMLButtonElement>('button[type=submit]'); const data = new FormData(uploadForm); const file = data.get('image');
    if (!(file instanceof File) || !file.size) return;
    if (submit) submit.disabled = true; if (uploadStatus) uploadStatus.textContent = 'Preparing a metadata-free public image…';
    try {
      const prepared = await prepareShowcaseImage(file); const alt = String(data.get('alt_text') ?? '').trim();
      const response = await fetch(`/api/showcase/media?alt_text=${encodeURIComponent(alt)}`, { method: 'POST', headers: { 'content-type': 'image/jpeg' }, body: prepared });
      const result = await response.json() as { error?: string }; if (!response.ok) throw new Error(result.error || 'Image could not be uploaded.');
      if (uploadStatus) uploadStatus.textContent = 'Image added to your public Showcase.'; location.reload();
    } catch (error) { if (uploadStatus) uploadStatus.textContent = error instanceof Error ? error.message : 'Image could not be uploaded.'; if (submit) submit.disabled = false; }
  });
</script>
