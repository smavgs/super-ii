---
import LogoMark from './LogoMark.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <a class="brand-lockup" href="/" aria-label="Super ii home">
        <LogoMark size="small" />
        <span>Super <strong>ii</strong></span>
      </a>
      <p>Open intelligence, built together.</p>
      <span class="footer-beta"><span></span> Public beta</span>
    </div>

    <div class="footer-column">
      <h2>Explore</h2>
      <a href="/models">Models</a>
      <a href="/datasets">Datasets</a>
      <a href="/spaces">Apps</a>
      <a href="/collections">Collections</a>
      <a href="/organizations">Organizations</a>
      <a href="/social">Social web 🎡</a>
    </div>

    <div class="footer-column">
      <h2>Resources</h2>
      <a href="/docs">Documentation</a>
      <a href="/notebooks">Notebooks</a>
      <a href="/papers">Papers</a>
      <a href="/posts">Posts</a>
      <a href="/feed">Community feed</a>
      <a href="/pricing">Pricing</a>
      <a href="/enterprise">Enterprise</a>
      <a href="/status">Status</a>
      <a href="/system-state">System state</a>
      <a href="/docs#agent-native">MCP</a>
      <a href="/mcp/social">Social MCP</a>
    </div>

    <div class="footer-column">
      <h2>Company</h2>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/security">Security</a>
      <a href="/legal/privacy">Privacy</a>
      <a href="/legal/terms">Terms</a>
      <a href="https://x.com/superiisite" rel="me external">X · @superiisite</a>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {year} Super ii</span>
    <span>Open by design · Clear controls when needed</span>
  </div>
</footer>
