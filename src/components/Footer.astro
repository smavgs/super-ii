---
import BrandMark from './BrandMark.astro';
import LogoMark from './LogoMark.astro';
import { isLocalizablePath, localizedPath, stripLocalePrefix, type SiteLocale } from '@/lib/i18n';

const year = new Date().getFullYear();
const hasTranslation = isLocalizablePath(Astro.url.pathname);
const locale = Astro.locals.locale ?? 'en';
const languageNames: Readonly<Record<SiteLocale, { label: string; language: string; ariaLabel: string }>> = {
  en: { label: 'en', language: 'en', ariaLabel: 'English' },
  ru: { label: 'ru', language: 'ru', ariaLabel: 'Русский' },
  'zh-CN': { label: '简体中文', language: 'zh-CN', ariaLabel: '简体中文' },
};
const languageOrder: Readonly<Record<SiteLocale, ReadonlyArray<SiteLocale>>> = {
  en: ['ru', 'zh-CN'],
  ru: ['en', 'zh-CN'],
  'zh-CN': ['en', 'ru'],
};
const languageHref = (targetLocale: SiteLocale) => {
  const target = new URL(Astro.url);
  target.pathname = localizedPath(stripLocalePrefix(target.pathname), targetLocale);
  target.searchParams.set('language', targetLocale);
  return `${target.pathname}${target.search}${target.hash}`;
};
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <a class="brand-lockup" href="/" aria-label="Super ii home" data-no-translate>
        <LogoMark size="small" />
        <span>Super <strong>ii</strong></span>
      </a>
      <p>Open super intelligence, built together.</p>
      <span class="footer-beta"><span></span> Agent Friendly</span>
    </div>

    <div class="footer-column">
      <h2>Explore</h2>
      <a href="/models">Models</a>
      <a href="/datasets">Datasets</a>
      <a href="/spaces">Apps</a>
      <a href="/robot">Make Robot</a>
      <a href="/transparent">Transparent 🔎</a>
      <a href="/skills">Skills</a>
      <a href="/builders">Builders</a>
      <a href="/collections">Collections</a>
      <a href="/organizations">Organizations</a>
      <a href="/social">Social web 🎡</a>
      <a href="/proposals">Proposals</a>
      <a href="/fame">Hall of Fame</a>
      <a href="/highlights">Highlights</a>
    </div>

    <div class="footer-column">
      <h2>Resources</h2>
      <a href="/use">Use Super ii</a>
      <a href="/build">Build &amp; Ship</a>
      <a href="/docs">Documentation</a>
      <a href="/notebooks">Notebooks</a>
      <a href="/tokenizer">Tokenizer</a>
      <a href="/chats">Chats</a>
      <a href="/papers">Papers</a>
      <a href="/posts">Posts</a>
      <a href="/feed">Community feed</a>
      <a href="/pricing">Pricing</a>
      <a href="/enterprise">Enterprise</a>
      <a href="/status">Status</a>
      <a href="/system-state">System state</a>
      <a href="/docs#agent-native">MCP</a>
      <a href="/mcp/social">Social MCP</a>
      <a href="/mcp/robot">Robot MCP</a>
      <a href="/mcp/transparent">Transparent MCP</a>
    </div>

    <div class="footer-column">
      <h2>Company</h2>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/security">Security</a>
      <a href="/legal/privacy">Privacy</a>
      <a href="/legal/terms">Terms</a>
      <a class="brand-inline" href="https://x.com/superiisite" rel="me external" data-no-translate><BrandMark brand="x" size="xs" label="X" />X · @superiisite</a>
      <a class="footer-join-team" href="/join-team">Join Team <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {year} Super ii</span>
    {hasTranslation && <span class="footer-language-group" data-no-translate>
      {languageOrder[locale].map((targetLocale) => {
        const language = languageNames[targetLocale];
        return <>
          <span class="footer-language-separator" aria-hidden="true">·</span>
          <a
            class="footer-language-switch"
            href={languageHref(targetLocale)}
            data-language-switch={targetLocale}
            lang={language.language}
            hreflang={targetLocale}
            aria-label={language.ariaLabel}
          >{language.label}</a>
        </>;
      })}
    </span>}
  </div>
</footer>
