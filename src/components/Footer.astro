---
import BrandMark from './BrandMark.astro';
import LogoMark from './LogoMark.astro';
import { isLocalizablePath, localizedPath, stripLocalePrefix, type SiteLocale } from '@/lib/i18n';

const year = new Date().getFullYear();
const hasTranslation = isLocalizablePath(Astro.url.pathname);
const locale = Astro.locals.locale ?? 'en';
const languageNames: Readonly<Record<SiteLocale, { label: string; language: string; ariaLabel: string }>> = {
  en: { label: 'en', language: 'en', ariaLabel: 'English' },
  ru: { label: 'ru', language: 'ru', ariaLabel: 'Русский' },
  'zh-CN': { label: '简体中文', language: 'zh-CN', ariaLabel: '简体中文' },
};
const languageOrder: Readonly<Record<SiteLocale, ReadonlyArray<SiteLocale>>> = {
  en: ['ru', 'zh-CN'],
  ru: ['en', 'zh-CN'],
  'zh-CN': ['en', 'ru'],
};
const languageHref = (targetLocale: SiteLocale) => {
  const target = new URL(Astro.url);
  target.pathname = localizedPath(stripLocalePrefix(target.pathname), targetLocale);
  target.searchParams.set('language', targetLocale);
  return `${target.pathname}${target.search}${target.hash}`;
};
---

<footer class="site-footer site-chrome">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <a class="brand-lockup" href="/" aria-label="Super ii home" data-no-translate>
        <LogoMark size="small" />
        <span>Super <strong>ii</strong></span>
      </a>
      <p>Open super intelligence, built together.</p>
      <span class="footer-beta"><span></span> Agent Friendly</span>
    </div>

    <div class="footer-column">
      <h2>Help</h2>
      <a href="/use">Use Super ii</a>
      <a href="/docs">Documentation</a>
      <a href="/security">Security</a>
    </div>
    <div class="footer-column">
      <h2>Super ii</h2>
      <a href="/about">About</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
      <a class="footer-join-team" href="/join-team">Join Team <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {year} Super ii</span>
    <nav class="footer-policy-links" aria-label="Policies and service status"><a href="/status">Status</a><a href="/legal/privacy">Privacy</a><a href="/legal/terms">Terms</a><a class="brand-inline" href="https://x.com/superiisite" rel="me external" aria-label="Super ii on X" data-no-translate><BrandMark brand="x" size="xs" label="X" />@superiisite</a></nav>
    {hasTranslation && <span class="footer-language-group" data-no-translate>
      {languageOrder[locale].map((targetLocale) => {
        const language = languageNames[targetLocale];
        return <>
          <span class="footer-language-separator" aria-hidden="true">·</span>
          <a
            class="footer-language-switch"
            href={languageHref(targetLocale)}
            data-language-switch={targetLocale}
            lang={language.language}
            hreflang={targetLocale}
            aria-label={language.ariaLabel}
          >{language.label}</a>
        </>;
      })}
    </span>}
  </div>
</footer>

<style>
  .footer-grid { gap: 2rem; padding-block: 2.5rem; }
  .footer-column { gap: .25rem; }
  .footer-column > a { display: flex; align-items: center; min-height: 2.75rem; width: fit-content; }
  .footer-column .footer-join-team { margin-top: .5rem; }
  .footer-bottom { flex-wrap: wrap; gap: .6rem 1.5rem; align-items: center; padding-bottom: 5rem; }
  .footer-policy-links { display: flex; flex-wrap: wrap; align-items: center; gap: .2rem 1rem; }
  .footer-policy-links a { display: inline-flex; gap: .35rem; align-items: center; min-height: 2.75rem; color: inherit; }
  @media (max-width: 650px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .footer-intro { grid-column: 1 / -1; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
