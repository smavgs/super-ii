---
import InfoTip from './InfoTip.astro';
import LogoMark from './LogoMark.astro';

interface Props {
  mode: 'sign-in' | 'sign-up';
}

const { mode } = Astro.props;
const signingUp = mode === 'sign-up';
---

<section class="auth-story">
  <div class="auth-story__inner">
    <LogoMark size="medium" priority />
    <div class="heading-with-help auth-story__title">
      <h1>{signingUp ? 'Join Super ii.' : 'Welcome back.'}</h1>
      {signingUp && <InfoTip term="joinFree" label="joining Super ii" />}
    </div>
    <p>{signingUp ? 'Explore, build, publish and collaborate around open intelligence.' : 'Return to your workspace, repositories, organizations and agents.'}</p>
    <div class="auth-points">
      {signingUp ? (
        <>
          <div class="auth-point"><i class="ph ph-envelope-simple" aria-hidden="true"></i> Continue with email</div>
          <div class="auth-point"><i class="ph ph-google-logo" aria-hidden="true"></i> Continue with Google</div>
          <div class="auth-point"><i class="ph ph-github-logo" aria-hidden="true"></i> Continue with GitHub</div>
          <div class="auth-point"><i class="ph ph-credit-card" aria-hidden="true"></i> Free to join. No card required.</div>
        </>
      ) : (
        <>
          <div class="auth-point"><i class="ph ph-envelope-simple" aria-hidden="true"></i> Fast email sign-in</div>
          <div class="auth-point"><i class="ph ph-google-logo" aria-hidden="true"></i> Continue with Google</div>
          <div class="auth-point"><i class="ph ph-github-logo" aria-hidden="true"></i> Continue with GitHub</div>
        </>
      )}
    </div>
  </div>
</section>
