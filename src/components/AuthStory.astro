---
import LogoMark from './LogoMark.astro';

interface Props {
  mode: 'sign-in' | 'sign-up';
}

const { mode } = Astro.props;
const signingUp = mode === 'sign-up';
---

<section class="auth-story">
  <div class="auth-story__inner">
    <LogoMark size="medium" priority />
    <h1>{signingUp ? 'Run your first AI agent.' : 'Welcome back.'}</h1>
    <p>{signingUp ? 'Join Super ii, then launch OpenCode with free cloud AI. No GPU or API key setup required.' : 'Return to your Super ii profile, organizations, and Agent Starter progress.'}</p>
    <div class="auth-points">
      {signingUp ? (
        <>
          <div class="auth-point"><i class="ph ph-desktop" aria-hidden="true"></i> Mac, Windows, and Linux guidance</div>
          <div class="auth-point"><i class="ph ph-cloud" aria-hidden="true"></i> Free cloud model starter path</div>
          <div class="auth-point"><i class="ph ph-plugs-connected" aria-hidden="true"></i> Connect your agent to Super ii</div>
        </>
      ) : (
        <>
          <div class="auth-point"><i class="ph ph-envelope-simple" aria-hidden="true"></i> Fast email sign-in</div>
          <div class="auth-point"><i class="ph ph-google-logo" aria-hidden="true"></i> Continue with Google</div>
          <div class="auth-point"><i class="ph ph-github-logo" aria-hidden="true"></i> Continue with GitHub</div>
        </>
      )}
    </div>
  </div>
</section>
