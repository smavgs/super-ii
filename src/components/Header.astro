---
import {
  Show,
  SignInButton,
  UserButton,
} from '@clerk/astro/components';
import { authIsConfigured } from '@/lib/site';
import { stripLocalePrefix } from '@/lib/i18n';
import LogoMark from './LogoMark.astro';

const path = stripLocalePrefix(Astro.url.pathname);
const authConfigured = authIsConfigured(Astro.locals);

const groups = [
  { label: 'Explore', icon: 'ph-compass', items: [
    { href: '/models', label: 'Models', icon: 'ph-cube' },
    { href: '/datasets', label: 'Datasets', icon: 'ph-database' },
    { href: '/spaces', label: 'Apps', icon: 'ph-browser' },
    { href: '/skills', label: 'Skills', icon: 'ph-sparkle' },
    { href: '/robot', label: 'Robots', icon: 'ph-robot' },
    { href: '/organizations', label: 'Organizations', icon: 'ph-buildings' },
    { href: '/builders', label: 'Builders', icon: 'ph-users-three' },
    { href: '/collections', label: 'Collections', icon: 'ph-stack' },
  ] },
  { label: 'Learn & build', icon: 'ph-code', items: [
    { href: '/use', label: 'Use Super ii', icon: 'ph-play' },
    { href: '/agents', label: 'Agents', icon: 'ph-plugs-connected' },
    { href: '/build', label: 'Build & Ship', icon: 'ph-hammer' },
    { href: '/tokenizer', label: 'Tokenizer', icon: 'ph-text-aa' },
    { href: '/notebooks', label: 'Notebooks', icon: 'ph-notebook' },
    { href: '/docs', label: 'Documentation', icon: 'ph-book-open' },
    { href: '/transparent', label: 'Transparency', icon: 'ph-shield-check' },
  ] },
  { label: 'Community', icon: 'ph-chats-circle', items: [
    { href: '/social', label: 'Social web 🎡', icon: 'ph-planet' },
    { href: '/chats', label: 'Chats', icon: 'ph-chat-circle-dots' },
    { href: '/papers', label: 'Papers', icon: 'ph-article' },
    { href: '/posts', label: 'Posts', icon: 'ph-note-pencil' },
    { href: '/feed', label: 'Feed', icon: 'ph-rss' },
    { href: '/proposals', label: 'Proposals', icon: 'ph-lightbulb' },
    { href: '/fame', label: 'Hall of Fame', icon: 'ph-star' },
    { href: '/highlights', label: 'Highlights', icon: 'ph-megaphone' },
  ] },
];
const activeGroup = Math.max(0, groups.findIndex((group) => group.items.some((item) => path === item.href || path.startsWith(`${item.href}/`))));
---

<header class="site-header site-chrome" data-site-header>
  <div class="shell header-inner">
    <a class="brand-lockup" href="/" aria-label="Super ii home" data-no-translate>
      <LogoMark size="small" priority />
      <span>Super <strong>ii</strong></span>
    </a>

    <div class="header-actions">
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch color theme"
        data-theme-toggle
      >
        <i class="ph ph-sun" aria-hidden="true"></i>
      </button>

      <div class="header-auth auth-desktop">
        {authConfigured ? (
          <>
            <Show when="signed-out">
              <span class="header-sign-in"><SignInButton asChild mode="modal">
                <button class="button button--ghost button--small" type="button">Log in</button>
              </SignInButton></span>
              <a class="button button--dark button--small" href="/sign-up?redirect_url=%2Faccount">Join free</a>
            </Show>
            <Show when="signed-in">
              <a class="button button--dark button--small" href="/account">Workspace <span aria-hidden="true">👾</span></a>
              <span class="header-profile"><UserButton
                appearance={{
                  elements: { avatarBox: 'sii-clerk-avatar' },
                }}
              /></span>
            </Show>
          </>
        ) : (
          <>
            <a class="button button--ghost button--small header-sign-in" href="/sign-in">Log in</a>
            <a class="button button--dark button--small" href="/sign-up?redirect_url=%2Faccount">Join free</a>
          </>
        )}
      </div>

      <button
        class="icon-button menu-toggle"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav site-directory site-chrome" id="mobile-navigation" data-mobile-nav hidden>
  <nav class="shell" aria-label="Site directory">
    {groups.map((group, index) => (
      <details class="directory-group" name="site-directory" open={index === activeGroup}>
        <summary><i class:list={['ph', group.icon]} aria-hidden="true"></i><span>{group.label}</span></summary>
        <div class="directory-links">
          {group.items.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              <i class:list={['ph', item.icon]} aria-hidden="true"></i>
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </details>
    ))}
    <div class="mobile-auth">
      {authConfigured ? (
        <>
          <Show when="signed-out">
            <a class="button button--secondary" href="/sign-in">Log in</a>
          </Show>
        </>
      ) : (
        <>
          <a class="button button--secondary" href="/sign-in">Log in</a>
        </>
      )}
    </div>
  </nav>
</div>

<noscript><style>.site-header .menu-toggle { display: none; } .site-directory[hidden] { display: block; position: static; } .site-directory .mobile-auth { display: flex; }</style></noscript>
