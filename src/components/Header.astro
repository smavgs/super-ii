---
import {
  Show,
  SignInButton,
  UserButton,
} from '@clerk/astro/components';
import { authIsConfigured } from '@/lib/site';
import LogoMark from './LogoMark.astro';

const path = Astro.url.pathname;
const authConfigured = authIsConfigured(Astro.locals);

const nav = [
  { href: '/models', label: 'Models' },
  { href: '/datasets', label: 'Datasets' },
  { href: '/spaces', label: 'Apps' },
  { href: '/agents', label: 'Agents' },
  { href: '/notebooks', label: 'Notebooks' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/collections', label: 'Collections' },
  { href: '/feed', label: 'Community' },
  { href: '/docs', label: 'Docs' },
];
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand-lockup" href="/" aria-label="Super ii home">
      <LogoMark size="small" priority />
      <span>Super <strong>ii</strong></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch color theme"
        data-theme-toggle
      >
        <i class="ph ph-sun" aria-hidden="true"></i>
      </button>

      <div class="header-auth auth-desktop">
        {authConfigured ? (
          <>
            <Show when="signed-out">
              <SignInButton asChild mode="modal">
                <button class="button button--ghost button--small" type="button">Log in</button>
              </SignInButton>
              <a class="button button--dark button--small" href="/sign-up">Join free</a>
            </Show>
            <Show when="signed-in">
              <a class="button button--ghost button--small header-bridge-link" href="/bring-my-work">Bring my work</a>
              <a class="button button--dark button--small" href="/new">Create</a>
              <a class="button button--ghost button--small" href="/account#agent-starter">Workspace</a>
              <UserButton
                appearance={{
                  elements: { avatarBox: 'sii-clerk-avatar' },
                }}
              />
            </Show>
          </>
        ) : (
          <>
            <a class="button button--ghost button--small" href="/sign-in">Log in</a>
            <a class="button button--dark button--small" href="/sign-up">Join free</a>
          </>
        )}
      </div>

      <button
        class="icon-button menu-toggle"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-navigation" data-mobile-nav hidden>
  <nav class="shell" aria-label="Mobile navigation">
    {nav.map((item) => (
      <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
        <span>{item.label}</span>
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    ))}
    <div class="mobile-auth">
      {authConfigured ? (
        <>
          <Show when="signed-out">
            <a class="button button--secondary" href="/sign-in">Log in</a>
            <a class="button button--dark" href="/sign-up">Join free</a>
          </Show>
          <Show when="signed-in">
            <a class="button button--secondary" href="/bring-my-work">Bring my work</a>
            <a class="button button--secondary" href="/new">Create repository</a>
            <a class="button button--dark" href="/account#agent-starter">Open workspace</a>
          </Show>
        </>
      ) : (
        <>
          <a class="button button--secondary" href="/sign-in">Log in</a>
          <a class="button button--dark" href="/sign-up">Join free</a>
        </>
      )}
    </div>
  </nav>
</div>
