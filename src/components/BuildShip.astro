---
interface Props {
  source?: { kind: string; owner_handle: string; slug: string; commit_sha: string | null };
  expanded?: boolean;
}
const { source, expanded = false } = Astro.props;
const model = source?.kind === 'model';
const dataset = source?.kind === 'dataset';
const identity = source ? `${source.owner_handle}/${source.slug}` : '';
---
<section id="build-ship" class="build-ship" data-build-ship hidden={!expanded} aria-labelledby="build-ship-title">
  <div class="build-ship-heading"><div><p class="eyebrow">Engineering recipes</p><h2 id="build-ship-title" tabindex="-1">Build &amp; Ship</h2></div>{!expanded && <button type="button" class="button button--small button--secondary" data-build-close>Close</button>}</div>
  <p>Choose what you want to build. Get a project with pinned inputs, runnable code, tests and an execution record.</p>
  <form data-build-form>
    <label class="build-outcome">What do you want to make?
      <select name="outcome"><option value="rag">Answer questions from documents</option><option value="api">Serve a text model through an API</option><option value="sft">Adapt a model with SFT and LoRA</option></select>
    </label>
    <div class="build-inputs">
      <fieldset><legend>Text generation model</legend>
        <label>Repository<input name="generator" required value={model ? identity : ''} readonly={model} placeholder="owner/model" autocomplete="off" data-no-translate /></label>
        <label>Published commit SHA-256<input name="generator_revision" required pattern="[a-f0-9]{64}" value={model ? source?.commit_sha ?? '' : ''} readonly={model} placeholder="Full 64-character revision" autocomplete="off" /></label>
      </fieldset>
      <fieldset data-embedding-fields><legend>Embedding model</legend>
        <label>Repository<input name="embedding" placeholder="owner/embedding-model" autocomplete="off" data-no-translate /></label>
        <label>Published commit SHA-256<input name="embedding_revision" pattern="[a-f0-9]{64}" placeholder="Full 64-character revision" autocomplete="off" /></label>
        <p class="build-hint">BERT, RoBERTa, DistilBERT or XLM-R with mean pooling and safetensors. The local preflight checks the exact files.</p>
      </fieldset>
      <fieldset data-dataset-fields><legend>Dataset <span data-dataset-optional>(optional)</span></legend>
        <label>Repository<input name="dataset" value={dataset ? identity : ''} readonly={dataset} placeholder="owner/dataset" autocomplete="off" data-no-translate /></label>
        <label>Published commit SHA-256<input name="dataset_revision" pattern="[a-f0-9]{64}" value={dataset ? source?.commit_sha ?? '' : ''} readonly={dataset} placeholder="Full 64-character revision" autocomplete="off" /></label>
        <p class="build-hint" data-dataset-help>Leave empty to ingest documents from a local folder.</p>
      </fieldset>
    </div>
    <details class="build-settings"><summary>Execution settings</summary>
      <div class="build-settings-grid">
        <label>Machine<select name="accelerator"><option value="cpu">CPU</option><option value="metal">Apple Metal</option></select></label>
        <label>Model runtime<select name="runtime"><option value="auto">Choose from installed runtimes</option><option value="transformers">Transformers · safetensors</option><option value="llama.cpp">llama.cpp · GGUF</option><option value="mlx">MLX · existing Apple weights</option></select></label>
        <label>Context tokens<input name="context_size" type="number" min="512" max="131072" value="4096" /></label>
        <label>Maximum answer tokens<input name="max_tokens" type="number" min="1" max="4096" value="256" /></label>
        <label data-rag-setting>Retrieved chunks<input name="top_k" type="number" min="1" max="50" value="4" /></label>
        <label data-train-setting hidden>Training steps<input name="max_steps" type="number" min="1" max="100000" value="20" /></label>
        <label data-train-setting hidden>Training sequence tokens<input name="sequence_length" type="number" min="32" max="32768" value="256" /></label>
        <label data-inference-setting>Framework<select name="framework"><option value="python">Python</option><option value="langchain">LangChain adapter</option></select></label>
        <label data-inference-setting>Local interface<select name="ui"><option value="none">API only</option><option value="gradio">Gradio</option></select></label>
        <label class="build-check"><input name="observability" type="checkbox" />Include metrics and tracing configuration</label>
      </div>
      <p class="build-hint">CPU LoRA and local retrieval have fixture tests. GPU-specific QLoRA and vLLM exports require a separate NVIDIA verification step. A generated project does not establish this model’s quality.</p>
    </details>
    <div class="build-submit"><button class="button button--yellow" type="submit">Generate project</button><a href="/docs#build-ship">Recipe guide</a></div>
    <p data-build-status role="status" aria-live="polite"></p>
  </form>
  <div data-build-result hidden>
    <div class="build-result-heading"><p>Review your project files, then download and run locally.</p><button class="button button--yellow" type="button" data-build-download>Download ZIP</button></div>
    <label>Preview file<select data-build-file data-no-translate></select></label>
    <pre class="build-preview" tabindex="0"><code data-build-preview></code></pre>
  </div>
</section>
<script>
  import { projectZip } from '@/lib/recipe-zip';
  function setupBuildShip() {
    const panel = document.querySelector<HTMLElement>('[data-build-ship]');
    if (!panel || panel.dataset.ready) return;
    panel.dataset.ready = 'true';
    const russian = document.documentElement.lang === 'ru';
    const copy = (english: string, translated: string) => russian ? translated : english;
    const errorTranslations: Record<string, string> = {
      'invalid origin': 'Недопустимый источник запроса.',
      'database unavailable': 'База данных временно недоступна.',
      'Recipe generation is temporarily unavailable': 'Создание проекта временно недоступно.',
      'Project generation is unavailable': 'Создание проекта временно недоступно.',
      'Recipe generation failed': 'Не удалось создать проект.',
      'Project generation failed': 'Не удалось создать проект.',
      'The resolved source does not match the requested immutable input': 'Полученный источник не соответствует выбранной неизменяемой версии.',
      'SFT requires a JSONL dataset': 'Для SFT требуется набор данных JSONL.',
      'Select a BERT, RoBERTa, DistilBERT or XLM-R safetensors encoder with mean pooling': 'Выберите энкодер BERT, RoBERTa, DistilBERT или XLM-R в формате safetensors с усреднением.',
      'This template needs a supported text-generation architecture and safetensors, or a complete GGUF file': 'Для этого шаблона нужна поддерживаемая архитектура генерации текста с safetensors или полный файл GGUF.',
      'SFT requires Transformers training weights': 'Для SFT требуются обучающие веса Transformers.',
      'Select existing MLX-compatible weights': 'Выберите существующие веса, совместимые с MLX.',
      'A required source could not be resolved': 'Не удалось получить обязательный источник.',
      'Overlap must be smaller than chunk size': 'Перекрытие должно быть меньше размера фрагмента.',
      'Reserve context for the input and answer': 'Оставьте достаточно контекста для входных данных и ответа.',
      'RAG needs an embedding model and immutable revision': 'Для RAG нужны модель эмбеддингов и её неизменяемая версия.',
      'SFT needs a dataset and immutable revision': 'Для SFT нужны набор данных и его неизменяемая версия.',
      'The verified SFT recipe uses Transformers on CPU': 'Проверенный рецепт SFT использует Transformers на CPU.',
      'Framework and UI exports are available for inference projects': 'Экспорт фреймворка и интерфейса доступен для проектов инференса.',
      'MLX needs an Apple target': 'Для MLX требуется устройство Apple.',
    };
    const roleTranslations: Record<string, string> = {
      generator: 'генеративной модели',
      embedding: 'модели эмбеддингов',
      dataset: 'набора данных',
    };
    const localizeError = (message: string) => {
      if (!russian) return message;
      if (errorTranslations[message]) return errorTranslations[message];
      let match = message.match(/^The (generator|embedding|dataset) revision is unavailable or access is denied$/);
      if (match) {
        const role = roleTranslations[match[1]];
        return `Версия ${role} недоступна или доступ запрещён.`;
      }
      match = message.match(/^Select available (generator|embedding|dataset) files$/);
      if (match) {
        const role = roleTranslations[match[1]];
        return `Выберите доступные файлы ${role}.`;
      }
      return 'Не удалось создать проект. Проверьте выбранные данные и повторите попытку.';
    };
    const form = panel.querySelector<HTMLFormElement>('[data-build-form]')!;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
    const opener = document.querySelector<HTMLButtonElement>('[data-build-ship-open]');
    opener?.addEventListener('click', () => { panel.hidden = false; opener.setAttribute('aria-expanded', 'true'); panel.querySelector<HTMLElement>('h2')?.focus(); });
    panel.querySelector('[data-build-close]')?.addEventListener('click', () => { panel.hidden = true; opener?.setAttribute('aria-expanded', 'false'); opener?.focus(); });
    function update() {
      const rag = field('outcome').value === 'rag', train = field('outcome').value === 'sft';
      panel!.querySelector<HTMLElement>('[data-embedding-fields]')!.hidden = !rag;
      panel!.querySelector<HTMLElement>('[data-dataset-fields]')!.hidden = !rag && !train;
      for (const name of ['embedding', 'embedding_revision']) { field(name).required = rag; field(name).disabled = !rag; }
      for (const name of ['dataset', 'dataset_revision']) { field(name).required = train; field(name).disabled = !rag && !train; }
      panel!.querySelector<HTMLElement>('[data-dataset-optional]')!.hidden = train;
      panel!.querySelector<HTMLElement>('[data-dataset-help]')!.textContent = train
        ? copy('JSONL with text or prompt/completion. At least ten distinct examples for a held-out split.', 'JSONL с полем text или парой prompt/completion. Для отложенной выборки нужно не менее десяти различных примеров.')
        : copy('Leave empty to ingest documents from a local folder.', 'Оставьте пустым, чтобы загрузить документы из локальной папки.');
      panel!.querySelectorAll<HTMLElement>('[data-train-setting]').forEach(el => el.hidden = !train);
      panel!.querySelectorAll<HTMLElement>('[data-rag-setting]').forEach(el => el.hidden = !rag);
      panel!.querySelectorAll<HTMLElement>('[data-inference-setting]').forEach(el => el.hidden = train);
      if (train) { field('accelerator').value = 'cpu'; field('runtime').value = 'transformers'; field('framework').value = 'python'; field('ui').value = 'none'; }
      field('accelerator').disabled = train; field('runtime').disabled = train;
    }
    field('outcome').addEventListener('change', update); update();
    const status = panel.querySelector<HTMLElement>('[data-build-status]')!;
    const result = panel.querySelector<HTMLElement>('[data-build-result]')!;
    const chooser = panel.querySelector('[data-build-file]') as unknown as HTMLSelectElement;
    const preview = panel.querySelector<HTMLElement>('[data-build-preview]')!;
    let files: Record<string, string> = {}, filename = '';
    const show = () => { preview.textContent = files[chooser.value] ?? ''; };
    chooser.addEventListener('change', show);
    form.addEventListener('input', () => { result.hidden = true; });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true; result.hidden = true; status.textContent = copy('Resolving your exact revisions and generating the project…', 'Проверяем точные версии и создаём проект…');
      const input = (role: string) => field(role).disabled || !field(role).value.trim() ? null : { repository: field(role).value.trim(), revision: field(role + '_revision').value.trim() };
      try {
        const configuration = Object.fromEntries(['context_size', 'max_tokens', 'top_k', 'max_steps', 'sequence_length'].map(name => [name, Number(field(name).value)]));
        const response = await fetch('/api/recipes/generate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({
          outcome: field('outcome').value, generator: input('generator'), embedding: input('embedding'), dataset: input('dataset'), accelerator: field('accelerator').value, runtime: field('runtime').value,
          configuration: { ...configuration, framework: field('framework').value, ui: field('ui').value, observability: (field('observability') as HTMLInputElement).checked },
        }) });
        const data = await response.json() as { error?: string; files: Record<string, string>; filename: string };
        if (!response.ok) throw new Error(data.error ?? 'Project generation is unavailable');
        files = data.files; filename = data.filename;
        chooser.replaceChildren(...Object.keys(files).sort().map(name => new Option(name, name)));
        chooser.value = 'README.md'; show(); result.hidden = false;
        status.textContent = copy('Project generated. Run it locally to produce execution evidence.', 'Проект создан. Запустите его локально, чтобы получить подтверждение выполнения.');
      } catch (error) { status.textContent = localizeError(error instanceof Error ? error.message : 'Project generation failed'); }
      finally { button.disabled = false; }
    });
    panel.querySelector('[data-build-download]')?.addEventListener('click', () => {
      const bytes = projectZip(files);
      const url = URL.createObjectURL(new Blob([new Uint8Array(bytes)], { type: 'application/zip' }));
      const link = document.createElement('a'); link.href = url; link.download = filename; link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  }
  setupBuildShip(); document.addEventListener('astro:page-load', setupBuildShip);
</script>
<style>
  .build-ship { margin-block: 1.5rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: 1rem; background: var(--surface, #fffef9); color: var(--ink); }
  .build-ship[hidden], .build-ship [hidden] { display: none !important; }
  .build-ship-heading, .build-submit, .build-result-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .build-ship h2 { margin: 0; } .build-ship p { max-width: 78ch; }
  .build-ship label { display: grid; gap: .4rem; font-weight: 600; min-width: 0; }
  .build-ship input:not([type="checkbox"]), .build-ship select { width: 100%; min-width: 0; padding: .75rem; border: 1px solid #9ba69d; border-radius: .45rem; color: #171d19; background: white; font: inherit; }
  .build-inputs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; margin-block: 1.2rem; }
  .build-ship fieldset { min-width: 0; padding: 1rem; border: 1px solid var(--line); border-radius: .6rem; }
  .build-ship legend { padding-inline: .3rem; font-weight: 700; } .build-ship fieldset label + label { margin-top: .8rem; }
  .build-ship input[readonly] { background: #f1f3ee; } .build-hint { font-size: .87rem; color: var(--muted); font-weight: 400; }
  .build-settings { border-block: 1px solid var(--line); padding-block: 1rem; margin-block: 1.2rem; } .build-settings summary { cursor: pointer; font-weight: 600; }
  .build-settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1rem; margin-top: 1rem; }
  .build-ship .build-check { display: flex; align-items: center; font-weight: 400; }
  .build-submit { justify-content: flex-start; } .build-preview { overflow: auto; max-height: 24rem; padding: 1rem; background: #17251d; color: #eff7ef; border-radius: .6rem; font-size: .85rem; }
  .build-ship :focus-visible { outline: 3px solid #547961; outline-offset: 3px; }
</style>
