---
import superIiLogo from '@/assets/super-ii-logo.png';

interface Props {
  size?: 'small' | 'medium' | 'large';
  label?: string;
  priority?: boolean;
}

const {
  size = 'medium',
  label = 'Super ii',
  priority = false,
} = Astro.props;
---

<span class:list={['logo-mark', `logo-mark--${size}`]}>
  <img
    src={superIiLogo.src}
    alt={label}
    width={superIiLogo.width}
    height={superIiLogo.height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</span>
