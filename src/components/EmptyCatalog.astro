---
import InfoTip from '@/components/InfoTip.astro';
import { catalogMeta, type CatalogKind } from '@/lib/site';

interface Props {
  kind: CatalogKind;
}

const { kind } = Astro.props;
const meta = catalogMeta[kind];
const emptyState = {
  models: {
    title: 'No reviewed public models yet.',
    copy: 'Super ii does not seed fake community content. The first model appears here when a real creator publishes a release that passes review.',
  },
  datasets: {
    title: 'No reviewed public datasets yet.',
    copy: 'The first dataset appears here when a creator publishes it and the release passes review.',
  },
  spaces: {
    title: 'No reviewed public apps yet.',
    copy: 'The first public app appears here after its release passes review.',
  },
}[kind];
---

<section class="catalog-shell shell" data-catalog data-kind={kind} data-empty-default={emptyState.copy}>
  <aside class="catalog-sidebar">
    <div class="catalog-filter-title">
      <span>Filter</span>
      <span class="count-badge">0</span>
    </div>
    <fieldset disabled>
      <legend>Task</legend>
      <label><input type="checkbox" /> Text</label>
      <label><input type="checkbox" /> Image</label>
      <label><input type="checkbox" /> Audio</label>
      <label><input type="checkbox" /> Multimodal</label>
    </fieldset>
    <fieldset disabled>
      <legend>Access</legend>
      <label><input type="checkbox" /> Public</label>
      <label><input type="checkbox" /> Gated</label>
    </fieldset>
  </aside>

  <div class="catalog-main">
    <div class="catalog-toolbar">
      <label class="search-control">
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <span class="sr-only">Search {meta.title.toLowerCase()}</span>
        <input
          type="search"
          placeholder={meta.example}
          autocomplete="off"
          data-catalog-search
        />
        <kbd>/</kbd>
      </label>
      <select aria-label={`Sort ${meta.title.toLowerCase()}`} disabled>
        <option>Recently updated</option>
      </select>
    </div>

    <div class="empty-state" aria-live="polite">
      <div class="empty-state__icon">
        <i class:list={['ph', meta.icon]} aria-hidden="true"></i>
      </div>
      <p class="eyebrow">A clean start</p>
      <div class="heading-with-help empty-state__heading">
        <h2>{emptyState.title}</h2>
        <InfoTip term="reviewFirst" />
      </div>
      <p data-empty-copy>{emptyState.copy}</p>
      <div class="button-row">
        <a class="button button--dark" href="/sign-up">Create your account</a>
        <a class="button button--secondary" href="/bring-my-work">Bring existing work</a>
      </div>
      <p class="empty-state__footnote"><a href="/docs">Or read the publishing guide</a></p>
    </div>
  </div>
</section>
