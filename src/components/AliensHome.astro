---
import AlienMascot from './AlienMascot.astro';
---
<section class="aliens-home" aria-labelledby="aliens-home-title">
 <div class="shell aliens-home__inner"><AlienMascot/><div><p class="eyebrow">Aliens List · Free to list. Free to connect.</p><h2 id="aliens-home-title">Find hardware. Meet builders.</h2><div class="aliens-home__actions"><a href="/aliens-list">Browse hardware ↗</a><a href="/aliens-list?kind=event">Explore events ↗</a><a class="aliens-home__post" href="/aliens-list/new">Post free +</a></div></div><span class="aliens-home__pixels" aria-hidden="true">▪ ▪<br/> ▪ ▪ ▪<br/>▪ ▪</span></div>
 <div class="aliens-home__ticker" aria-hidden="true">
  <div class="aliens-home__track">
   {[0, 1].map(() => <div class="aliens-home__group">
    {[0, 1, 2, 3].map(() => <span class="aliens-home__topics">GPUs · Macs · Robotics · Wanted · Meetups · Hackathons ·</span>)}
   </div>)}
  </div>
 </div>
</section>
<style>
 .aliens-home{position:relative;overflow:hidden;background:#f2e8ff;color:#20344b;border-top:2px solid #20344b;border-bottom:2px solid #20344b}.aliens-home__inner{display:flex;align-items:center;gap:1.6rem;padding-block:2rem}.aliens-home h2{font-family:var(--font-mono);font-size:clamp(1.4rem,2.8vw,2rem);letter-spacing:-.06em;margin:.35rem 0 1rem}.aliens-home .eyebrow{margin:0;font-size:.76rem}.aliens-home__actions{display:flex;flex-wrap:wrap;gap:.6rem}.aliens-home__actions a{padding:.6rem .8rem;border:1px solid #20344b;font-weight:650;text-decoration:none;background:#fffdf6;box-shadow:2px 2px #20344b}.aliens-home__actions a:hover{background:#e3c9ff;transform:translateY(-1px)}.aliens-home__actions .aliens-home__post{background:#ffe500}.aliens-home__pixels{font-family:monospace;color:#ac7cdb;font-size:3rem;line-height:.65;margin-left:auto}.aliens-home__ticker{overflow:hidden;border-top:1px solid #c2acd8;background:#20344b;color:#eadcff;font-family:var(--font-mono);font-size:.8rem;padding:.55rem 0;white-space:nowrap}
 .aliens-home__track,.aliens-home__group{display:flex;width:max-content}.aliens-home__group,.aliens-home__topics{flex:none}.aliens-home__topics{padding-inline-end:1ch}
 .aliens-home__ticker[data-ready] .aliens-home__track{animation:aliens-topics var(--aliens-topic-duration) linear infinite}
 @keyframes aliens-topics{to{transform:translateX(-50%)}}
 @media(prefers-reduced-motion:reduce){.aliens-home__ticker[data-ready] .aliens-home__track{animation:none}}
 @media(max-width:600px){.aliens-home__inner{gap:1rem;padding-block:1.5rem}.aliens-home__pixels{display:none}.aliens-home__inner :global(.alien-mascot){width:3rem;font-size:3rem}.aliens-home__actions a{font-size:.9rem}}
</style>
<script>
 document.querySelectorAll<HTMLElement>('.aliens-home__ticker').forEach(ticker => {
  const track = ticker.querySelector<HTMLElement>('.aliens-home__track')!;
  const groups = [...track.querySelectorAll<HTMLElement>('.aliens-home__group')];
  const topics = groups[0].firstElementChild as HTMLElement;
  const fit = () => {
   const topicWidth = topics.getBoundingClientRect().width;
   if (!topicWidth || !ticker.clientWidth) return;
   // Each identical half covers the viewport, plus one phrase of spare text.
   // Sliding by exactly one half then resets onto the same visible words.
   const copies = Math.ceil(ticker.clientWidth / topicWidth) + 1;
   for (const group of groups) {
    while (group.children.length < copies) group.appendChild(topics.cloneNode(true));
    while (group.children.length > copies) group.lastElementChild!.remove();
   }
   // Keep the same gentle reading speed on phones and wide screens.
   ticker.style.setProperty('--aliens-topic-duration', `${groups[0].getBoundingClientRect().width / 20}s`);
   ticker.setAttribute('data-ready', '');
  };
  const observer = new ResizeObserver(fit);
  observer.observe(ticker);
  observer.observe(topics);
  fit();
 });
</script>
