---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RepositoryAnalysis from '@/components/RepositoryAnalysis.astro';
import UseModel from '@/components/UseModel.astro';
import { repositoryNotebookHref, repositoryNotebooks } from '@/lib/notebooks';
import { getPublicRepository, kindPath, type RepositoryBundle } from '@/lib/repository';
import type { RepositoryKind } from '@/lib/catalog';

interface Props {
  kind: RepositoryKind;
  owner: string;
  slug: string;
}

const { kind, owner, slug } = Astro.props;
const result = await getPublicRepository(Astro.locals, kind, owner, slug);
const repository = result.repository;
if (!repository) Astro.response.status = result.state === 'error' ? 503 : 404;

function relatedPath(relationship: RepositoryBundle['relationships'][number]): string {
  return `/${kindPath(relationship.related_kind)}/${encodeURIComponent(relationship.related_owner)}/${encodeURIComponent(relationship.related_slug)}`;
}

const hasGguf = repository?.files.some((file) => file.path.toLowerCase().endsWith('.gguf')) ?? false;
const hasDiffusers = repository?.files.some((file) => file.path.toLowerCase() === 'model_index.json') ?? false;
const cardTitle = kind === 'model' ? 'Model Card' : kind === 'dataset' ? 'Data Card' : 'App Card';
const folders = repository
  ? [...new Set(repository.files.flatMap((file) => {
      const parts = file.path.split('/');
      return parts.slice(0, -1).map((_, index) => parts.slice(0, index + 1).join('/'));
    }))].sort()
  : [];
const provenanceSources = repository && Array.isArray(repository.provenance.sources)
  ? repository.provenance.sources.filter((value): value is string => typeof value === 'string')
  : [];
const reactionEmoji: Record<string, string> = { helpful: '💡', celebrate: '🎉', heart: '❤️', eyes: '👀' };
const compatibilityEvidence = repository?.compatibility && Array.isArray(repository.compatibility.evidence.evidence_urls)
  ? repository.compatibility.evidence.evidence_urls.filter((value): value is string => typeof value === 'string' && value.startsWith('https://'))
  : [];
const compatibilityTargets = repository?.compatibility ? [
  ['CPU', repository.compatibility.cpu_compatible],
  ['NVIDIA CUDA', repository.compatibility.cuda_compatible],
  ['AMD ROCm', repository.compatibility.rocm_compatible],
  ['Apple Metal', repository.compatibility.metal_compatible],
  ['MLX', repository.compatibility.mlx_compatible],
  ['llama.cpp', repository.compatibility.llama_cpp_compatible],
  ['Browser', repository.compatibility.browser_compatible],
] as const : [];
const notebooks = repository ? repositoryNotebooks(repository) : [];
const notebookPaths = new Set(notebooks.map((notebook) => notebook.path));
---

<BaseLayout
  title={repository?.title ?? 'Repository unavailable'}
  description={repository?.summary ?? 'This public Super ii repository is unavailable.'}
  noindex={!repository}
>
  {repository ? (
    <main class="repository-page shell">
      <header class="repository-header">
        <p class="eyebrow">{repository.kind} repository</p>
        <p class="repository-path">{repository.owner_handle} / {repository.slug}</p>
        <h1>{repository.title}</h1>
        <p>{repository.summary}</p>
        <div class="repository-badges">
          <span>{repository.license ?? 'License pending'}</span>
          {repository.task && <span>{repository.task}</span>}
          {repository.library && <span>{repository.library}</span>}
          {repository.modality && <span>{repository.modality}</span>}
          <span>revision {repository.revision_sequence}</span>
          <span>{repository.likes_count} likes</span>
          <span>{repository.watchers_count} watching</span>
          <span>{repository.downloads_count} downloads</span>
          {repository.commit_sha && <span title={repository.commit_sha}>commit {repository.commit_sha.slice(0, 10)}</span>}
        </div>
        <div class="repository-actions" data-repository-actions data-repository-id={repository.id}>
          {kind === 'model' && (
            <>
              <button class="button button--yellow button--small" type="button" data-use-model-open aria-expanded="false" aria-controls="use-model">
                <i class="ph ph-play-circle" aria-hidden="true"></i><span>Use Model</span>
              </button>
              <a class="button button--secondary button--small" href="#model-tools">Try model</a>
            </>
          )}
          <button class="button button--secondary button--small" type="button" data-like-button data-active="false">
            <i class="ph ph-heart" aria-hidden="true"></i><span>Like</span>
          </button>
          <label>
            <span class="sr-only">Watch notifications</span>
            <select data-watch-level>
              <option value="releases">Watch releases</option>
              <option value="discussions">Watch discussions</option>
              <option value="all">Watch all</option>
              <option value="off">Stop watching</option>
            </select>
          </label>
          <button class="button button--secondary button--small" type="button" data-watch-button>Save watch</button>
          <label>
            <span class="sr-only">Choose a collection</span>
            <select data-collection-select disabled><option value="">Add to collection…</option></select>
          </label>
          <button class="button button--secondary button--small" type="button" data-collection-button disabled>Add</button>
          <p data-community-status aria-live="polite"></p>
        </div>
        <nav class="machine-resource-links" aria-label="Machine-readable repository resources">
          <a href={`/${kindPath(repository.kind)}/${encodeURIComponent(repository.owner_handle)}/${encodeURIComponent(repository.slug)}/README.md`}>README.md</a>
          <a href={`/${kindPath(repository.kind)}/${encodeURIComponent(repository.owner_handle)}/${encodeURIComponent(repository.slug)}/agents.md`}>agents.md</a>
          <a href={`/${kindPath(repository.kind)}/${encodeURIComponent(repository.owner_handle)}/${encodeURIComponent(repository.slug)}/manifest.json`}>manifest.json</a>
          {kind === 'model' && <a href={`/${kindPath(repository.kind)}/${encodeURIComponent(repository.owner_handle)}/${encodeURIComponent(repository.slug)}/use.json`}>use.json</a>}
          {kind === 'model' && <a href={`/${kindPath(repository.kind)}/${encodeURIComponent(repository.owner_handle)}/${encodeURIComponent(repository.slug)}/use.md`}>use.md</a>}
          <a href={`/${kindPath(repository.kind)}/${encodeURIComponent(repository.owner_handle)}/${encodeURIComponent(repository.slug)}/mcp`}>MCP</a>
        </nav>
      </header>

      {kind === 'model' && <UseModel repository={repository} origin={Astro.url.origin} />}

      <nav class="repository-tabs" aria-label="Repository sections">
        <a href="#card">{cardTitle}</a>
        <a href="#files">Files</a>
        {notebooks.length > 0 && <a href="#notebooks">Notebooks</a>}
        <a href="#versions">Versions</a>
        <a href="#analysis">Analysis</a>
        {kind === 'model' && <a href="#compatibility">Compatibility</a>}
        <a href="#lineage">Lineage</a>
        <a href="#community">Community</a>
      </nav>

      <section class="repository-section" id="card">
        <div class="repository-section__heading"><div><p class="eyebrow">Documentation</p><h2>{cardTitle}</h2></div></div>
        {repository.card_markdown ? (
          <article class="repository-card-markdown">{repository.card_markdown}</article>
        ) : (
          <p>This repository does not yet include a written {cardTitle.toLowerCase()}.</p>
        )}
        {provenanceSources.length > 0 && (
          <div class="provenance-sources">
            <h3>Declared provenance sources</h3>
            <ul>{provenanceSources.map((source) => <li><a href={source} rel="nofollow noreferrer">{source}</a></li>)}</ul>
          </div>
        )}
      </section>

      <section class="repository-section" id="files">
        <div class="repository-section__heading">
          <div><p class="eyebrow">Immutable revision</p><h2>Files</h2></div>
          <code>{repository.manifest_sha256}</code>
        </div>
        <div class="repository-tree-summary">
          <span><i class="ph ph-git-branch" aria-hidden="true"></i> {repository.branches.length} {repository.branches.length === 1 ? 'branch' : 'branches'}</span>
          <span><i class="ph ph-folder" aria-hidden="true"></i> {folders.length} {folders.length === 1 ? 'folder' : 'folders'}</span>
          <span><i class="ph ph-file" aria-hidden="true"></i> {repository.files.length} files</span>
        </div>
        {folders.length > 0 && <p class="folder-list" aria-label="Repository folders">{folders.map((folder) => <code><i class="ph ph-folder" aria-hidden="true"></i>{folder}/</code>)}</p>}
        <div class="file-table-wrap">
          <table class="file-table">
            <thead><tr><th>Path</th><th>Type</th><th>Size</th><th>SHA-256</th><th></th></tr></thead>
            <tbody>
              {repository.files.map((file) => (
                <tr>
                  <td><code>{file.path}</code></td>
                  <td>{file.mime_type}</td>
                  <td>{Number(file.size_bytes).toLocaleString()} B</td>
                  <td><code title={file.sha256}>{file.sha256.slice(0, 12)}…</code></td>
                  <td>
                    <span class="file-actions">
                      {notebookPaths.has(file.path) && <a href={repositoryNotebookHref(repository, file.path)}>View notebook</a>}
                      <a href={`/api/repositories/${repository.id}/files/${file.id}`}>Download</a>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="repository-integrity">Every listed file passed ClamAV, Gitleaks, format policy, immutable manifest verification, and human review before publication.</p>
      </section>

      {notebooks.length > 0 && (
        <section class="repository-section" id="notebooks" data-notebook-runtime data-repository-id={repository.id}>
          <div class="repository-section__heading">
            <div><p class="eyebrow">Static reader</p><h2>Notebooks</h2></div>
            <span>{notebooks.length} validated</span>
          </div>
          <p class="repository-integrity">The static viewer never executes code automatically. Signed-in users can explicitly run a reviewed notebook in a one-shot Docker sandbox with no network, no injected secrets, a read-only repository, and strict CPU, memory, process, output, and time limits. 🔒</p>
          <div class="repository-notebooks">
            {notebooks.map((notebook) => (
              <article class="repository-notebook-item">
                <a href={repositoryNotebookHref(repository, notebook.path)}>
                  <i class="ph ph-notebook" aria-hidden="true"></i>
                  <span><strong>{notebook.path}</strong><small>{notebook.cell_count} cells · {notebook.kernel.display_name ?? notebook.kernel.language ?? 'kernel not declared'}</small></span>
                  <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </a>
                <div class="repository-notebook-actions">
                  <button class="button button--secondary button--small" type="button" data-notebook-execute={notebook.path}>Run isolated</button>
                  <p data-notebook-status aria-live="polite"></p>
                  <a data-notebook-result hidden>Download verified result ✅</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="repository-section" id="versions">
        <div class="repository-section__heading"><div><p class="eyebrow">Release history</p><h2>Versions</h2></div></div>
        <div class="branch-list" aria-label="Branches">
          {repository.branches.map((branch) => (
            <span class:list={['branch-chip', branch.is_default && 'branch-chip--default']}>
              <i class="ph ph-git-branch" aria-hidden="true"></i>{branch.name}
              {branch.sequence && <small>r{branch.sequence}</small>}
            </span>
          ))}
        </div>
        <div class="version-list">
          {repository.versions.map((version) => (
            <article>
              <div><strong>Revision {version.sequence}</strong><time datetime={version.published_at}>{new Date(version.published_at).toLocaleDateString('en', { dateStyle: 'medium', timeZone: 'UTC' })}</time></div>
              <p>{version.message || 'No release message.'}</p>
              <small>{version.branch_name ?? 'main'} · {version.file_count} files · {Number(version.total_size_bytes).toLocaleString()} bytes · <code>{version.commit_sha?.slice(0, 12) ?? version.manifest_sha256.slice(0, 12)}…</code></small>
            </article>
          ))}
        </div>
        {repository.releases.length > 0 && (
          <div class="release-list">
            <h3>Named releases</h3>
            {repository.releases.map((release) => <p><strong>{release.name}</strong> <span>{release.notes}</span></p>)}
          </div>
        )}
        {repository.tags.length > 0 && <p class="tag-list">{repository.tags.map((tag) => <span>{tag.name}</span>)}</p>}
      </section>

      {kind === 'model' && (
        <section class="repository-section model-tools" id="model-tools" data-model-tools data-repository-id={repository.id} data-revision-id={repository.revision_id} data-browser-model={`${repository.owner_handle}/${repository.slug}`}>
          <div class="repository-section__heading"><div><p class="eyebrow">Local tools</p><h2>Try this model</h2></div></div>
          <div class="tool-grid">
            <form class="tool-card" data-tokenizer-form>
              <h3>Tokenizer</h3>
              <p>Tokenize locally on the Super ii Runtime without any external model API.</p>
              <textarea name="text" maxlength="100000" required placeholder="Type text to inspect tokens"></textarea>
              <button class="button button--dark button--small" type="submit">Tokenize</button>
              <pre data-tokenizer-output hidden></pre>
            </form>
            <form class="tool-card" data-browser-ai-form>
              <h3>Browser inference</h3>
              <p>Runs on your device with local model files and local WASM. WebGPU falls back to WASM.</p>
              <label>Task <select name="task" data-browser-task>
                <option value="text-classification">Text classification</option>
                <option value="feature-extraction">Embeddings</option>
                <option value="token-classification">Token classification</option>
                <option value="text-generation">Text generation</option>
                <option value="image-classification">Image classification</option>
                <option value="image-to-text">Image to text</option>
                <option value="audio-classification">Audio classification</option>
                <option value="automatic-speech-recognition">Speech recognition</option>
              </select></label>
              <label data-browser-text-field>Text input <textarea name="input" maxlength="100000" required placeholder="Input for this model"></textarea></label>
              <label data-browser-media-field hidden>Local media <input name="media" type="file" /><span>Your selected file stays on this device.</span></label>
              <button class="button button--dark button--small" type="submit">Run on this device</button>
              <p class="tool-status" data-browser-ai-status></p>
              <pre data-browser-ai-output hidden></pre>
            </form>
            {hasGguf && (
              <form class="tool-card tool-card--wide" data-llama-form>
                <h3>llama.cpp</h3>
                <p>Run or chat with the reviewed GGUF model on the operator-owned persistent llama.cpp server. The immutable model stays warm for later requests, then unloads after an idle timeout. Sign-in and rate limits protect the shared machine.</p>
                <label>Mode <select name="mode"><option value="generate">Generate</option><option value="chat">Chat</option></select></label>
                <label>System message <textarea name="system" maxlength="100000" placeholder="Optional for chat"></textarea></label>
                <label>Prompt <textarea name="prompt" maxlength="100000" required placeholder="Ask or prompt this GGUF model"></textarea></label>
                <div class="generation-grid">
                  <label>Max tokens <input name="max_tokens" type="number" min="1" max="4096" value="256" required /></label>
                  <label>Temperature <input name="temperature" type="number" min="0" max="2" step="0.05" value="0.7" required /></label>
                  <label>Top P <input name="top_p" type="number" min="0.01" max="1" step="0.01" value="0.95" required /></label>
                  <label>Seed <input name="seed" type="number" min="-1" max="2147483647" value="-1" required /></label>
                </div>
                <button class="button button--dark button--small" type="submit">Run on Super ii Runtime</button>
                <button class="button button--secondary button--small" type="button" data-llama-unload>Unload model (owner)</button>
                <p class="tool-status" data-llama-status></p>
                <pre data-llama-output hidden></pre>
              </form>
            )}
            {hasDiffusers && (
              <form class="tool-card tool-card--wide" data-diffusers-form>
                <h3>Diffusers image generation</h3>
                <p>Generate with local reviewed weights, internet disabled, safetensors required, and no commercial inference API.</p>
                <label>Prompt <textarea name="prompt" maxlength="5000" required placeholder="Describe the image"></textarea></label>
                <label>Negative prompt <textarea name="negative_prompt" maxlength="5000" placeholder="Optional exclusions"></textarea></label>
                <div class="generation-grid">
                  <label>Steps <input name="steps" type="number" min="1" max="100" value="30" required /></label>
                  <label>Guidance <input name="guidance_scale" type="number" min="0" max="30" step="0.1" value="7.5" required /></label>
                  <label>Width <input name="width" type="number" min="128" max="2048" step="8" value="512" required /></label>
                  <label>Height <input name="height" type="number" min="128" max="2048" step="8" value="512" required /></label>
                  <label>Seed <input name="seed" type="number" min="0" max="4294967295" value="0" required /></label>
                </div>
                <button class="button button--dark button--small" type="submit">Generate locally</button>
                <p class="tool-status" data-diffusers-status></p>
                <img data-diffusers-image hidden alt="Generated by the selected local Diffusers model" />
              </form>
            )}
          </div>
        </section>
      )}

      {kind === 'space' && (
        <section class="repository-section space-runtime" data-space-runtime data-repository-id={repository.id}>
          <div class="repository-section__heading"><div><p class="eyebrow">Isolated local container</p><h2>Run this app</h2></div></div>
          <p>The reviewed Gradio repository runs with no network egress, a read-only filesystem, dropped Linux capabilities, and explicit CPU, memory, and process limits.</p>
          <div class="space-controls">
            <button class="button button--secondary button--small" type="button" data-space-build>Prepare build</button>
            <button class="button button--dark button--small" type="button" data-space-start>Start app</button>
            <button class="button button--secondary button--small" type="button" data-space-stop disabled>Stop app</button>
            <button class="button button--secondary button--small" type="button" data-space-logs>View logs</button>
            <p data-space-status aria-live="polite">Sign in to start the self-hosted runtime.</p>
          </div>
          <pre class="space-logs" data-space-log-output hidden></pre>
          <iframe
            data-space-frame
            title={`${repository.title} Gradio app`}
            hidden
            sandbox="allow-downloads allow-forms allow-modals allow-popups allow-scripts"
            referrerpolicy="no-referrer"
          ></iframe>
        </section>
      )}

      <section class="repository-section" id="analysis">
        <div class="repository-section__heading"><div><p class="eyebrow">Offline inspection</p><h2>Analysis</h2></div></div>
        <RepositoryAnalysis repository={repository} />
      </section>

      {kind === 'model' && (
        <section class="repository-section" id="compatibility">
          <div class="repository-section__heading">
            <div><p class="eyebrow">Hardware intelligence 🧠</p><h2>Compatibility</h2></div>
            {repository.compatibility && <span>{repository.compatibility.confidence}</span>}
          </div>
          {repository.compatibility ? (
            <>
              <div class="compatibility-facts">
                <article><span>Architecture</span><strong>{repository.compatibility.architecture ?? 'Not identified'}</strong></article>
                <article><span>Tensor format</span><strong>{repository.compatibility.tensor_format ?? 'Not identified'}</strong></article>
                <article><span>Quantization</span><strong>{repository.compatibility.quantization ?? 'Not identified'}</strong></article>
                <article><span>Model size</span><strong>{(Number(repository.compatibility.model_size_bytes) / 1024 ** 3).toFixed(2)} GiB</strong></article>
                <article><span>Estimated minimum RAM</span><strong>{(Number(repository.compatibility.minimum_ram_bytes) / 1024 ** 3).toFixed(2)} GiB</strong></article>
                <article><span>Estimated minimum VRAM</span><strong>{(Number(repository.compatibility.minimum_vram_bytes) / 1024 ** 3).toFixed(2)} GiB</strong></article>
              </div>
              <div class="compatibility-targets" aria-label="Compatible hardware and runtimes">
                {compatibilityTargets.map(([label, compatible]) => (
                  <span class:list={['compatibility-chip', compatible === true && 'compatibility-chip--yes', compatible === false && 'compatibility-chip--no']}>
                    <i class:list={['ph', compatible === true ? 'ph-check-circle' : compatible === false ? 'ph-x-circle' : 'ph-question']} aria-hidden="true"></i>
                    {label}: {compatible === true ? 'compatible' : compatible === false ? 'not detected' : 'unknown'}
                  </span>
                ))}
              </div>
              <p class="repository-integrity">
                {repository.compatibility.confidence === 'verified'
                  ? 'This record includes verified evidence.'
                  : repository.compatibility.confidence === 'declared'
                    ? 'These fields include publisher declarations checked for structure, not independent performance verification.'
                    : 'These fields are conservative offline estimates from reviewed formats and metadata, not benchmark guarantees.'}
              </p>
              {compatibilityEvidence.length > 0 && <p class="compatibility-evidence"><strong>Evidence:</strong> {compatibilityEvidence.map((url) => <a href={url} rel="nofollow noreferrer">{url}</a>)}</p>}
            </>
          ) : <p>No compatibility record is available for this reviewed revision yet.</p>}
        </section>
      )}

      <section class="repository-section" id="lineage">
        <div class="repository-section__heading"><div><p class="eyebrow">Provenance graph</p><h2>Lineage</h2></div></div>
        {repository.relationships.length ? (
          <div class="lineage-graph" role="list" aria-label={`Provenance relationships for ${repository.title}`}>
            <div class="lineage-root"><span>{repository.kind}</span><strong>{repository.owner_handle}/{repository.slug}</strong></div>
            {repository.relationships.map((relationship) => (
              <article class="lineage-edge" role="listitem">
                <i class:list={['ph', relationship.direction === 'outgoing' ? 'ph-arrow-right' : 'ph-arrow-left']} aria-hidden="true"></i>
                <div><span>{relationship.direction === 'outgoing' ? relationship.relationship_type : `source: ${relationship.relationship_type}`}</span><a href={relatedPath(relationship)}>{relationship.related_owner} / {relationship.related_slug}</a></div>
                {relationship.evidence_url && <a class="lineage-evidence" href={relationship.evidence_url} rel="nofollow noreferrer">Evidence</a>}
              </article>
            ))}
          </div>
        ) : <p>No lineage relationship has been declared for this release.</p>}
        {repository.agent_traces.length > 0 && (
          <div class="agent-trace-list">
            <h3>Public agent traces 🤖</h3>
            <p>Trace payloads stay private. Public records expose bounded metadata and hashes only.</p>
            {repository.agent_traces.map((trace) => (
              <article>
                <div><strong>{trace.agent_name}</strong><span>{trace.status}</span></div>
                <p>{trace.tool_name ?? 'Unspecified tool'} · {trace.duration_ms === null ? 'duration unavailable' : `${trace.duration_ms} ms`}</p>
                <code>{trace.trace_id}</code>
              </article>
            ))}
          </div>
        )}
        {repository.related.length > 0 && (
          <div class="related-repositories">
            <h3>Related models, datasets, and apps 🧭</h3>
            <div class="catalog-results">
              {repository.related.map((related) => (
                <a class="catalog-card" href={`/${kindPath(related.kind)}/${encodeURIComponent(related.owner_handle)}/${encodeURIComponent(related.slug)}`}>
                  <div class="catalog-card__topline"><span>{related.kind}</span><span>match {related.match_score}</span></div>
                  <h3>{related.title}</h3><p>{related.summary}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </section>

      <section class="repository-section" id="community">
        <div class="repository-section__heading"><div><p class="eyebrow">Community</p><h2>Discussions</h2></div></div>
        <form class="discussion-form" data-discussion-form data-repository-id={repository.id}>
          <h3>Start a discussion</h3>
          <label>Title <input name="title" minlength="3" maxlength="300" required /></label>
          <label>Message <textarea name="body" maxlength="100000" required></textarea></label>
          <button class="button button--dark button--small" type="submit">Publish discussion</button>
          <p data-form-status aria-live="polite"></p>
        </form>
        {repository.discussions.length ? (
          <div class="discussion-list">
            {repository.discussions.map((discussion) => (
              <article data-discussion-id={discussion.id}>
                <div><span>{discussion.status}</span><span>{discussion.comment_count} comments</span></div>
                <h3>{discussion.title}</h3>
                <p>{discussion.body}</p>
                <small>Started by {discussion.author}</small>
                <div class="reaction-row" aria-label="React to discussion">
                  {(['helpful', 'celebrate', 'heart', 'eyes'] as const).map((reaction) => (
                    <button type="button" data-reaction data-target-type="discussion" data-target-id={discussion.id} data-reaction-name={reaction} data-active="false">
                      <span aria-hidden="true">{reactionEmoji[reaction]}</span> {reaction} <span>{discussion.reactions[reaction] ?? 0}</span>
                    </button>
                  ))}
                </div>
                {discussion.comments.length > 0 && (
                  <div class="comment-list">
                    {discussion.comments.map((comment) => (
                      <div class="comment-card">
                        <p>{comment.body}</p>
                        <small>{comment.author}</small>
                        <div class="reaction-row" aria-label="React to comment">
                          {(['helpful', 'heart'] as const).map((reaction) => (
                            <button type="button" data-reaction data-target-type="comment" data-target-id={comment.id} data-reaction-name={reaction} data-active="false">
                              <span aria-hidden="true">{reactionEmoji[reaction]}</span> {reaction} <span>{comment.reactions[reaction] ?? 0}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
                {discussion.status === 'open' && (
                  <form class="comment-form" data-comment-form data-discussion-id={discussion.id}>
                    <label><span class="sr-only">Add a comment</span><textarea name="body" maxlength="100000" required placeholder="Add a comment"></textarea></label>
                    <button class="button button--secondary button--small" type="submit">Comment</button>
                    <p data-form-status aria-live="polite"></p>
                  </form>
                )}
              </article>
            ))}
          </div>
        ) : <p>No discussion has started yet.</p>}
      </section>
    </main>
  ) : (
    <section class="shell unavailable-state">
      <p class="eyebrow">{result.state === 'error' ? 'Service unavailable' : 'Not found'}</p>
      <h1>{result.state === 'error' ? 'Repository data is temporarily unavailable.' : 'This public repository does not exist.'}</h1>
      <p>No placeholder content is shown.</p>
      <a class="button button--secondary" href={`/${kindPath(kind)}`}>Back to catalog</a>
    </section>
  )}
</BaseLayout>

{repository && kind === 'model' && <script>
  import { createBrowserAiRunner, type BrowserAiTask } from '@/lib/browser-ai';

  const tools = document.querySelector('[data-model-tools]');
  if (tools instanceof HTMLElement) {
    const repositoryId = tools.dataset.repositoryId;
    const browserModel = tools.dataset.browserModel;
    const tokenizerForm = tools.querySelector('[data-tokenizer-form]');
    tokenizerForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(tokenizerForm instanceof HTMLFormElement) || !repositoryId) return;
      const output = tokenizerForm.querySelector('[data-tokenizer-output]');
      const submit = tokenizerForm.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      try {
        const form = new FormData(tokenizerForm);
        const response = await fetch(`/api/repositories/${repositoryId}/tokenize`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text: form.get('text'), add_special_tokens: true }),
        });
        const data = await response.json() as Record<string, unknown>;
        if (!response.ok) throw new Error(typeof data.error === 'string' ? data.error : 'Tokenizer unavailable');
        if (output instanceof HTMLElement) {
          output.hidden = false;
          output.textContent = JSON.stringify(data, null, 2);
        }
      } catch (error) {
        if (output instanceof HTMLElement) {
          output.hidden = false;
          output.textContent = error instanceof Error ? error.message : 'Tokenizer unavailable';
        }
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });

    const browserForm = tools.querySelector('[data-browser-ai-form]');
    const browserTask = browserForm?.querySelector('[data-browser-task]');
    const browserTextField = browserForm?.querySelector('[data-browser-text-field]');
    const browserMediaField = browserForm?.querySelector('[data-browser-media-field]');
    const browserText = browserTextField?.querySelector('textarea');
    const browserMedia = browserMediaField?.querySelector('input[type="file"]');
    function syncBrowserInput() {
      if (!(browserTask instanceof HTMLSelectElement)) return;
      const mediaTask = browserTask.value.startsWith('image-')
        ? 'image'
        : browserTask.value.startsWith('audio-') || browserTask.value === 'automatic-speech-recognition'
          ? 'audio'
          : null;
      if (browserTextField instanceof HTMLElement) browserTextField.hidden = mediaTask !== null;
      if (browserMediaField instanceof HTMLElement) browserMediaField.hidden = mediaTask === null;
      if (browserText instanceof HTMLTextAreaElement) browserText.required = mediaTask === null;
      if (browserMedia instanceof HTMLInputElement) {
        browserMedia.required = mediaTask !== null;
        browserMedia.accept = mediaTask ? `${mediaTask}/*` : '';
      }
    }
    browserTask?.addEventListener('change', syncBrowserInput);
    syncBrowserInput();
    browserForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(browserForm instanceof HTMLFormElement) || !browserModel) return;
      const status = browserForm.querySelector('[data-browser-ai-status]');
      const output = browserForm.querySelector('[data-browser-ai-output]');
      const submit = browserForm.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      let runner;
      let objectUrl: string | undefined;
      try {
        const form = new FormData(browserForm);
        const task = String(form.get('task')) as BrowserAiTask;
        const mediaTask = task.startsWith('image-')
          || task.startsWith('audio-')
          || task === 'automatic-speech-recognition';
        let input: string;
        if (mediaTask) {
          const file = form.get('media');
          if (!(file instanceof File) || file.size < 1) throw new Error('Choose a local media file first.');
          if (file.size > 100 * 1024 * 1024) throw new Error('Local media is limited to 100 MB.');
          objectUrl = URL.createObjectURL(file);
          input = objectUrl;
        } else {
          input = String(form.get('input') ?? '');
          if (!input) throw new Error('Enter text first.');
        }
        if (status instanceof HTMLElement) status.textContent = 'Loading verified local model files…';
        runner = await createBrowserAiRunner(
          task,
          browserModel,
          (progress) => {
            if (status instanceof HTMLElement && typeof progress === 'object' && progress) {
              const event = progress as { status?: string; progress?: number };
              status.textContent = event.progress === undefined
                ? (event.status ?? 'Loading…')
                : `${event.status ?? 'Loading'} ${Math.round(event.progress)}%`;
            }
          },
        );
        const result = await runner.run(input);
        if (status instanceof HTMLElement) status.textContent = `Completed locally with ${runner.device}.`;
        if (output instanceof HTMLElement) {
          output.hidden = false;
          output.textContent = JSON.stringify(result, null, 2);
        }
      } catch (error) {
        if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : 'Browser inference failed.';
      } finally {
        await runner?.dispose();
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });

    const llamaForm = tools.querySelector('[data-llama-form]');
    llamaForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(llamaForm instanceof HTMLFormElement) || !repositoryId) return;
      const status = llamaForm.querySelector('[data-llama-status]');
      const output = llamaForm.querySelector('[data-llama-output]');
      const submit = llamaForm.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      try {
        const form = new FormData(llamaForm);
        const mode = String(form.get('mode'));
        const prompt = String(form.get('prompt'));
        const system = String(form.get('system') ?? '').trim();
        const payload: Record<string, unknown> = {
          mode,
          max_tokens: Number(form.get('max_tokens')),
          temperature: Number(form.get('temperature')),
          top_p: Number(form.get('top_p')),
          seed: Number(form.get('seed')),
        };
        if (mode === 'chat') {
          payload.messages = [
            ...(system ? [{ role: 'system', content: system }] : []),
            { role: 'user', content: prompt },
          ];
        } else {
          payload.prompt = prompt;
        }
        if (status instanceof HTMLElement) status.textContent = 'Running on the self-hosted llama.cpp runtime…';
        const response = await fetch(`/api/repositories/${repositoryId}/llama`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json() as Record<string, unknown>;
        const reason = typeof data.error === 'string' ? data.error : typeof data.detail === 'string' ? data.detail : 'llama.cpp unavailable';
        if (!response.ok) throw new Error(reason);
        if (status instanceof HTMLElement) status.textContent = 'Completed offline; this verified model remains warm for the next request. ⚡';
        if (output instanceof HTMLElement) {
          output.hidden = false;
          output.textContent = JSON.stringify(data, null, 2);
        }
      } catch (error) {
        if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : 'llama.cpp unavailable.';
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });

    const llamaUnload = tools.querySelector('[data-llama-unload]');
    llamaUnload?.addEventListener('click', async () => {
      if (!(llamaUnload instanceof HTMLButtonElement) || !repositoryId) return;
      const status = llamaForm?.querySelector('[data-llama-status]');
      llamaUnload.disabled = true;
      try {
        const response = await fetch(`/api/repositories/${repositoryId}/llama`, { method: 'DELETE' });
        const result = await response.json() as Record<string, unknown>;
        if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'Model could not be unloaded.');
        if (status instanceof HTMLElement) status.textContent = 'Persistent model unloaded and memory released.';
      } catch (error) {
        if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : 'Model could not be unloaded.';
      } finally {
        llamaUnload.disabled = false;
      }
    });

    const diffusersForm = tools.querySelector('[data-diffusers-form]');
    diffusersForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(diffusersForm instanceof HTMLFormElement) || !repositoryId) return;
      const status = diffusersForm.querySelector('[data-diffusers-status]');
      const image = diffusersForm.querySelector('[data-diffusers-image]');
      const submit = diffusersForm.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      try {
        const form = new FormData(diffusersForm);
        if (status instanceof HTMLElement) status.textContent = 'Generating with local reviewed weights…';
        const response = await fetch(`/api/repositories/${repositoryId}/diffusers`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            prompt: String(form.get('prompt')),
            negative_prompt: String(form.get('negative_prompt') ?? '') || null,
            steps: Number(form.get('steps')),
            guidance_scale: Number(form.get('guidance_scale')),
            width: Number(form.get('width')),
            height: Number(form.get('height')),
            seed: Number(form.get('seed')),
          }),
        });
        const data = await response.json() as Record<string, unknown>;
        const reason = typeof data.error === 'string' ? data.error : typeof data.detail === 'string' ? data.detail : 'Diffusers unavailable';
        if (!response.ok || typeof data.image_url !== 'string') throw new Error(reason);
        if (image instanceof HTMLImageElement) {
          image.src = data.image_url;
          image.hidden = false;
        }
        if (status instanceof HTMLElement) status.textContent = `Completed offline · seed ${String(data.seed ?? '')}`;
      } catch (error) {
        if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : 'Diffusers unavailable.';
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  }
</script>}

{repository && notebooks.length > 0 && <script>
  const notebookRuntime = document.querySelector('[data-notebook-runtime]');
  if (notebookRuntime instanceof HTMLElement && notebookRuntime.dataset.repositoryId) {
    const repositoryId = notebookRuntime.dataset.repositoryId;
    notebookRuntime.querySelectorAll('[data-notebook-execute]').forEach((control) => {
