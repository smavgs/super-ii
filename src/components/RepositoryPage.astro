          });
          const result = await response.json() as Record<string, unknown>;
          const detail = result.detail;
          const reason = typeof result.error === 'string'
            ? result.error
            : typeof detail === 'string'
              ? detail
              : 'Notebook execution failed.';
          if (!response.ok || typeof result.session_id !== 'string') throw new Error(reason);
          if (status instanceof HTMLElement) {
            status.textContent = 'Execution completed with network disabled and no secrets injected.';
            const link = status.parentElement?.querySelector('[data-notebook-result]');
            if (link instanceof HTMLAnchorElement) {
              link.href = `/api/notebooks/${result.session_id}/result`;
              link.hidden = false;
            }
          }
