  .notification-list :global(button) { background: none; color: inherit; padding: .35rem; border: 1px solid #999; border-radius: 3px; cursor: pointer; font: inherit; }
  .notification-panel > footer { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between; padding: .8rem 1rem; font-size: .75rem; }
