<div class="notification-hub" data-notifications data-machine-exclude>
  <button class="icon-button notification-bell" type="button" data-notification-toggle aria-label="Notifications" aria-expanded="false" aria-controls="notification-panel">
    <i class="ph ph-bell" aria-hidden="true"></i><span class="notification-count" data-notification-count hidden></span>
  </button>
  <section class="notification-panel" id="notification-panel" data-notification-panel aria-label="Notifications" hidden>
    <header><div><p>👾 YOUR WORK</p><h2>Notifications</h2></div><button type="button" class="icon-button" data-notification-close aria-label="Close notifications">×</button></header>
    <div class="notification-filters" role="group" aria-label="Filter notifications"><button type="button" data-notification-filter="unread" aria-pressed="true">Unread</button><button type="button" data-notification-filter="action" aria-pressed="false">Needs you</button><button type="button" data-notification-filter="all" aria-pressed="false">All</button></div>
    <p class="notification-status" data-notification-status role="status">Loading your updates…</p>
    <ol class="notification-list" data-notification-list></ol>
    <footer><button type="button" class="text-button" data-notification-more hidden>Load earlier</button><button type="button" class="text-button" data-notification-refresh>Refresh</button><a href="/account#activity">Workspace activity ↗</a></footer>
  </section>
  <span class="sr-only" role="status" data-notification-announcement></span>
</div>
<script>import '@/scripts/notifications';</script>
<style>
  .notification-hub { position: relative; }
  .notification-bell { position: relative; }
  .notification-bell.has-unread { color: #cf2525; }
