  .notification-panel { position: absolute; z-index: 110; right: -3.5rem; top: calc(100% + 1rem); width: min(26rem, calc(100vw - 1.5rem)); max-height: min(38rem,calc(100dvh - 6rem)); overflow: auto; overscroll-behavior: contain; background: var(--paper,#fffdf6); color: var(--ink,#071a2f); border: 1px solid var(--line,#999); border-radius: 5px; box-shadow: 5px 5px 0 #1113; }
