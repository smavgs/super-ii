  .notification-filters button[aria-pressed='true'] { background: #ffd21e; color: #222; border-color: #333; }
  .notification-status { margin: .75rem 1rem; font-size: .85rem; }
  .notification-list { list-style: none; margin: 0; padding: 0; }
