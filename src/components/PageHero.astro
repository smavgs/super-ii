---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  compact?: boolean;
}

const { eyebrow, title, description, compact = false } = Astro.props;
---

<section class:list={['page-hero', compact && 'page-hero--compact']}>
  <div class="shell page-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
    <slot />
  </div>
</section>
