---
import {
  siGithub,
  siQq,
  siSinaweibo,
  siTelegram,
  siWechat,
  siWhatsapp,
  siXiaohongshu,
} from 'simple-icons';

interface Props {
  service: string;
}

const { service } = Astro.props;
const brands = {
  wechat: siWechat,
  whatsapp: siWhatsapp,
  telegram: siTelegram,
  github: siGithub,
  qq: siQq,
  red: siXiaohongshu,
  weibo: siSinaweibo,
} as const;
const generic = {
  email: { icon: 'ph-envelope-simple', color: '#2f80ed', ink: '#ffffff' },
  phone: { icon: 'ph-phone', color: '#16a34a', ink: '#ffffff' },
  website: { icon: 'ph-globe-hemisphere-west', color: '#00aef0', ink: '#ffffff' },
  custom: { icon: 'ph-link', color: '#0b2947', ink: '#ffffff' },
} as const;
const brand = brands[service as keyof typeof brands];
const fallback = generic[service as keyof typeof generic] ?? generic.custom;
const isLinkedIn = service === 'linkedin';
const isHuggingFace = service === 'huggingface';
const background = isLinkedIn ? '#0a66c2' : isHuggingFace ? '#fff7d6' : (brand ? `#${brand.hex}` : fallback.color);
const foreground = isHuggingFace ? '#111827' : (brand || isLinkedIn ? '#ffffff' : fallback.ink);
const linkedInPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9H7.12v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<span
  class="card-service-mark"
  style={`--service-mark-bg:${background};--service-mark-ink:${foreground}`}
  data-service-mark={service}
  aria-hidden="true"
>
  {isHuggingFace
    ? <span class="card-service-mark__emoji">🤗</span>
    : isLinkedIn
      ? <svg viewBox="0 0 24 24" role="img"><path d={linkedInPath}></path></svg>
      : brand
    ? <svg viewBox="0 0 24 24" role="img"><path d={brand.path}></path></svg>
    : <i class={`ph ${fallback.icon}`}></i>}
</span>

<style>
  .card-service-mark {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: 0.72rem;
    background: var(--service-mark-bg);
    color: var(--service-mark-ink);
    box-shadow: 0 5px 12px rgb(7 26 47 / 0.14), inset 0 1px 0 rgb(255 255 255 / 0.24);
  }

  .card-service-mark :is(svg, i) { width: 1.35rem; height: 1.35rem; }
  .card-service-mark svg { fill: currentColor; }
  .card-service-mark i { display: grid; place-items: center; font-size: 1.35rem; }
  .card-service-mark__emoji { font-size: 1.48rem; line-height: 1; filter: saturate(1.08); }
  .card-service-mark[data-service-mark="huggingface"] { border-color: #ffd21e; box-shadow: 0 5px 12px rgb(255 157 0 / 0.18), inset 0 1px 0 white; }
  .card-service-mark[data-service-mark="website"] { box-shadow: 0 5px 16px rgb(0 174 240 / 0.32), inset 0 1px 0 rgb(255 255 255 / 0.34); }
</style>
