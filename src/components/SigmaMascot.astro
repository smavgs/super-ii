---
interface Props {
  edition?: string;
}
---

<div
  class="sigma-mascot-wrap"
  data-sigma-mascot
  data-edition={Astro.props.edition}
  data-no-translate
>
  <span class="sigma-mascot" aria-hidden="true"
    ><span class="sigma-alien">👾</span><span class="sigma-beacon"></span><i
    ></i><i></i><i></i><i></i></span
  >
</div>
<style>
  .sigma-mascot-wrap {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    padding: 4px 4px 8px 0;
  }
  .sigma-mascot {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    background: #e6d9ff;
    border: 2px solid #20344b;
    border-radius: 4px;
    box-shadow: 3px 3px #20344b;
  }
  .sigma-alien {
    font-size: 2.2rem;
    line-height: 1;
    display: block;
    transform-origin: 50% 90%;
  }
  .sigma-beacon {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 10px;
    height: 10px;
    background: #c2ff38;
    border: 2px solid #20344b;
  }
  .sigma-mascot i {
    position: absolute;
    width: 5px;
    height: 5px;
    opacity: 0;
    background: #ff27d8;
    top: 4px;
    left: 0;
  }
  .sigma-mascot i:nth-of-type(2) {
    left: auto;
    right: 0;
    background: #ffd21e;
  }
  .sigma-mascot i:nth-of-type(3) {
    top: auto;
    bottom: 0;
    background: #88e5dd;
  }
  .sigma-mascot i:nth-of-type(4) {
    top: auto;
    bottom: 0;
    left: auto;
    right: 0;
    background: #c2ff38;
  }
  [data-moving="true"] .sigma-alien {
    animation: sigma-idle 6s ease-in-out infinite;
  }
  [data-moving="true"][data-reaction="edition"] .sigma-alien {
    animation: sigma-hop 700ms ease-out 1;
  }
  [data-moving="true"][data-reaction="edition"] .sigma-beacon {
    animation: sigma-signal 700ms ease-out 1;
  }
  [data-moving="true"][data-reaction="thanks"] .sigma-alien {
    animation: sigma-thanks 700ms ease-in-out 1;
  }
  [data-moving="true"][data-reaction="thanks"] .sigma-mascot i {
    animation: sigma-spark 650ms ease-out 1;
  }
  @keyframes sigma-idle {
    0%,
    60%,
    100% {
      transform: translateY(0) rotate(0);
    }
    30% {
      transform: translateY(-3px) rotate(-2deg);
    }
  }
  @keyframes sigma-hop {
    0%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px) rotate(3deg);
    }
    75% {
      transform: translateY(1px);
    }
  }
  @keyframes sigma-signal {
    50% {
      box-shadow: 0 0 0 5px #c2ff3860;
    }
  }
  @keyframes sigma-thanks {
    25% {
      transform: rotate(-8deg);
    }
    55% {
      transform: rotate(7deg);
    }
    80% {
      transform: rotate(-3deg);
    }
  }
  @keyframes sigma-spark {
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -18px;
      rotate: 40deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sigma-mascot-wrap :is(.sigma-alien, .sigma-beacon, i) {
      animation: none !important;
    }
  }
</style>
<script>
  import "@/scripts/sigma-motion";
</script>
