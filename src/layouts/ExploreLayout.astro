---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InfoTip from '@/components/InfoTip.astro';
import type { InfoHelpKey } from '@/lib/info-help';
import '@/styles/pixel-controls.css';
import '@/styles/explore.css';

interface Props {
  active: 'models' | 'datasets' | 'spaces' | 'transparent' | 'builders' | 'robots' | 'robot' | 'collections' | 'organizations' | 'use' | 'build' | 'tokenizer' | 'highlights' | 'enterprise' | 'docs' | 'notebooks' | 'about' | 'fame' | 'join-team' | 'pricing' | 'security' | 'legal/privacy' | 'legal/terms';
  title: string;
  eyebrow: string;
  description: string;
  titleHelp?: InfoHelpKey;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  hideHeading?: boolean;
}
const { active, title, eyebrow, description, titleHelp, image, imageAlt, noindex, hideHeading = false } = Astro.props;
const exploreDestinations = [
  { id: 'models', label: 'Models', icon: 'cube' },
  { id: 'datasets', label: 'Datasets', icon: 'database' },
  { id: 'spaces', label: 'Apps', icon: 'app-window' },
  { id: 'transparent', label: 'Transparent', icon: 'scan' },
  { id: 'builders', label: 'Builders', icon: 'users-three' },
  { id: 'robots', label: 'Robots', icon: 'robot' },
  { id: 'robot', label: 'Make Robot', icon: 'robot' },
  { id: 'collections', label: 'Collections', icon: 'stack' },
  { id: 'organizations', label: 'Organizations', icon: 'buildings' },
];
const toolDestinations = [
  { id: 'use', label: 'Use Super ii', icon: 'compass' },
  { id: 'build', label: 'Build & Ship', icon: 'code' },
  { id: 'tokenizer', label: 'Tokenizer', icon: 'squares-four' },
  { id: 'highlights', label: 'Highlights', icon: 'sparkle' },
  { id: 'enterprise', label: 'Enterprise', icon: 'buildings' },
];
const isTool = toolDestinations.some(item => item.id === active);
const guideGroups = [
  { label: 'Learn', pages: [
    { id: 'docs', label: 'Documentation', icon: 'book-open' },
    { id: 'notebooks', label: 'Notebooks', icon: 'notebook' },
  ] },
  { label: 'About Super ii', pages: [
    { id: 'about', label: 'About Super ii', icon: 'planet' },
    { id: 'fame', label: 'Hall of Fame', icon: 'star' },
    { id: 'join-team', label: 'Join Team', icon: 'handshake' },
  ] },
  { label: 'Plans & trust', pages: [
    { id: 'pricing', label: 'Pricing', icon: 'tag' },
    { id: 'security', label: 'Security', icon: 'shield-check' },
    { id: 'legal/privacy', label: 'Privacy Policy', icon: 'lock-key' },
    { id: 'legal/terms', label: 'Terms of Service', icon: 'file-text' },
  ] },
];
const guideGroup = guideGroups.find(group => group.pages.some(page => page.id === active));
const destinations = guideGroup?.pages ?? (isTool ? toolDestinations : exploreDestinations);
const navigationLabel = guideGroup?.label ?? (isTool ? 'Tools & services' : 'Explore');
---
<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} preferLight>
  <div class:list={["explore-skin", { "tools-skin": isTool, "guide-skin": Boolean(guideGroup) }]} data-explore-page={active}>
    <nav class="shell explore-nav" aria-label={guideGroup || isTool ? navigationLabel : "Explore Super ii"}>
      <a class="explore-workspace" href="/account"><i class="ph ph-arrow-left" aria-hidden="true"></i>Workspace</a>
      <details class="explore-switcher" data-explore-switcher>
        <summary><i class="ph ph-squares-four" aria-hidden="true"></i><span>{navigationLabel}</span><span class="explore-current">{destinations.find(item => item.id === active)?.label}</span></summary>
        <div class="explore-destinations">
          {destinations.map(item => <a href={`/${item.id}`} aria-current={item.id === active ? 'page' : undefined}><i class={`ph ph-${item.icon}`} aria-hidden="true"></i>{item.label}</a>)}
        </div>
      </details>
    </nav>
    {!hideHeading && <header class="shell explore-heading">
      <div class="explore-heading__identity"><span class="explore-mascot" aria-hidden="true">👾</span><div><p>{eyebrow}</p><div class="heading-with-help"><h1>{title}</h1>{titleHelp && <InfoTip term={titleHelp} />}</div></div></div>
      <p class="explore-description">{description}</p>
      {Astro.slots.has('actions') && <div class="button-row explore-actions"><slot name="actions" /></div>}
    </header>}
    <slot />
  </div>
</BaseLayout>
<script>
  import '@/scripts/explore';
</script>
