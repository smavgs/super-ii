---
import '@fontsource-variable/source-sans-3';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { openGraphLocale } from '@/lib/i18n';
import { absoluteUrl, site } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  noindex?: boolean;
  className?: string;
  titleNoTranslate?: boolean;
  descriptionNoTranslate?: boolean;
}

const locale = Astro.locals.locale ?? 'en';
const defaultSocialCards = {
  en: {
    image: '/brand/super-ii-social-card.png',
    alt: 'Super ii — Open intelligence, built together. Run your first AI agent with free cloud AI.',
    width: 1200,
    height: 630,
  },
  ru: {
      image: '/brand/super-ii-social-card-ru.png',
      alt: 'Подключите своего ИИ-агента к Super ii — публичный поиск в интернете и безопасная работа с разрешёнными репозиториями.',
      width: 1698,
      height: 952,
  },
  'zh-CN': {
    image: '/brand/super-ii-social-card-zh-cn.png',
    alt: 'Super ii — 开放智能，共同构建。发现、理解、运行并分享 AI 作品。',
    width: 1200,
    height: 630,
  },
} as const;
const defaultSocialCard = defaultSocialCards[locale];

const {
  title,
  description = site.brand.description,
  image: requestedImage = defaultSocialCard.image,
  imageAlt: requestedImageAlt = defaultSocialCard.alt,
  imageWidth: requestedImageWidth = defaultSocialCard.width,
  imageHeight: requestedImageHeight = defaultSocialCard.height,
  imageType: requestedImageType = 'image/png',
  noindex = false,
  className = '',
  titleNoTranslate = false,
  descriptionNoTranslate = false,
} = Astro.props;

// The Simplified Chinese edition intentionally uses one consistent, localized
// share card across every human-facing page, including pages with a bespoke
// English social image.
const image = locale === 'zh-CN' ? defaultSocialCard.image : requestedImage;
const imageAlt = locale === 'zh-CN' ? defaultSocialCard.alt : requestedImageAlt;
const imageWidth = locale === 'zh-CN' ? defaultSocialCard.width : requestedImageWidth;
const imageHeight = locale === 'zh-CN' ? defaultSocialCard.height : requestedImageHeight;
const imageType = locale === 'zh-CN' ? 'image/png' : requestedImageType;

const pageTitle = title ? `${title} · ${site.brand.name}` : `${site.brand.name} · ${site.brand.tagline}`;
const canonical = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);
const imageWidthContent = String(imageWidth);
const imageHeightContent = String(imageHeight);
---

<!doctype html>
<html lang={locale} data-theme="light" data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} data-no-translate={descriptionNoTranslate ? '' : undefined} />
    <meta name="theme-color" content="#ffd21e" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={openGraphLocale(locale)} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={pageTitle} data-no-translate={titleNoTranslate ? '' : undefined} />
    <meta property="og:description" content={description} data-no-translate={descriptionNoTranslate ? '' : undefined} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={imageWidthContent} />
    <meta property="og:image:height" content={imageHeightContent} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} data-no-translate={titleNoTranslate ? '' : undefined} />
    <meta name="twitter:description" content={description} data-no-translate={descriptionNoTranslate ? '' : undefined} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title data-no-translate={titleNoTranslate ? '' : undefined}>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('superii-theme');
          const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
    {locale !== 'en' && (
      <script>
        import '@/scripts/clerk-locale';
      </script>
    )}
  </head>
  <body class={className}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/scripts/site.js" defer></script>
    {locale === 'ru' && <script is:inline src="/scripts/localize-ru.js" defer></script>}
    {locale === 'zh-CN' && <script is:inline src="/scripts/localize-zh-cn.js" defer></script>}
  </body>
</html>
