---
import PageHero from '@/components/PageHero.astro';
import InfoTip from '@/components/InfoTip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';
import type { InfoHelpKey } from '@/lib/info-help';
import { checkoutPriceCents } from '@/lib/nowpayments';
import { plans } from '@/lib/site';

let signedIn = false;
let teamOrganizations: Array<{ id: string; handle: string; name: string; member_count: number }> = [];
const sql = sqlClient(Astro.locals);
if (sql) {
  try {
    const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
    signedIn = Boolean(profile);
    if (profile) {
      teamOrganizations = await sql`
        select o.id, o.handle, coalesce(o.full_name, o.name) as name,
               count(all_members.profile_id)::integer as member_count
        from app.organization_members manager
        join app.organizations o on o.id = manager.organization_id
        left join app.organization_members all_members on all_members.organization_id = o.id
        where manager.profile_id = ${profile.profileId}::uuid
          and manager.role in ('owner', 'admin')
        group by o.id, o.handle, o.full_name, o.name
        order by o.handle
      ` as typeof teamOrganizations;
    }
  } catch {
    signedIn = false;
    teamOrganizations = [];
  }
}

const planCta = {
  free: { label: 'Join free', href: '/sign-up', featured: false },
  pro: { label: 'Pay with USDC', href: null, featured: true },
  team: { label: 'Pay with USDC', href: null, featured: false },
  enterprise: { label: 'Request a proposal', href: '/contact?interest=enterprise', featured: false },
} as const;

const featureHelp: Partial<Record<string, InfoHelpKey>> = {
  'Unlimited public repositories': 'unlimitedPublicRepositories',
  '5 GB public storage': 'storage',
  'Browser WebGPU and WASM execution': 'browserWebgpu',
  'Basic Verified Use': 'verifiedUse',
  '25 GB total hosted storage': 'hostedStorage25',
  'Advanced Verified Use': 'verifiedUse',
  'Scoped agent tokens': 'scopedAccess',
  'Scoped team tokens': 'scopedAccess',
  '50 GB pooled storage per paid member': 'pooledStorage',
  'SSO available as an add-on': 'ssoAddOn',
  'Customer-supplied cloud or hardware': 'customerSuppliedInfrastructure',
};

const displayUsd = (cents: number) => {
  const dollars = cents / 100;
  return `$${Number.isInteger(dollars) ? dollars.toFixed(0) : dollars.toFixed(2)}`;
};

const comparison: Array<{ feature: string; values: string[]; helpTerm?: InfoHelpKey }> = [
  { feature: 'Public repositories', values: ['Unlimited', 'Unlimited', 'Unlimited', 'Unlimited'], helpTerm: 'unlimitedPublicRepositories' },
  { feature: 'Private repositories', values: ['—', 'Included', 'Included', 'Included'] },
  { feature: 'Included hosted storage', values: ['5 GB public', '25 GB', '50 GB/member pooled', 'Custom'], helpTerm: 'storage' },
  { feature: 'Browser / local execution', values: ['Included', 'Included', 'Included', 'Included'], helpTerm: 'browserLocalExecution' },
  { feature: 'Hardware matching', values: ['Basic', 'Advanced', 'Advanced', 'Custom'] },
  { feature: 'Verified Use', values: ['Basic', 'Advanced', 'Advanced', 'Custom'], helpTerm: 'verifiedUse' },
  { feature: 'Notebooks', values: ['Public', 'Public + private', 'Shared + private', 'Governed'] },
  { feature: 'MCP / API access', values: ['Basic', 'Advanced', 'Team', 'Enterprise'] },
  { feature: 'Agent access', values: ['Basic', 'Advanced', 'Team', 'Enterprise'] },
  { feature: 'Web search', values: ['3/day', '30/day', '60/member/day', 'Custom'] },
  { feature: 'Profile badge', values: ['—', 'Pro · coming soon', 'Team · coming soon', 'Enterprise · coming soon'] },
  { feature: 'Advanced publishing', values: ['—', 'Included', 'Included', 'Policy controlled'] },
  { feature: 'Processing priority', values: ['Community', 'Priority', 'Higher priority', 'SLA'] },
  { feature: 'Organizations', values: ['Included', 'Included', 'Included', 'Included'] },
  { feature: 'Role-based access', values: ['—', '—', 'Advanced', 'Custom'] },
  { feature: 'Audit history', values: ['—', '—', 'Included', 'Extended'] },
  { feature: 'Service accounts', values: ['—', '—', 'Included', 'Included'] },
  { feature: 'SSO', values: ['—', '—', 'Add-on', 'Included'] },
  { feature: 'SCIM', values: ['—', '—', '—', 'Included'] },
  { feature: 'Dedicated runtime', values: ['—', '—', 'Optional', 'Available'] },
  { feature: 'BYOC / BYO hardware', values: ['Local', 'Supported', 'Supported', 'Major feature'], helpTerm: 'byocHardware' },
  { feature: 'Additional storage', values: ['Usage based', 'Usage based', 'Usage based', 'Negotiated'] },
  { feature: 'Hosted notebook execution', values: ['Usage based', 'Usage based', 'Usage based', 'BYOC / negotiated'], helpTerm: 'usageInfrastructure' },
  { feature: 'Hosted app runtime', values: ['Usage based', 'Usage based', 'Usage based', 'BYOC / negotiated'], helpTerm: 'usageInfrastructure' },
  { feature: 'Managed inference / GPU', values: ['Usage based', 'Usage based', 'Usage based', 'BYOC / negotiated'], helpTerm: 'usageInfrastructure' },
  { feature: 'Support', values: ['Community', 'Standard', 'Priority', 'Custom'] },
];
---

<BaseLayout title="Pricing" description="Start free with Super ii, then pay for privacy, control and scale when you need them.">
  <PageHero
    eyebrow="Simple, transparent plans"
    title="Start free. Pay for privacy, control and scale."
    description="Explore, publish and run open AI for free. Upgrade when you need private work, larger storage, advanced agent access, team governance or enterprise control."
  >
    <div class="pricing-notice">
      <i class="ph ph-info" aria-hidden="true"></i>
      <p><strong>Choose 30 days or prepay 12 months with 20% off. Both are one-time USDC payments with no automatic renewal.</strong> <InfoTip term="prepaidAccess" /></p>
    </div>
  </PageHero>

  <section class="shell pricing-intro" aria-labelledby="plans-heading">
    <h2 class="sr-only" id="plans-heading">Plans</h2>
    <div class="billing-term-control">
      <div>
        <p class="eyebrow">Access length</p>
        <strong>Choose once. Renew only when you want.</strong>
        <p data-billing-term-note aria-live="polite">One payment gives 30 days of access.</p>
      </div>
      <fieldset data-billing-term-picker>
        <legend class="sr-only">Choose paid-plan access length</legend>
        <label class="billing-term-option">
          <input type="radio" name="billing-term-choice" value="30_days" checked />
          <span><strong>30 days</strong><small>Standard price</small></span>
        </label>
        <label class="billing-term-option billing-term-option--annual">
          <input type="radio" name="billing-term-choice" value="12_months" />
          <span><strong>12 months</strong><small>Save 20%</small></span>
        </label>
      </fieldset>
    </div>
    <div class="pricing-grid">
      {plans.map((plan) => {
        const cta = planCta[plan.id as keyof typeof planCta];
        const paidPlanId = plan.id === 'pro' || plan.id === 'team' ? plan.id : null;
        const monthlyUnitCents = paidPlanId ? checkoutPriceCents(paidPlanId, 1, '30_days') : null;
        const annualUnitCents = paidPlanId ? checkoutPriceCents(paidPlanId, 1, '12_months') : null;
        const defaultSeats = plan.id === 'team' ? Math.max(2, teamOrganizations[0]?.member_count ?? 1) : 1;
        return (
          <article class:list={['price-card', cta.featured && 'price-card--featured']}>
            <h2>{plan.name}</h2>
            <p class="price-card__summary">{plan.summary}</p>
            <div
              class="price"
              data-paid-price={paidPlanId ?? undefined}
              data-monthly-price={monthlyUnitCents === null ? undefined : displayUsd(monthlyUnitCents)}
              data-annual-price={annualUnitCents === null ? undefined : displayUsd(annualUnitCents)}
              data-monthly-unit={paidPlanId === 'team' ? '/ member / 30 days' : paidPlanId === 'pro' ? '/ 30 days' : undefined}
              data-annual-unit={paidPlanId === 'team' ? '/ member / 12 months' : paidPlanId === 'pro' ? '/ 12 months' : undefined}
              aria-live={paidPlanId ? 'polite' : undefined}
            >
              <strong data-price-value={paidPlanId ? true : undefined}>{plan.price}</strong>
              <span data-price-unit={paidPlanId ? true : undefined}>{plan.unit}</span>
            </div>
            <ul>
              {plan.features.map((feature) => {
                const helpTerm = featureHelp[feature];
                return <li><i class="ph ph-check" aria-hidden="true"></i><span>{feature}</span>{helpTerm && <InfoTip term={helpTerm} />}</li>;
              })}
            </ul>
            {cta.href ? (
              <a class:list={['button', cta.featured ? 'button--dark' : 'button--secondary']} href={cta.href}>{cta.label}</a>
            ) : (
              <form
                class="plan-checkout"
                data-plan-checkout
                data-plan-id={plan.id}
                data-monthly-unit-cents={monthlyUnitCents}
                data-annual-unit-cents={annualUnitCents}
              >
                <input type="hidden" name="billing_term" value="30_days" data-billing-term-field />
                {plan.id === 'team' && signedIn && teamOrganizations.length > 0 && <label>Organization <select name="organization_id" required>{teamOrganizations.map((organization) => <option value={organization.id}>{organization.name} · @{organization.handle}</option>)}</select></label>}
                {plan.id === 'team' && <label>Seats <input name="seat_count" type="number" min="1" max="100" value={String(defaultSeats)} required /></label>}
                {plan.id === 'team' && signedIn && teamOrganizations.length === 0 && <span>Create an organization before activating Team. <a href="/organizations/new">Create one</a></span>}
                <button class:list={['button', cta.featured ? 'button--dark' : 'button--secondary']} type="submit" disabled={plan.id === 'team' && signedIn && teamOrganizations.length === 0}>{cta.label}</button>
                <span data-checkout-summary>USDC · Ethereum · {displayUsd((monthlyUnitCents ?? 0) * defaultSeats)} total{defaultSeats > 1 ? ` for ${defaultSeats} seats` : ''} · 30 days</span>
                <p data-form-status aria-live="polite"></p>
              </form>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="pricing-detail section--soft">
    <div class="shell">
      <div class="section-heading">
        <h2>Compare plans</h2>
      </div>

      <div class="comparison-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Free</th>
              <th scope="col">Pro</th>
              <th scope="col">Team</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature} {row.helpTerm && <InfoTip term={row.helpTerm} />}</th>
                {row.values.map((value) => <td>{value}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell feature-rows">
      <article class="feature-row">
        <h2>Use your own hardware when you want</h2>
        <div>
          <p>Running compatible models on your own computer or infrastructure does not use paid Super ii compute. <InfoTip term="browserLocalExecution" /></p>
        </div>
      </article>

      <article class="feature-row">
        <h2>Pay only for hosted resources you choose</h2>
        <div>
          <p>Additional storage, hosted compute and other infrastructure are priced separately from your plan.</p>
          <p>Before you use a paid resource, Super ii shows the price, what is included, your usage and your spending controls. <InfoTip term="usageInfrastructure" label="Usage based" /></p>
        </div>
      </article>

      <article class="feature-row">
        <h2>Bring your own infrastructure</h2>
        <div>
          <p>Use your own computer, GPU server or cloud infrastructure while Super ii manages the workspace around your AI work. <InfoTip term="byocHardware" /></p>
        </div>
      </article>

      <article class="feature-row">
        <h2>Storage that scales with your work</h2>
        <div>
          <p>Every plan includes a clear hosted-storage allowance.</p>
          <ul>
            <li><i class="ph ph-check" aria-hidden="true"></i>Free: 5 GB public</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Pro: 25 GB</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Team: 50 GB per paid member, pooled</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Enterprise: custom</li>
          </ul>
          <p>Additional storage is available separately.</p>
          <p>Repository count and storage capacity are different: you can create unlimited public repositories while staying within your storage allowance. <InfoTip term="storage" /></p>
        </div>
      </article>

      <article class="feature-row">
        <h2>Need Enterprise?</h2>
        <div>
          <p>If you need custom identity, deployment, security, support or infrastructure, we can define them in a written proposal.</p>
          <a class="button button--secondary" href="/enterprise">Explore Enterprise</a>
        </div>
      </article>

      <article class="feature-row">
        <h2>Payment</h2>
        <div>
          <p>Pro and Team are activated with USDC on Ethereum.</p>
          <ul>
            {['No card required', 'Choose 30 days or 12 months', 'Save 20% when you prepay 12 months', 'No automatic renewal', 'Network and processor fees may apply', 'Your plan and infrastructure usage remain separate'].map((item) => <li><i class="ph ph-check" aria-hidden="true"></i>{item}</li>)}
          </ul>
          <p><InfoTip term="usdcEthereum" /></p>
        </div>
      </article>

    </div>
  </section>
</BaseLayout>

<script>
  type BillingTerm = '30_days' | '12_months';

  const termInputs = document.querySelectorAll<HTMLInputElement>('[name="billing-term-choice"]');
  const termNote = document.querySelector<HTMLElement>('[data-billing-term-note]');
  const paidPrices = document.querySelectorAll<HTMLElement>('[data-paid-price]');
  const checkoutForms = document.querySelectorAll<HTMLFormElement>('[data-plan-checkout]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const selectedTerm = (): BillingTerm => {
    const selected = document.querySelector<HTMLInputElement>('[name="billing-term-choice"]:checked')?.value;
    return selected === '12_months' ? '12_months' : '30_days';
  };

  const formatUsd = (cents: number) => {
    const dollars = cents / 100;
    return `$${Number.isInteger(dollars) ? dollars.toFixed(0) : dollars.toFixed(2)}`;
  };

  const updateCheckoutSummary = (form: HTMLFormElement, term: BillingTerm) => {
    const seatsInput = form.querySelector<HTMLInputElement>('[name="seat_count"]');
    const seats = Math.max(1, Number(seatsInput?.value ?? 1) || 1);
    const unitCents = Number(term === '12_months'
      ? form.dataset.annualUnitCents
      : form.dataset.monthlyUnitCents);
    const summary = form.querySelector<HTMLElement>('[data-checkout-summary]');
    if (summary) {
      summary.textContent = `USDC · Ethereum · ${formatUsd(unitCents * seats)} total${seats > 1 ? ` for ${seats} seats` : ''} · ${term === '12_months' ? '12 months' : '30 days'}`;
    }
  };

  const applyTerm = (term: BillingTerm) => {
    if (termNote) {
      termNote.textContent = term === '12_months'
        ? 'One payment gives 12 months of access with 20% off. No automatic renewal.'
        : 'One payment gives 30 days of access. No automatic renewal.';
    }
    paidPrices.forEach((price) => {
      const value = price.querySelector<HTMLElement>('[data-price-value]');
      const unit = price.querySelector<HTMLElement>('[data-price-unit]');
      if (value) value.textContent = term === '12_months' ? price.dataset.annualPrice ?? '' : price.dataset.monthlyPrice ?? '';
      if (unit) unit.textContent = term === '12_months' ? price.dataset.annualUnit ?? '' : price.dataset.monthlyUnit ?? '';
      if (!prefersReducedMotion) {
        price.animate(
          [{ opacity: 0.68, transform: 'translateY(2px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 180, easing: 'ease-out' },
        );
      }
    });
    checkoutForms.forEach((form) => {
      const field = form.querySelector<HTMLInputElement>('[data-billing-term-field]');
      if (field) field.value = term;
      updateCheckoutSummary(form, term);
    });
  };

  termInputs.forEach((input) => input.addEventListener('change', () => applyTerm(selectedTerm())));
  checkoutForms.forEach((form) => {
    form.querySelector<HTMLInputElement>('[name="seat_count"]')?.addEventListener('input', () => {
      updateCheckoutSummary(form, selectedTerm());
    });
  });

  document.querySelectorAll('[data-plan-checkout]').forEach((candidate) => {
    candidate.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(candidate instanceof HTMLFormElement)) return;
      const planId = candidate.dataset.planId;
      const status = candidate.querySelector('[data-form-status]');
      const submit = candidate.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      try {
        const values = new FormData(candidate);
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            plan_id: planId,
            billing_term: values.get('billing_term'),
            seat_count: Number(values.get('seat_count') ?? 1),
            organization_id: values.get('organization_id') || null,
          }),
        });
        const data = await response.json() as Record<string, unknown>;
        if (response.status === 401) {
          location.assign(`/sign-in?redirect_url=${encodeURIComponent(location.pathname)}`);
          return;
        }
        if (!response.ok || typeof data.href !== 'string') {
          throw new Error(typeof data.error === 'string' ? data.error : 'Checkout could not be created.');
        }
        if (status instanceof HTMLElement) status.textContent = 'Secure payment created. Opening checkout…';
        location.assign(data.href);
      } catch (error) {
        if (status instanceof HTMLElement) {
          status.textContent = error instanceof Error ? error.message : 'Checkout could not be created.';
          status.dataset.state = 'error';
        }
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  });
</script>
