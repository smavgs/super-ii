---
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';
import { plans } from '@/lib/site';

let signedIn = false;
let teamOrganizations: Array<{ id: string; handle: string; name: string; member_count: number }> = [];
const sql = sqlClient(Astro.locals);
if (sql) {
  try {
    const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
    signedIn = Boolean(profile);
    if (profile) {
      teamOrganizations = await sql`
        select o.id, o.handle, coalesce(o.full_name, o.name) as name,
               count(all_members.profile_id)::integer as member_count
        from app.organization_members manager
        join app.organizations o on o.id = manager.organization_id
        left join app.organization_members all_members on all_members.organization_id = o.id
        where manager.profile_id = ${profile.profileId}::uuid
          and manager.role in ('owner', 'admin')
        group by o.id, o.handle, o.full_name, o.name
        order by o.handle
      ` as typeof teamOrganizations;
    }
  } catch {
    signedIn = false;
    teamOrganizations = [];
  }
}

const planCta = {
  free: { label: 'Join free', href: '/sign-up', featured: false },
  pro: { label: 'Pay with USDC', href: null, featured: true },
  team: { label: 'Pay with USDC', href: null, featured: false },
  enterprise: { label: 'Request a proposal', href: '/contact?interest=enterprise', featured: false },
} as const;

const comparison = [
  { feature: 'Public repositories', values: ['Unlimited', 'Unlimited', 'Unlimited', 'Unlimited'] },
  { feature: 'Private repositories', values: ['—', 'Included', 'Included', 'Custom'] },
  { feature: 'Organization members', values: ['Community', 'Small teams', 'Per seat', 'Custom'] },
  { feature: 'Role-based access', values: ['—', 'Basic', 'Advanced', 'Custom'] },
  { feature: 'Audit history', values: ['—', '—', 'Included', 'Extended'] },
  { feature: 'SSO and directory sync', values: ['—', '—', 'Option', 'Proposal'] },
  { feature: 'Storage and compute', values: ['Community limits', 'Higher limits', 'Pooled limits', 'Negotiated'] },
  { feature: 'Support', values: ['Community', 'Standard', 'Priority', 'Custom plan'] },
];
---

<BaseLayout title="Pricing" description="Transparent Super ii plans for individuals, teams, and enterprises—with a real free tier and no card required to start.">
  <PageHero
    eyebrow="Simple, transparent plans"
    title="Start in public for free. Pay when control and scale matter."
    description="Free accounts are open now. Pro and Team activate for 30 days after a verified USDC payment on Ethereum; Enterprise remains a written proposal."
  >
    <div class="pricing-notice">
      <i class="ph ph-info" aria-hidden="true"></i>
      <p><strong>Crypto-only launch:</strong> no card is required. Pro and Team use a single USDC payment on Ethereum through NOWPayments; network and processor fees may apply.</p>
    </div>
  </PageHero>

  <section class="shell pricing-intro" aria-labelledby="plans-heading">
    <h2 class="sr-only" id="plans-heading">Plans</h2>
    <div class="pricing-grid">
      {plans.map((plan) => {
        const cta = planCta[plan.id as keyof typeof planCta];
        return (
          <article class:list={['price-card', cta.featured && 'price-card--featured']}>
            {plan.status === 'available' && <span class="price-badge">Available now</span>}
            {plan.status === 'beta-waitlist' && <span class="price-badge">Beta waitlist</span>}
            {plan.status === 'proposal' && <span class="price-badge">By proposal</span>}
            <h2>{plan.name}</h2>
            <p class="price-card__summary">{plan.summary}</p>
            <div class="price">
              <strong>{plan.price}</strong>
              <span>{plan.unit}</span>
            </div>
            <ul>
              {plan.features.map((feature) => (
                <li><i class="ph ph-check" aria-hidden="true"></i>{feature}</li>
              ))}
            </ul>
            {cta.href ? (
              <a class:list={['button', cta.featured ? 'button--dark' : 'button--secondary']} href={cta.href}>{cta.label}</a>
            ) : (
              <form class="plan-checkout" data-plan-checkout data-plan-id={plan.id}>
                {plan.id === 'team' && signedIn && teamOrganizations.length > 0 && <label>Organization <select name="organization_id" required>{teamOrganizations.map((organization) => <option value={organization.id}>{organization.name} · @{organization.handle}</option>)}</select></label>}
                {plan.id === 'team' && <label>Seats <input name="seat_count" type="number" min="1" max="100" value={String(Math.max(2, teamOrganizations[0]?.member_count ?? 1))} required /></label>}
                {plan.id === 'team' && signedIn && teamOrganizations.length === 0 && <span>Create an organization before activating Team. <a href="/organizations/new">Create one</a></span>}
                <button class:list={['button', cta.featured ? 'button--dark' : 'button--secondary']} type="submit" disabled={plan.id === 'team' && signedIn && teamOrganizations.length === 0}>{cta.label}</button>
                <span>USDC · Ethereum · 30 days</span>
                <p data-form-status aria-live="polite"></p>
              </form>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="pricing-detail section--soft">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Plan coverage</p>
        <h2>A full path from first project to governed AI.</h2>
        <p>Paid activation is manual-renewal for 30 days. Enterprise capabilities are scoped in writing and never implied by a badge alone.</p>
      </div>

      <div class="comparison-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Free</th>
              <th scope="col">Pro</th>
              <th scope="col">Team</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                {row.values.map((value) => <td>{value}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell feature-rows">
      <article class="feature-row">
        <h2>Usage-based infrastructure</h2>
        <div>
          <p>Inference, hosted endpoints, accelerated app runtime, and storage are separate from subscriptions. When released, each service will show its unit price, included allowance, and spend controls before use.</p>
          <ul>
            <li><i class="ph ph-check" aria-hidden="true"></i> No surprise activation</li>
            <li><i class="ph ph-check" aria-hidden="true"></i> Usage visibility and budget controls</li>
            <li><i class="ph ph-check" aria-hidden="true"></i> Customer-supplied infrastructure proposals for larger workloads</li>
          </ul>
        </div>
      </article>
      <article class="feature-row">
        <h2>Creator monetization</h2>
        <div>
          <p>Creator programs, paid apps, compute sponsorship, and revenue-sharing are planned surfaces—not active promises. Terms, fees, eligibility, and payout mechanics will be published before enrollment.</p>
        </div>
      </article>
      <article class="feature-row">
        <h2>Enterprise proposals</h2>
        <div>
          <p>Organizations can request a written proposal covering access controls, identity, support, regional requirements, deployment architecture, and commercial terms.</p>
          <a class="button button--secondary" href="/enterprise">Explore enterprise</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('[data-plan-checkout]').forEach((candidate) => {
    candidate.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(candidate instanceof HTMLFormElement)) return;
      const planId = candidate.dataset.planId;
      const status = candidate.querySelector('[data-form-status]');
      const submit = candidate.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      try {
        const values = new FormData(candidate);
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            plan_id: planId,
            seat_count: Number(values.get('seat_count') ?? 1),
            organization_id: values.get('organization_id') || null,
          }),
        });
        const data = await response.json() as Record<string, unknown>;
        if (response.status === 401) {
          location.assign(`/sign-in?redirect_url=${encodeURIComponent(location.pathname)}`);
          return;
        }
        if (!response.ok || typeof data.href !== 'string') {
          throw new Error(typeof data.error === 'string' ? data.error : 'Checkout could not be created.');
        }
        if (status instanceof HTMLElement) status.textContent = 'Secure payment created. Opening checkout…';
        location.assign(data.href);
      } catch (error) {
        if (status instanceof HTMLElement) {
          status.textContent = error instanceof Error ? error.message : 'Checkout could not be created.';
          status.dataset.state = 'error';
        }
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  });
</script>
