---
import Catalog from '@/components/Catalog.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

---

<BaseLayout title="Datasets" description="Discover documented public datasets on Super ii, with licenses, schemas, previews, and version history.">
  <PageHero
    eyebrow="Documented data"
    title="Datasets"
    titleHelp="dataset"
    description="Find and publish datasets with the information needed to understand and reuse them responsibly. See the license, schema, preview, provenance, lineage and version history in one place."
    compact
  />
  <Catalog kind="datasets" />
</BaseLayout>
