---
import Catalog from '@/components/Catalog.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

---

<BaseLayout title="Datasets" description="Discover documented public datasets on Super ii, with licenses, schemas, previews, and version history.">
  <PageHero
    eyebrow="Documented data"
    title="Datasets"
    titleHelp="dataset"
    description="Find and publish data with the information needed to understand and reuse it responsibly. License · schema · preview · provenance · lineage · versions."
    compact
  />
  <Catalog kind="datasets" />
</BaseLayout>
