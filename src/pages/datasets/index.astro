---
import EmptyCatalog from '@/components/EmptyCatalog.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="Datasets" description="Discover documented public datasets on Super ii, with licenses, schemas, previews, and version history.">
  <PageHero
    eyebrow="Documented data"
    title="Datasets"
    description="Share data with the licenses, schemas, previews, lineage, and context others need to use it responsibly."
    compact
  />
  <EmptyCatalog kind="datasets" />
</BaseLayout>
