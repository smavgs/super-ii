---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { isPlatformAdmin } from '@/lib/creator';
import { sqlClient } from '@/lib/db';
type ReviewItem = { revision_id: string; repository_id: string; owner_handle: string; slug: string; title: string; kind: string; sequence: number; manifest_sha256: string; file_count: number; total_size_bytes: string; submitted_at: string; analyses: unknown; files: unknown };
const sql = sqlClient(Astro.locals); let reviewer = false; let queue: ReviewItem[] = [];
if (sql) { try { const profile = await ensureAuthenticatedProfile(Astro.locals, sql); reviewer = Boolean(profile && isPlatformAdmin(Astro.locals, profile.clerkUserId)); if (reviewer) queue = await sql`select rr.id as revision_id, r.id as repository_id, r.owner_handle, r.slug, r.title, r.kind, rr.sequence, rr.manifest_sha256, rr.file_count, rr.total_size_bytes, rr.updated_at as submitted_at, coalesce((select jsonb_agg(jsonb_build_object('type', analysis.analysis_type, 'status', analysis.status, 'result', analysis.result)) from app.repository_revision_analyses analysis where analysis.revision_id = rr.id), '[]'::jsonb) as analyses, coalesce((select jsonb_agg(jsonb_build_object('path', file.path, 'sha256', file.sha256, 'size_bytes', file.size_bytes, 'scan_status', file.scan_status) order by file.path) from app.repository_files file where file.revision_id = rr.id), '[]'::jsonb) as files from app.repository_revisions rr join app.repositories r on r.id = rr.repository_id where rr.status = 'review' order by rr.updated_at asc limit 100` as ReviewItem[]; } catch { queue = []; } }
if (!reviewer) Astro.response.status = 403;
---
<BaseLayout title="Review queue" description="Human publication review for Super ii repository revisions." noindex>
  {reviewer ? <><PageHero eyebrow="Human review gate 🛡️" title="Publication queue" description="Verify the sealed manifest, automated inspection evidence, documentation, license, and responsible-use context before a public release." compact /><main class="section shell review-queue">{queue.length ? queue.map((item) => <article class="review-card" data-review-card data-revision-id={item.revision_id}><div class="repository-section__heading"><div><p class="eyebrow">{item.kind} · revision {item.sequence}</p><h2>{item.title}</h2><p>{item.owner_handle}/{item.slug}</p></div><span>{item.file_count} files · {Number(item.total_size_bytes).toLocaleString()} B</span></div><p><strong>Manifest:</strong> <code>{item.manifest_sha256}</code></p><details><summary>File manifest</summary><pre>{JSON.stringify(item.files, null, 2)}</pre></details><details><summary>Analysis evidence</summary><pre>{JSON.stringify(item.analyses, null, 2)}</pre></details><label>Reviewer notes <textarea maxlength="20000" data-review-notes></textarea></label><div class="form-actions"><button class="button button--dark" type="button" data-review-decision="approved">Approve and publish</button><button class="button button--secondary" type="button" data-review-decision="rejected">Request changes</button></div><p class="form-status" data-form-status aria-live="polite"></p></article>) : <div class="empty-state"><h2>Review queue is clear ✅</h2><p>There are no revisions waiting for a human decision.</p></div>}</main></> : <main class="section shell"><div class="empty-state"><h1>Reviewer access required</h1><p>This page is restricted to configured Super ii reviewers.</p><a class="button button--secondary" href="/account">Back to account</a></div></main>}
</BaseLayout>
<script>
  document.querySelectorAll('[data-review-card]').forEach((card) => { card.querySelectorAll('[data-review-decision]').forEach((button) => { button.addEventListener('click', async () => { if (!(card instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return; const revisionId = card.dataset.revisionId; const notes = card.querySelector('[data-review-notes]'); const status = card.querySelector('[data-form-status]'); card.querySelectorAll('button').forEach((value) => { if (value instanceof HTMLButtonElement) value.disabled = true; }); try { const response = await fetch(`/api/reviews/${revisionId}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ decision: button.dataset.reviewDecision, notes: notes instanceof HTMLTextAreaElement ? notes.value : '' }) }); const data = await response.json() as Record<string, unknown>; if (!response.ok) throw new Error(typeof data.error === 'string' ? data.error : 'Review failed.'); card.remove(); } catch (error) { if (status instanceof HTMLElement) { status.textContent = error instanceof Error ? error.message : 'Review failed.'; status.dataset.state = 'error'; } card.querySelectorAll('button').forEach((value) => { if (value instanceof HTMLButtonElement) value.disabled = false; }); } }); }); });
</script>
