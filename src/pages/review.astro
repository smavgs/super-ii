---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { isPlatformAdmin } from '@/lib/creator';
import { sqlClient } from '@/lib/db';
const sql = sqlClient(Astro.locals);
let allowed = false;
let decisions: Array<{ revision_id: string; outcome: string; policy_version: string; manifest_sha256: string; reasons: unknown; created_at: string }> = [];
if (sql) {
  try {
    const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
    allowed = Boolean(profile && isPlatformAdmin(Astro.locals, profile.clerkUserId));
    if (allowed) decisions = await sql`
      select revision_id, outcome, policy_version, manifest_sha256, reasons, created_at
      from app.publication_decisions order by created_at desc limit 100
    ` as typeof decisions;
  } catch { Astro.response.status = 503; }
}
if (!allowed) Astro.response.status = 403;
---
<BaseLayout title="Publication decisions" description="Automatic publication policy evidence for Super ii." noindex>
  <PageHero eyebrow="Publication evidence" title="Automatic policy decisions" description="Passing releases publish automatically. Failed or unknown checks stay closed with actionable reasons." compact />
  <main class="section shell review-queue">
    {allowed ? decisions.length ? decisions.map((item) => <article class="review-card"><h2>{item.outcome}</h2><p>{item.policy_version} · {item.created_at}</p><p>Revision <code>{item.revision_id}</code></p><p>Manifest <code>{item.manifest_sha256}</code></p><pre>{JSON.stringify(item.reasons, null, 2)}</pre></article>) : <p>No automatic publication decisions yet.</p> : <p>Operator access is required to view this evidence.</p>}
  </main>
</BaseLayout>
