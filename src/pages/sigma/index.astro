---
import CommunicationsLayout from "@/layouts/CommunicationsLayout.astro";
import SigmaMascot from "@/components/SigmaMascot.astro";
import SigmaActions from "@/components/SigmaActions.astro";
import { sqlClient } from "@/lib/db";
import { sigmaPage, type SigmaStory, type SigmaEngagement } from "@/lib/sigma";
import { sigmaCopy } from "@/lib/sigma-copy";
import { sigmaCategories, sigmaTranslation } from "@/lib/sigma-input";
import { dateLocale } from "@/lib/i18n";
import "@/styles/sigma.css";
const locale = Astro.locals.locale ?? "en";
const c = sigmaCopy(locale);
const view =
  Astro.url.searchParams.get("view") === "papers" ? "papers" : "news";
const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 200);
const requestedTopic = Astro.url.searchParams.get("topic") ?? "";
const topic = view === "news" && sigmaCategories.some((value) => value === requestedTopic) ? requestedTopic : "";
let page = Math.min(
  1_000_000,
  Math.max(
    0,
    Number.parseInt(Astro.url.searchParams.get("page") ?? "0", 10) || 0,
  ),
);
const size = 3;
const sql = sqlClient(Astro.locals);
type Paper = {
  title: string;
  summary: string;
  owner: string;
  owner_name: string;
  slug: string;
  published_at: string;
};
let stories: (SigmaStory & SigmaEngagement)[] = [];
let papers: Paper[] = [];
let total = 0;
let unavailable = !sql;
if (sql)
  try {
    if (view === "news") {
      const result = await sigmaPage(sql, query, topic, page, size);
      stories = result.stories;
      total = Number(result.total);
      page = Number(result.page);
    } else {
      const counts = await sql`select count(*) as total from app.papers p join app.profiles profile on profile.id=p.owner_profile_id and profile.is_public where p.is_public and (${query}='' or position(lower(${query}) in lower(p.title||' '||p.abstract||' '||profile.handle))>0)`;
      total = Number(counts[0].total);
      page = Math.min(page, Math.max(0, Math.ceil(total / size) - 1));
      papers =
        (await sql`select p.title,p.abstract as summary,profile.handle as owner,profile.display_name as owner_name,p.slug,coalesce(p.published_on::timestamptz,p.created_at) as published_at from app.papers p join app.profiles profile on profile.id=p.owner_profile_id and profile.is_public where p.is_public and (${query}='' or position(lower(${query}) in lower(p.title||' '||p.abstract||' '||profile.handle))>0) order by coalesce(p.published_on::timestamptz,p.created_at) desc,p.id limit ${size} offset ${page * size}`) as Paper[];
    }
  } catch {
    unavailable = true;
  }
const totalPages = Math.ceil(total / size);
const pageLabel = c.pageOf.replace("{page}", String(page + 1)).replace("{pages}", String(totalPages));
const pageNumbers: (number | "gap")[] = totalPages <= 5
  ? Array.from({ length: totalPages }, (_, index) => index)
  : page <= 2 ? [0, 1, 2, "gap", totalPages - 1]
  : page >= totalPages - 3 ? [0, "gap", totalPages - 3, totalPages - 2, totalPages - 1]
  : [0, "gap", page, "gap", totalPages - 1];
const href = (target: number) =>
  `/sigma?${new URLSearchParams({ view, q: query, ...(topic ? { topic } : {}), page: String(target) })}`;
Astro.response.headers.set("cache-control", "private, no-store");
---

<CommunicationsLayout
  active="sigma"
  title="Sigma News"
  description={c.tagline}
  descriptionNoTranslate
  className="sigma-page"
>
  <div data-no-translate>
    <header class="shell sigma-heading">
      <SigmaMascot
        edition={page === 0 && !query ? stories[0]?.published_at : undefined}
      /><div class="sigma-heading-copy">
        <h1>Sigma News</h1><p>{c.tagline}</p>
      </div><a class="button button--secondary" href="/sigma/editor" aria-label={c.contribute}
        ><i class="ph ph-pencil-line" aria-hidden="true"></i><span class="sigma-contribute-full">{c.contribute}</span><span class="sigma-contribute-short">{c.writeShort}</span></a>
    </header>
    <div class="shell">
      <div class="sigma-controls">
        <nav class="sigma-tabs" aria-label="Sigma">
          <a href="/sigma" aria-current={view === "news" ? "page" : undefined}
            ><i class="ph ph-newspaper" aria-hidden="true"></i>{c.news}</a
          ><a
            href="/sigma?view=papers"
            aria-current={view === "papers" ? "page" : undefined}
            ><i class="ph ph-file-text" aria-hidden="true"></i>{c.papers}</a>
        </nav><form class="sigma-search" method="get" action="/sigma">
          <input type="hidden" name="view" value={view} />
          {view === "news" && <select class="sigma-topic-filter" name="topic" aria-label={c.category} data-sigma-topic>
            <option value="">{c.allTopics}</option>
            {sigmaCategories.map((value) => <option value={value} selected={value === topic}>{c[value]}</option>)}
          </select>}
          <div class="sigma-query"><input
            type="search"
            name="q"
            value={query}
            maxlength="200"
            placeholder={c.search}
            aria-label={c.search}
          /><button
            class="button button--secondary"
            type="submit"
            aria-label={c.searchButton}
            ><i class="ph ph-magnifying-glass" aria-hidden="true"></i></button></div>
        </form>
      </div>
      {!unavailable && <div class="sigma-results">
        <span>{c.resultCount.replace("{count}", String(total))}</span>
        {totalPages > 0 && <span>{pageLabel}</span>}
        {(query || topic) && <a href={view === "papers" ? "/sigma?view=papers" : "/sigma"}>{c.clearFilters}</a>}
      </div>}
      <div class="sigma-list">
        {
          view === "news" &&
            stories.slice(0, size).map((story) => {
              const selected = sigmaTranslation(story.document, locale);
              return (
                <article class="sigma-row">
                  <div>
                    <>
                      <div class="sigma-meta">
                        <span class="sigma-topic" data-topic={story.document.category}>
                          {c[story.document.category]}
                        </span>
                        <time datetime={story.published_at}>
                          {new Date(story.published_at).toLocaleDateString(dateLocale(locale), { month: "short", day: "numeric" })}
                        </time>
                        <a href={`/people/${story.owner}`}>@{story.owner}</a>
                        {selected.fallback && (
                          <span lang={selected.language}>
                            {selected.language}
                          </span>
                        )}
                      </div>
                      <h2 lang={selected.language}>
                        <a href={`/sigma/${story.owner}/${story.slug}`}>
                          {selected.text.title}
                        </a>
                      </h2>
                      <p lang={selected.language}>{selected.text.summary}</p>
                      <SigmaActions id={story.id} path={`/sigma/${story.owner}/${story.slug}`} title={selected.text.title} likes={story.likes_count} liked={story.liked} />
                    </>
                  </div>
                  {story.document.images[0] && (
                    <img
                      src={story.document.images[0].url}
                      alt=""
                      width="110"
                      height="80"
                      loading="lazy"
                    />
                  )}
                </article>
              );
            })
        }
        {
          view === "papers" &&
            papers.slice(0, size).map((paper) => (
              <article class="sigma-row">
                <div>
                  <>
                    <div class="sigma-meta">
                      <>
                        <span class="sigma-topic" data-topic="models">
                          {c.papers}
                        </span>
                        <a href={`/people/${paper.owner}`}>@{paper.owner}</a>
                        <time datetime={paper.published_at}>
                          {new Date(paper.published_at).toLocaleDateString(
                            dateLocale(locale),
                            { month: "short", day: "numeric" },
                          )}
                        </time>
                      </>
                    </div>
                    <h2>
                      <a href={`/papers/${paper.owner}/${paper.slug}`}>
                        {paper.title}
                      </a>
                    </h2>
                    <p>{paper.summary}</p>
                  </>
                </div>
              </article>
            ))
        }
      </div>
      {
        !(view === "news" ? stories : papers).length && (
          <div class="empty-state sigma-empty">
            <h2>
              {unavailable
                ? c.loadingError
                : query || topic || page
                  ? c.noResults
                  : c.empty}
            </h2>
            {!unavailable && !query && !topic && !page && (
              <>
                <p>{c.emptyDetail}</p>
                <a
                  class="button button--dark"
                  href={view === "papers" ? "/papers/new" : "/sigma/editor"}
                >
                  {view === "papers" ? c.papers : c.contribute}
                </a>
              </>
            )}
          </div>
        )
      }
      {
        totalPages > 1 && (
          <nav class="sigma-pagination" aria-label={pageLabel}>
            {page > 0 ? (
              <a class="button button--secondary" href={href(page - 1)} aria-label={c.previous} title={c.previous}>
                ←
              </a>
            ) : (
              <span class="sigma-page-disabled" aria-hidden="true">←</span>
            )}
            <div class="sigma-page-numbers">{pageNumbers.map((number) => number === "gap" ? <span aria-hidden="true">…</span> :
              <a href={href(number)} aria-current={number === page ? "page" : undefined} aria-label={c.pageOf.replace("{page}", String(number + 1)).replace("{pages}", String(totalPages))}>{number + 1}</a>)}</div>
            {page + 1 < totalPages ? (
              <a class="button button--secondary" href={href(page + 1)} aria-label={c.next} title={c.next}>
                →
              </a>
            ) : (
              <span class="sigma-page-disabled" aria-hidden="true">→</span>
            )}
          </nav>
        )
      }
    </div>
  </div>
</CommunicationsLayout>
<script>
  import "@/scripts/sigma-discovery";
</script>
