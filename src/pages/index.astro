---
import InfoTip from '@/components/InfoTip.astro';
import LogoMark from '@/components/LogoMark.astro';
import SuperAssistant from '@/components/SuperAssistant.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const capabilities = [
  {
    title: 'Models',
    copy: 'Find, inspect, run and build on AI models.',
    details: 'Every reviewed model can show its files, versions, license, architecture, provenance, hardware requirements and ways to use it.',
    helpTerm: 'model' as const,
    href: '/models',
    icon: 'ph-cube',
    cta: 'Explore models',
  },
  {
    title: 'Datasets',
    copy: 'Find and publish datasets with the information needed to understand and reuse them responsibly.',
    details: 'See the license, schema, preview, provenance, lineage and version history in one place.',
    helpTerm: 'dataset' as const,
    href: '/datasets',
    icon: 'ph-database',
    cta: 'Explore datasets',
  },
  {
    title: 'Apps',
    copy: 'Try AI projects directly in the browser.',
    details: 'See what they do, inspect how they were built and discover the models and datasets behind them.',
    helpTerm: 'app' as const,
    href: '/spaces',
    icon: 'ph-browser',
    cta: 'Explore apps',
  },
  {
    title: 'Organizations',
    copy: 'Give your team one shared home for its AI work.',
    details: 'Manage members, repositories, permissions, reviews and activity while keeping public work open to the wider community.',
    helpTerm: 'organization' as const,
    href: '/organizations',
    icon: 'ph-users-three',
    cta: 'Build together',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <div class="launch-pill">
          <span class="launch-pill__dot" aria-hidden="true"></span>
          <span>Public beta <InfoTip term="publicBeta" /></span>
          <span aria-hidden="true">·</span>
          <span>Every public release is reviewed <InfoTip term="reviewFirst" /></span>
        </div>
        <h1>Open intelligence, built together.</h1>
        <p class="hero-lead">
          Super ii is an open home for AI models, datasets, apps, agents, research and the people building them.
          <span>Discover existing work. Understand how it was made. Build on it. Share what you create.</span>
        </p>
        <div class="button-row">
          <span class="button-with-info">
            <a class="button button--dark" href="/sign-up">
              Join Super ii
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
            <InfoTip term="joinFree" label="joining Super ii" />
          </span>
          <span class="button-with-info">
            <a class="button button--secondary" href="/bring-my-work">
              Bring my work
              <i class="ph ph-bridge" aria-hidden="true"></i>
            </a>
            <InfoTip term="bringMyWork" />
          </span>
        </div>
        <p class="hero-note">
          <i class="ph ph-credit-card" aria-hidden="true"></i>
          No card required. <a href="/models">Explore the hub</a>
        </p>
      </div>

      <div class="hero-mark" aria-label="Super ii Sii brand mark">
        <LogoMark size="large" priority />
        <span class="hero-mark__caption">Built in public</span>
      </div>
    </div>
  </section>

  <section class="trust-bar" aria-label="Launch principles">
    <div class="shell trust-bar__inner">
      <div class="trust-item"><i class="ph ph-globe-hemisphere-west" aria-hidden="true"></i> Public by default</div>
      <div class="trust-item"><i class="ph ph-lightning" aria-hidden="true"></i> Built for speed</div>
      <div class="trust-item"><i class="ph ph-code" aria-hidden="true"></i> Built on open standards</div>
      <div class="trust-item"><i class="ph ph-shield-check" aria-hidden="true"></i> Clear access controls</div>
    </div>
  </section>

  <section class="agent-starter-hook" id="agent-starter">
    <div class="shell agent-starter-hook__inner">
      <div class="agent-starter-hook__copy">
        <p class="eyebrow">Agent Starter · Your first agent is free</p>
        <h2>Run your first AI agent—with free ☁️ AI.</h2>
        <p>No GPU required. No API setup. Join Super ii and we’ll help you get an agent running on your computer.</p>
      </div>
      <a class="button button--dark" href="/sign-up">
        Start Agent Starter
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">One place to make progress</p>
        <h2>From an idea to something others can use.</h2>
        <p>Discover work, understand how it was built, improve it together and keep the important evidence attached:</p>
        <p class="help-term-list">
          <span>versions <InfoTip term="version" /></span>
          <span>licenses <InfoTip term="license" /></span>
          <span>provenance <InfoTip term="provenance" /></span>
          <span>compatibility <InfoTip term="hardwareCompatibility" /></span>
          <span>review <InfoTip term="reviewFirst" /></span>
          <span>lineage <InfoTip term="lineage" /></span>
        </p>
      </div>

      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article class="capability-card">
            <div class="capability-card__icon">
              <i class:list={['ph', capability.icon]} aria-hidden="true"></i>
            </div>
            <div>
              <div class="heading-with-help">
                <h3>{capability.title}</h3>
                <InfoTip term={capability.helpTerm} />
              </div>
              <p>{capability.copy}</p>
              <p class="capability-card__details">{capability.details}</p>
            </div>
            <a class="card-link" href={capability.href}>
              {capability.cta}
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="shell zero-state-panel">
      <div class="zero-state-copy">
        <p class="eyebrow">A clean beginning</p>
        <div class="heading-with-help">
          <h2>You are early.</h2>
          <InfoTip term="emptyCatalog" />
        </div>
        <p>The catalog is just getting started.</p>
        <p>Models, datasets and apps appear here as creators publish reviewed work.</p>
        <p>If you are building something, you can be part of what comes next.</p>
        <div class="button-row">
          <a class="button button--dark" href="/models">Explore the catalog</a>
          <a class="button button--secondary" href="/docs#publish">How publishing works</a>
        </div>
      </div>

      <div class="zero-state-window" aria-label="Preview of the empty models catalog">
        <div class="window-bar">
          <span></span><span></span><span></span>
          <div class="window-path">superii.site/models</div>
        </div>
        <div class="window-content">
          <div>
            <div class="window-empty-icon"><i class="ph ph-cube" aria-hidden="true"></i></div>
            <h3>Ready for the first reviewed model</h3>
            <p>Reviewed models will appear here as creators publish them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">What Super ii stands for</p>
        <h2>A better default for shared AI work.</h2>
      </div>

      <div class="principle-grid">
        <article class="principle">
          <span class="principle__number">01</span>
          <h3>Evidence over hype</h3>
          <p>Performance numbers are more useful when you can also see the model, version, hardware, license, provenance, limitations and verification. Super ii keeps those facts close to the claim.<InfoTip term="provenance" /></p>
        </article>
        <article class="principle">
          <span class="principle__number">02</span>
          <h3>Open where possible. Controlled where necessary.</h3>
          <p>Public work stays easy to discover. When work needs tighter control, Super ii uses clear permissions for people, teams and organizations.<InfoTip term="privateRepository" /></p>
        </article>
        <article class="principle">
          <span class="principle__number">03</span>
          <h3>Clear before you pay.</h3>
          <p>You can see the price, what is included and any usage-based cost before you choose a paid service.<InfoTip term="usageInfrastructure" /></p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-band__inner">
      <div>
        <p class="eyebrow">The hub is open</p>
        <h2>Publish a reviewed release.</h2>
      </div>
      <a class="button button--yellow" href="/sign-up">Join free</a>
    </div>
  </section>
  <SuperAssistant />
</BaseLayout>
