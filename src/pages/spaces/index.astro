---
import Catalog from '@/components/Catalog.astro';
import HighlightsStrip from '@/components/HighlightsStrip.astro';
import ExploreLayout from '@/layouts/ExploreLayout.astro';
---
<ExploreLayout active="spaces" title="Apps" titleHelp="app" eyebrow="Discover public work" description="Explore interactive AI apps, see how they work, and open them to try for yourself.">
  <Fragment slot="actions">
    <a class="button button--dark" href="/new"><i class="ph ph-plus" aria-hidden="true"></i>Create &amp; upload</a>
    <a class="button explore-cyan" href="/bring-my-work"><i class="ph ph-handshake" aria-hidden="true"></i>Bring my work</a>
  </Fragment>
  <HighlightsStrip kind="space" />
  <Catalog kind="spaces" />
</ExploreLayout>
