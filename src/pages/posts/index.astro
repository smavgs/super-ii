---
import CommunicationsLayout from '@/layouts/CommunicationsLayout.astro';
import CreatorLink from '@/components/CreatorLink.astro';
import CommunicationsHeading from '@/components/CommunicationsHeading.astro';
import { sqlClient } from '@/lib/db';
import { dateLocale as dateLocaleFor } from '@/lib/i18n';
type Post = { author: string; author_name: string; author_avatar_url: string | null; slug: string; title: string; summary: string; body: string; published_at: string };
const sql = sqlClient(Astro.locals); let posts: Post[] = []; let unavailable = !sql;
const dateLocale = dateLocaleFor(Astro.locals.locale ?? 'en');
if (sql) { try { posts = await sql`select profile.handle as author, profile.display_name as author_name, profile.avatar_url as author_avatar_url, post.slug, post.title, post.summary, post.body, post.published_at from app.posts post join app.profiles profile on profile.id = post.author_profile_id and profile.is_public where post.is_public order by post.published_at desc limit 100` as Post[]; } catch { unavailable = true; } }
---
<CommunicationsLayout active="posts" title="Posts" description="Public notes, release stories, and technical posts from the Super ii community.">
  <CommunicationsHeading audience="Public community writing" title="Posts" description="Share what you are building, learning and releasing."><div class="button-row"><a class="button button--dark" href="/posts/new">Write a post</a></div></CommunicationsHeading>
  <div class="section shell" data-collection-filter>{posts.length > 0 && <div class="communications-toolbar"><label>Search these posts<input type="search" data-collection-search placeholder="Title, author or summary" /></label><small><span data-filter-count aria-live="polite"></span> · <span>Latest 100 public posts</span></small></div>}{posts.length ? <div class="content-card-grid">{posts.map((post) => <article class="content-card" data-collection-item><div class="content-card__byline"><CreatorLink compact handle={post.author} displayName={post.author_name} avatarUrl={post.author_avatar_url} /><time datetime={post.published_at}>{new Date(post.published_at).toLocaleDateString(dateLocale, { dateStyle: 'medium' })}</time></div><h2><a class="content-card__title-link" href={`/posts/${encodeURIComponent(post.author)}/${encodeURIComponent(post.slug)}`}><span data-no-translate>{post.title}</span></a></h2><p data-no-translate>{post.summary || `${post.body.slice(0, 220)}${post.body.length > 220 ? '…' : ''}`}</p><a class="content-card__open" href={`/posts/${encodeURIComponent(post.author)}/${encodeURIComponent(post.slug)}`}>Read post <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article>)}</div> : <div class="empty-state"><div class="empty-state__icon"><i class="ph ph-pencil-line" aria-hidden="true"></i></div><h2>{unavailable ? 'Posts are temporarily unavailable.' : 'Write the first community post'}</h2><p>{unavailable ? 'Please try again shortly.' : 'Share something useful about a build, release, experiment or result.'}</p></div>}{posts.length > 0 && <p data-filter-empty hidden>No posts match your search.</p>}</div>
</CommunicationsLayout>
