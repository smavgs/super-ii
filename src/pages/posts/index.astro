---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { sqlClient } from '@/lib/db';
type Post = { author: string; slug: string; title: string; summary: string; body: string; published_at: string };
const sql = sqlClient(Astro.locals); let posts: Post[] = []; let unavailable = false;
if (sql) { try { posts = await sql`select profile.handle as author, post.slug, post.title, post.summary, post.body, post.published_at from app.posts post join app.profiles profile on profile.id = post.author_profile_id where post.is_public order by post.published_at desc limit 100` as Post[]; } catch { unavailable = true; } }
---
<BaseLayout title="Posts" description="Public notes, release stories, and technical posts from the Super ii community.">
  <PageHero eyebrow="Community writing ✍️" title="Posts from people building in public." description="Share release notes, technical lessons, evaluations, and context around open AI work." compact><div class="button-row"><a class="button button--dark" href="/posts/new">Write a post</a><a class="button button--secondary" href="/feed">Community feed</a></div></PageHero>
  <main class="section shell">{posts.length ? <div class="content-card-grid">{posts.map((post) => <a class="content-card" href={`/posts/${post.author}/${post.slug}`}><p class="eyebrow">@{post.author} · {new Date(post.published_at).toLocaleDateString('en', { dateStyle: 'medium' })}</p><h2>{post.title}</h2><p>{post.summary || `${post.body.slice(0, 220)}${post.body.length > 220 ? '…' : ''}`}</p><span>Read post</span></a>)}</div> : <div class="empty-state"><div class="empty-state__icon"><i class="ph ph-pencil-line" aria-hidden="true"></i></div><h2>{unavailable ? 'Posts cannot be loaded.' : 'Write the first community post'}</h2><p>{unavailable ? 'No placeholder posts are shown.' : 'Share something useful about a real build, release, or result.'}</p><a class="button button--dark" href="/posts/new">Write a post</a></div>}</main>
</BaseLayout>
