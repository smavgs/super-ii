---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CreatorLink from '@/components/CreatorLink.astro';
import PageHero from '@/components/PageHero.astro';
import { sqlClient } from '@/lib/db';
type Post = { author: string; author_name: string; author_avatar_url: string | null; slug: string; title: string; summary: string; body: string; published_at: string };
const sql = sqlClient(Astro.locals); let posts: Post[] = []; let unavailable = false;
const dateLocale = Astro.locals.locale === 'ru' ? 'ru-RU' : 'en';
if (sql) { try { posts = await sql`select profile.handle as author, profile.display_name as author_name, profile.avatar_url as author_avatar_url, post.slug, post.title, post.summary, post.body, post.published_at from app.posts post join app.profiles profile on profile.id = post.author_profile_id and profile.is_public where post.is_public order by post.published_at desc limit 100` as Post[]; } catch { unavailable = true; } }
---
<BaseLayout title="Posts" description="Public notes, release stories, and technical posts from the Super ii community.">
  <PageHero eyebrow="Community writing ✍️" title="Posts from people building in public." description="Share release notes, technical lessons, evaluations, and context around open AI work." compact><div class="button-row"><a class="button button--dark" href="/posts/new">Write a post</a><a class="button button--secondary" href="/feed">Community feed</a></div></PageHero>
  <main class="section shell">{posts.length ? <div class="content-card-grid">{posts.map((post) => <article class="content-card"><div class="content-card__byline"><CreatorLink compact handle={post.author} displayName={post.author_name} avatarUrl={post.author_avatar_url} /><time datetime={post.published_at}>{new Date(post.published_at).toLocaleDateString(dateLocale, { dateStyle: 'medium' })}</time></div><h2><a class="content-card__title-link" href={`/posts/${encodeURIComponent(post.author)}/${encodeURIComponent(post.slug)}`}>{post.title}</a></h2><p>{post.summary || `${post.body.slice(0, 220)}${post.body.length > 220 ? '…' : ''}`}</p><a class="content-card__open" href={`/posts/${encodeURIComponent(post.author)}/${encodeURIComponent(post.slug)}`}>Read post <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article>)}</div> : <div class="empty-state"><div class="empty-state__icon"><i class="ph ph-pencil-line" aria-hidden="true"></i></div><h2>{unavailable ? 'Posts are temporarily unavailable.' : 'Write the first community post'}</h2><p>{unavailable ? 'Please try again shortly.' : 'Share something useful about a build, release, experiment or result.'}</p><a class="button button--dark" href="/posts/new">Write a post</a></div>}</main>
</BaseLayout>
