---
import ExploreLayout from '@/layouts/ExploreLayout.astro';
import '@/styles/tools.css';

export const prerender = false;
const requirements = [
  { id: 'identity', title: 'Identity and access', icon: 'identification-card', description: 'Options for SSO, directory sync, custom roles, domain controls, and structured offboarding.', status: 'Defined in your proposal' },
  { id: 'deployment', title: 'Deployment requirements', icon: 'map-pin', description: 'Regional needs, customer-controlled infrastructure, retention boundaries, and network architecture can be assessed.', status: 'Reviewed with your team' },
  { id: 'audit', title: 'Audit and policy', icon: 'clipboard-text', description: 'Activity history, review gates, access policy, and evidence exports can be included where the product supports them.', status: 'Included as agreed' },
  { id: 'support', title: 'Support plan', icon: 'headset', description: 'Named channels, response targets, onboarding, and escalation paths are defined for the purchased service.', status: 'Defined in your support plan' },
];
---
<ExploreLayout active="enterprise" title="Enterprise" eyebrow="Plan for your team" titleHelp="enterpriseProposal" description="Your Enterprise proposal clearly lists the controls, deployment options, support and responsibilities included.">
  <Fragment slot="actions"><a class="button button--dark" href="/contact?interest=enterprise"><i class="ph ph-chats" aria-hidden="true"></i>Request a proposal</a><a class="button explore-cyan" href="/security"><i class="ph ph-shield-check" aria-hidden="true"></i>Review the security approach</a></Fragment>
  <div class="shell tools-content enterprise-content">
    <section aria-labelledby="enterprise-requirements">
      <div class="explore-section-title"><h2 id="enterprise-requirements">Capabilities confirmed in writing.</h2></div>
      <p class="explore-hint">Every Enterprise proposal clearly states the supported controls, responsibilities, service levels and exclusions.</p>
      <div class="enterprise-requirements">
        {requirements.map((item, index) => <details class="explore-panel" name="enterprise-requirement" id={item.id} open={index === 0}>
          <summary><i class={`ph ph-${item.icon}`} aria-hidden="true"></i>{item.title}</summary>
          <div class="explore-panel__body"><p>{item.description}</p><p class="tools-evidence"><i class="ph ph-file-text" aria-hidden="true"></i>{item.status}</p></div>
        </details>)}
      </div>
    </section>
    <aside class="tools-next enterprise-start">
      <p class="eyebrow">Begin with requirements</p>
      <h2>Tell us what your team must protect, prove, and ship.</h2>
      <p>Start with your use case, team needs and deployment requirements.</p>
      <a class="button button--dark" href="/contact?interest=enterprise">Start a conversation<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </aside>
  </div>
</ExploreLayout>
