---
import CommunicationsLayout from '@/layouts/CommunicationsLayout.astro';
import CommunicationsHeading from '@/components/CommunicationsHeading.astro';
import CreatorLink from '@/components/CreatorLink.astro';
import { sqlClient } from '@/lib/db';
import { activityCategory } from '@/lib/communication-presentation';
import { kindPath } from '@/lib/repository';
import type { RepositoryKind } from '@/lib/catalog';
import { dateLocale as dateLocaleFor } from '@/lib/i18n';
type FeedEvent = {
  id: string; event_type: string; occurred_at: string; actor: string | null;
  actor_name: string | null; actor_avatar_url: string | null;
  repository_kind: RepositoryKind | null; repository_owner: string | null;
  repository_slug: string | null; repository_title: string | null;
  content_owner: string | null; content_slug: string | null; content_title: string | null;
};
const sql = sqlClient(Astro.locals);
let events: FeedEvent[] = [];
let unavailable = !sql;
const dateLocale = dateLocaleFor(Astro.locals.locale ?? 'en');
if (sql) {
  try {
    events = await sql`
      select event.id, event.event_type, event.occurred_at,
        profile.handle as actor, profile.display_name as actor_name, profile.avatar_url as actor_avatar_url,
        repository.kind as repository_kind, repository.owner_handle as repository_owner,
        repository.slug as repository_slug, repository.title as repository_title,
        coalesce(paper_owner.handle, post_owner.handle) as content_owner,
        coalesce(paper.slug, post.slug) as content_slug, coalesce(paper.title, post.title) as content_title
      from app.activity_events event
      left join app.profiles profile on profile.id = event.actor_profile_id and profile.is_public
      left join app.repositories repository on repository.id = event.repository_id
        and repository.visibility = 'public' and repository.status = 'published'
      left join app.papers paper on event.event_type = 'paper.published'
        and paper.id::text = event.metadata->>'paper_id' and paper.is_public
      left join app.profiles paper_owner on paper_owner.id = paper.owner_profile_id and paper_owner.is_public
      left join app.posts post on event.event_type = 'post.published'
        and post.id::text = event.metadata->>'post_id' and post.is_public
      left join app.profiles post_owner on post_owner.id = post.author_profile_id and post_owner.is_public
      where event.is_public
        and (event.repository_id is null or repository.id is not null)
        and (event.event_type <> 'paper.published' or paper_owner.id is not null)
        and (event.event_type <> 'post.published' or post_owner.id is not null)
      order by event.occurred_at desc limit 100
    ` as FeedEvent[];
  } catch { unavailable = true; }
}
const eventEmoji: Record<string, string> = { 'repository.created': '🚀', 'revision.published': '✅', 'discussion.created': '💬', 'comment.created': '💬', 'repository.liked': '❤️', 'profile.followed': '👥', 'organization.created': '🏢', 'paper.published': '📄', 'post.published': '✍️' };
const eventAction: Record<string, string> = { 'repository.created': 'created a repository', 'revision.published': 'published a revision', 'discussion.created': 'started a discussion', 'comment.created': 'left a comment', 'repository.liked': 'liked a repository', 'profile.followed': 'followed a builder', 'organization.created': 'created an organization', 'paper.published': 'published the paper', 'post.published': 'published' };
const categories: Record<string, string> = { repositories: 'Repositories', papers: 'Papers', posts: 'Posts', discussions: 'Discussions', community: 'Community' };
const availableCategories = new Set(events.map((event) => activityCategory(event.event_type)));
function destination(event: FeedEvent) {
  if (event.content_owner && event.content_slug) return `/${event.event_type === 'paper.published' ? 'papers' : 'posts'}/${encodeURIComponent(event.content_owner)}/${encodeURIComponent(event.content_slug)}`;
  if (event.repository_kind && event.repository_owner && event.repository_slug) return `/${kindPath(event.repository_kind)}/${encodeURIComponent(event.repository_owner)}/${encodeURIComponent(event.repository_slug)}`;
  return null;
}
---
<CommunicationsLayout active="feed" title="Community feed" description="Recent public repository, paper, post, and discussion activity on Super ii.">
  <CommunicationsHeading audience="Public activity" title="Community feed" description="Follow new work, research and conversations across Super ii.">
    <a class="button button--dark" href="/posts/new"><i class="ph ph-pencil-line" aria-hidden="true"></i>Write a post</a>
    <a class="button button--secondary communications-connect" href="/new"><i class="ph ph-plus" aria-hidden="true"></i>Publish a repository</a>
  </CommunicationsHeading>
  <div class="section shell feed-shell" data-collection-filter>
    {events.length > 0 && <>
      <div class="communications-toolbar"><p class="communications-caption">Latest 100 public events</p><small><span data-filter-count aria-live="polite"></span></small></div>
      <div class="communications-filters" aria-label="Activity types">
        <button type="button" data-category-filter="all" aria-pressed="true">All activity</button>
        {Object.entries(categories).filter(([key]) => availableCategories.has(key)).map(([key, label]) => <button type="button" data-category-filter={key} aria-pressed="false">{label}</button>)}
      </div>
    </>}
    {events.length ? <div class="feed-list">{events.map((event) => {
      const href = destination(event);
      const category = activityCategory(event.event_type);
      return <article data-collection-item data-category={category}>
        <span class="feed-emoji" aria-hidden="true">{eventEmoji[event.event_type] ?? '•'}</span>
        <div>
          <div class="feed-actor-line">{event.actor ? <CreatorLink compact handle={event.actor} displayName={event.actor_name} avatarUrl={event.actor_avatar_url} /> : <strong>Super ii</strong>}<span>{eventAction[event.event_type] ?? event.event_type.replaceAll('.', ' ')}</span></div>
          {href && <a class="feed-destination" href={href} data-no-translate>{event.content_title || event.repository_title}</a>}
          <span class="communications-kind" data-kind={category}>{categories[category]}</span>
          <time datetime={event.occurred_at}>{new Date(event.occurred_at).toLocaleString(dateLocale, { dateStyle: 'medium', timeStyle: 'short' })}</time>
        </div>
      </article>;
    })}</div> : <div class="empty-state"><h2>{unavailable ? 'The feed is temporarily unavailable.' : 'No public activity yet'}</h2><p>{unavailable ? 'Please try again shortly.' : 'The first real public action will appear here.'}</p></div>}
    {events.length > 0 && <p data-filter-empty hidden>No activity in this view.</p>}
  </div>
</CommunicationsLayout>
