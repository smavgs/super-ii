---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CreatorLink from '@/components/CreatorLink.astro';
import PageHero from '@/components/PageHero.astro';
import { sqlClient } from '@/lib/db';
type FeedEvent = { id: string; event_type: string; occurred_at: string; actor: string | null; actor_name: string | null; actor_avatar_url: string | null; repository_kind: string | null; repository_owner: string | null; repository_slug: string | null; repository_title: string | null; metadata: Record<string, unknown> };
const sql = sqlClient(Astro.locals); let events: FeedEvent[] = []; let unavailable = false;
const dateLocale = Astro.locals.locale === 'ru' ? 'ru-RU' : 'en';
if (sql) { try { events = await sql`select event.id, event.event_type, event.occurred_at, profile.handle as actor, profile.display_name as actor_name, profile.avatar_url as actor_avatar_url, repository.kind as repository_kind, repository.owner_handle as repository_owner, repository.slug as repository_slug, repository.title as repository_title, event.metadata from app.activity_events event left join app.profiles profile on profile.id = event.actor_profile_id and profile.is_public left join app.repositories repository on repository.id = event.repository_id and repository.visibility = 'public' and repository.status = 'published' where event.is_public order by event.occurred_at desc limit 100` as FeedEvent[]; } catch { unavailable = true; } }
const eventEmoji: Record<string, string> = { 'repository.created': '🚀', 'revision.published': '✅', 'discussion.created': '💬', 'comment.created': '💬', 'repository.liked': '❤️', 'profile.followed': '👥', 'organization.created': '🏢', 'paper.published': '📄', 'post.published': '✍️' };
function repositoryHref(event: FeedEvent) { if (!event.repository_kind || !event.repository_owner || !event.repository_slug) return null; const prefix = event.repository_kind === 'model' ? 'models' : event.repository_kind === 'dataset' ? 'datasets' : 'spaces'; return `/${prefix}/${event.repository_owner}/${event.repository_slug}`; }
function eventTitle(event: FeedEvent) { const title = typeof event.metadata.title === 'string' ? event.metadata.title : null; if (event.event_type === 'paper.published') return `published the paper “${title ?? 'Untitled'}”`; if (event.event_type === 'post.published') return `published “${title ?? 'Untitled'}”`; return event.event_type.replaceAll('.', ' '); }
---
<BaseLayout title="Community feed" description="Recent public repository, paper, post, and discussion activity on Super ii.">
  <PageHero eyebrow="Community feed 🌍" title="Open work, as it happens." description="Recent public activity across repositories, releases, discussions, papers, posts, likes and follows." compact><div class="button-row"><a class="button button--dark" href="/new">Publish a repository</a><a class="button button--secondary" href="/posts/new">Write a post</a></div></PageHero>
  <main class="section shell feed-shell">{events.length ? <div class="feed-list">{events.map((event) => { const href = repositoryHref(event); return <article><span class="feed-emoji" aria-hidden="true">{eventEmoji[event.event_type] ?? '•'}</span><div><div class="feed-actor-line">{event.actor ? <CreatorLink compact handle={event.actor} displayName={event.actor_name} avatarUrl={event.actor_avatar_url} /> : <strong>Super ii</strong>}<span>{eventTitle(event)}</span></div>{event.repository_title && href && <a href={href}>{event.repository_title}</a>}<time datetime={event.occurred_at}>{new Date(event.occurred_at).toLocaleString(dateLocale, { dateStyle: 'medium', timeStyle: 'short' })}</time></div></article>; })}</div> : <div class="empty-state"><h2>{unavailable ? 'The feed is temporarily unavailable.' : 'No public activity yet'}</h2><p>{unavailable ? 'Please try again shortly.' : 'The first real public action will appear here.'}</p></div>}</main>
</BaseLayout>
