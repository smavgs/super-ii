---
import ExploreLayout from '@/layouts/ExploreLayout.astro';
import TransparencyChecker from '@/components/TransparencyChecker.astro';
import TransparencyWorkspace from '@/components/TransparencyWorkspace.astro';
import JourneyLabel from '@/components/JourneyLabel.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';
import { dateLocale as dateLocaleFor } from '@/lib/i18n';
import { listProfileTransparency, searchTransparencyReports } from '@/lib/transparent-store';
import '@/styles/transparent.css';
import '@/styles/workspace.css';

export const prerender = false;

const sql = sqlClient(Astro.locals);
const authentication = typeof Astro.locals.auth === 'function' ? Astro.locals.auth() : null;
const signedIn = Boolean(authentication && 'userId' in authentication && authentication.userId);
if (signedIn) Astro.response.headers.set('Cache-Control', 'private, no-store');
let personalReports: Awaited<ReturnType<typeof listProfileTransparency>> = [];
let personalReportsUnavailable = true;
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const dateLocale = dateLocaleFor(Astro.locals.locale ?? 'en');
let reportsUnavailable = !sql;
let reports: Awaited<ReturnType<typeof searchTransparencyReports>> = [];
if (sql) {
  try { reports = await searchTransparencyReports(sql, { query, limit: 24 }); } catch { reportsUnavailable = true; }
  if (signedIn) {
    try {
      const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
      if (profile) {
        personalReports = await listProfileTransparency(sql, profile.profileId);
        personalReportsUnavailable = false;
      }
    } catch { personalReportsUnavailable = true; }
  }
}
---

<ExploreLayout
  active="transparent"
  eyebrow="Know the evidence"
  title="Transparent"
  description="Check public AI work. See what is verified, declared, derived or still unknown, with the sources attached."
  image="/brand/super-ii-transparent-card.png"
  imageAlt="Super ii Transparent — public evidence, exact revision, four clear evidence states."
>
  <Fragment slot="actions"><a class="button explore-cyan" href="#public-reports"><i class="ph ph-files" aria-hidden="true"></i>Browse reports</a><a class="button explore-violet" href="#agents"><i class="ph ph-robot" aria-hidden="true"></i>Use with your agent</a></Fragment>
  <div class="transparent-page">
    <div class="shell transparent-page__hero">
      <TransparencyChecker variant="page" embedded initialSource={Astro.url.searchParams.get('source') ?? ''} />
    </div>

    {signedIn && <div class="shell"><details class="workspace-disclosure personal-work" id="my-reports">
      <summary>My reports<small>Saved reports, watched revisions and verified claims.</small></summary>
      <div class="workspace-disclosure__body">
        {personalReportsUnavailable ? <p role="status">Your reports could not be loaded. Please refresh to try again.</p> : <TransparencyWorkspace items={personalReports} />}
      </div>
    </details></div>}

    <section class="transparent-reports" id="public-reports" aria-labelledby="public-reports-title">
      <div class="shell">
        <div class="transparent-reports__heading">
          <div><p class="eyebrow">Permanent public evidence</p><h2 id="public-reports-title">Transparency reports</h2><p>Each link stays pinned to its exact Hugging Face commit and criteria version.</p></div>
          <form method="get" action="/transparent" class="transparent-search">
            <label class="sr-only" for="transparent-report-search">Search reports</label>
            <input id="transparent-report-search" name="q" value={query} maxlength="120" placeholder="Search owner/project" />
            <button type="submit" aria-label="Search"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></button>
          </form>
        </div>
        {reports.length ? (
          <div class="transparent-report-grid">
            {reports.map((report) => <a href={`/transparent/${report.report_key}`}>
                <span>{report.repository_kind}</span>
                <h3 data-no-translate>{report.repository_id}</h3>
                <p><strong>{String(report.coverage.established ?? 0)}</strong> / {String(report.coverage.total ?? 0)} fields established</p>
                <small>revision {report.source_revision.slice(0, 10)} · {new Date(report.checked_at).toLocaleDateString(dateLocale, { dateStyle: 'medium' })}</small>
                <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>)}
          </div>
        ) : <div class="transparent-reports__empty"><i class="ph ph-magnifying-glass" aria-hidden="true"></i><h3>{reportsUnavailable ? 'Reports are temporarily unavailable.' : query ? 'No matching report yet.' : 'The first report can start here.'}</h3><p>{reportsUnavailable ? 'Please try again shortly.' : 'Run a check above to create a public evidence report.'}</p></div>}
      </div>
    </section>

    <div class="shell">
      <details class="explore-panel" id="evidence-states"><summary><i class="ph ph-scan" aria-hidden="true"></i>Understand the four evidence states</summary>
    <section class="transparent-principles" aria-labelledby="transparent-principles-title">
      <div>
        <p class="eyebrow">Evidence without theatre</p>
        <h2 id="transparent-principles-title">A report says only what its sources support.</h2>
      </div>
      <div class="transparent-principles__grid">
        <article data-state="verified"><JourneyLabel kind="evidence" /><h3>Verified</h3><p>Directly observed by the bounded checker at the exact commit. Not a safety certification.</p></article>
        <article data-state="declared"><JourneyLabel kind="evidence" /><h3>Declared</h3><p>Stated by the repository creator or Hugging Face. Not independently reproduced.</p></article>
        <article data-state="derived"><JourneyLabel kind="evidence" /><h3>Derived</h3><p>Calculated from observed metadata. Every derived field exposes its method.</p></article>
        <article data-state="unknown"><JourneyLabel kind="evidence" /><h3>Unknown</h3><p>The public evidence does not establish it. Super ii does not fill gaps with guesses.</p></article>
      </div>
    </section>

      </details>
      <details class="explore-panel" id="agents"><summary><i class="ph ph-robot" aria-hidden="true"></i>Use with your agent</summary>
    <section class="transparent-agent">
      <div><p class="eyebrow">For any compatible agent</p><h2>Use the same evidence engine through MCP.</h2><p>Check, retrieve, search, compare, and—when a human grants the narrow scope—watch reports.</p></div>
      <div class="transparent-agent__endpoint"><span>MCP endpoint</span><code>https://superii.site/mcp/transparent</code><button type="button" data-copy-transparent-mcp>Copy</button></div>
      <a href="/transparent/agents.md">Read the machine guide <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </section>
      </details>
    </div>
  </div>
  <script>
    document.querySelector('[data-copy-transparent-mcp]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      await navigator.clipboard.writeText('https://superii.site/mcp/transparent');
      button.textContent = 'Copied';
      setTimeout(() => { button.textContent = 'Copy'; }, 1600);
    });
  </script>
</ExploreLayout>

<script>
  import '@/scripts/personal-work';
</script>
