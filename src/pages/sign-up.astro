---
import { SignUp } from '@clerk/astro/components';
import AuthStory from '@/components/AuthStory.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedHref, localizedPath, stripLocalePrefix } from '@/lib/i18n';
import { authIsConfigured } from '@/lib/site';

const authConfigured = authIsConfigured(Astro.locals);
const locale = Astro.locals.locale ?? 'en';
const agentStarterRedirect = '/account?welcome=agent-starter#agent-starter';
const aiWorkerRedirect = '/account?welcome=ai-worker#ai-worker';
const agentAccessRedirect = '/account#agents';
const skillsRedirect = '/skills';
const frontierRedirect = '/frontier-ai';
const frontierSetupRedirect = '/frontier-ai#setup';
const allowedRedirects = new Set([
  aiWorkerRedirect,
  agentAccessRedirect,
  skillsRedirect,
  frontierRedirect,
  frontierSetupRedirect,
]);
const requestedRedirect = Astro.url.searchParams.get('redirect_url');
const requestedPlainRedirect = requestedRedirect ? stripLocalePrefix(requestedRedirect) : null;
const plainPostSignUpRedirect = requestedPlainRedirect && allowedRedirects.has(requestedPlainRedirect)
  ? requestedPlainRedirect
  : agentStarterRedirect;
const postSignUpRedirect = localizedHref(plainPostSignUpRedirect, locale);
const plainSignInUrl = plainPostSignUpRedirect === agentStarterRedirect
  ? '/sign-in'
  : `/sign-in?redirect_url=${encodeURIComponent(plainPostSignUpRedirect)}`;
const signInUrl = locale === 'ru' ? `/ru${plainSignInUrl}` : plainSignInUrl;
---

<BaseLayout title="Join Super ii" description="Explore, build, publish and collaborate around open intelligence. Sign up with email, Google, or GitHub. No card required." noindex className="auth-body">
  <div class="auth-page">
    <AuthStory mode="sign-up" />
    <section class="auth-panel">
      <div class="auth-panel__inner">
        <h2>Create your free account</h2>
        <p>Email · Google · GitHub. Free to join. No card required.</p>
        {authConfigured ? (
          <SignUp
            routing="path"
            path={localizedPath('/sign-up', locale)}
            signInUrl={signInUrl}
            forceRedirectUrl={postSignUpRedirect}
            fallbackRedirectUrl={postSignUpRedirect}
            appearance={{
              elements: {
                rootBox: 'sii-clerk-root',
                cardBox: 'sii-clerk-card',
              },
              variables: {
                colorPrimary: '#071a2f',
                borderRadius: '12px',
              },
            }}
          />
        ) : (
          <div class="auth-placeholder">
            <h3>Account activation is being connected</h3>
            <p>Account access is temporarily unavailable. Please try again later.</p>
            <a class="button button--secondary button--block" href="/">Return home</a>
          </div>
        )}
        {locale === 'ru' ? (
          <p class="auth-config-note">Создавая аккаунт, вы соглашаетесь с <a href="/legal/terms">Условиями использования</a> и подтверждаете, что ознакомились с <a href="/legal/privacy">Политикой конфиденциальности</a>.</p>
        ) : (
          <p class="auth-config-note">By creating an account, you agree to the <a href="/legal/terms">Terms</a> and acknowledge the <a href="/legal/privacy">Privacy Policy</a>.</p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
