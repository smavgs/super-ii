---
import WorkspaceJourneyLayout from "@/layouts/WorkspaceJourneyLayout.astro";
import ProductEditor from "@/components/ProductEditor.astro";
import { ensureAuthenticatedProfile } from "@/lib/auth";
import { sqlClient } from "@/lib/db";
import { companyWorkspace } from "@/lib/product-store";
Astro.response.headers.set("Cache-Control", "private, no-store");
let signedIn = false;
let unavailable = false;
let workspace;
const sql = sqlClient(Astro.locals);
try {
  if (sql && (await ensureAuthenticatedProfile(Astro.locals, sql))) {
    signedIn = true;
    workspace = await companyWorkspace(Astro.locals);
  }
} catch {
  unavailable = true;
}
---

<WorkspaceJourneyLayout active="products" title="Company and product" eyebrow="Your company. Your product." description="Help people understand it, find its resources and reach the right person." noindex>
  <a slot="actions" class="button button--secondary" href="/workspace/products"><i class="ph ph-stack" aria-hidden="true"></i>My products</a>
  <ProductEditor workspace={workspace} signedIn={signedIn} unavailable={unavailable} embedded />
</WorkspaceJourneyLayout>
