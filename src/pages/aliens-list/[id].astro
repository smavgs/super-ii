---
import AliensLayout from '@/layouts/AliensLayout.astro';
import {runtimeValue} from '@/lib/db';
import {alienSession} from '@/lib/aliens/http';
import {categories,conditions,deliveryOptions,priceLabel,type Listing} from '@/lib/aliens/input';
let item:Listing|null=null;let unavailable=false;
try{if(/^[a-f0-9-]{36}$/.test(Astro.params.id??'')){const {sql}=await alienSession(Astro.locals);const r=await sql`select app.alien_detail(${Astro.params.id}::uuid) as item`;item=r[0]?.item??null;}}catch{unavailable=true;}
if(!item)Astro.response.status=unavailable?503:404;
Astro.response.headers.set('cache-control','private, no-store');
const d=item?.document;const available=item?.status==='active';
function eventDate(value:string,end=false){if(!value)return 'Date to be confirmed';try{return new Intl.DateTimeFormat(Astro.locals.locale??'en',{dateStyle:end?'medium':'full',...(d?.all_day?{}:{timeStyle:'short'}),timeZone:d?.timezone||'UTC'}).format(new Date(Date.parse(value)-(end&&d?.all_day?1:0)));}catch{return 'Date to be confirmed';}}
---
<AliensLayout title={d?`${d.title} · Aliens List`:'Listing unavailable'} description={d?.description.slice(0,160)} noindex={!available} active={d?.kind==='event'?'events':'hardware'}>
 {item&&d?<article class="alien-detail" data-detail-id={item.id}>
 <a class="alien-back" href={d.kind==='event'?'/aliens-list?kind=event':'/aliens-list'}>← All {d.kind==='event'?'events':'hardware'}</a>
 <header class="alien-detail__heading"><div><div class="alien-meta"><span class="alien-tag" data-kind={d.kind}>{d.kind==='event'?'Event':d.kind==='wanted'?'Wanted':conditions[d.condition as keyof typeof conditions]}</span><span>{categories[d.category as keyof typeof categories]}</span>{!available&&<strong>{item.status}</strong>}{item.source_kind==='official-source'&&<span class="alien-tag">Official source</span>}</div><h1 data-no-translate>{d.title}</h1><p class="alien-muted" data-no-translate>{d.city} · {d.area?d.area+' · ':''}{d.country}</p></div><strong class="alien-detail__price">{priceLabel(d,Astro.locals.locale)}</strong></header>
 <div class="alien-detail__grid"><div><div class="alien-gallery">{d.photos.map((hash,i)=><a href={`/api/aliens-list/media/${item!.id}/${hash}.jpg`} target="_blank" rel="noopener"><img src={`/api/aliens-list/media/${item!.id}/${hash}.jpg`} width="900" height="650" alt={`${d!.title} · photo ${i+1}`} loading={i?'lazy':'eager'}/></a>)}</div>
 <h2>{d.kind==='event'?'About this event':'About this listing'}</h2><p class="alien-description" data-no-translate>{d.description}</p>
 {Object.values(d.specs).some(Boolean)&&<dl class="alien-specs">{Object.entries(d.specs).filter(([,v])=>v).map(([key,value])=><div><dt>{{brand:'Brand',model:'Model',ram:'System / unified memory',vram:'GPU VRAM',chip:'CPU / chip',storage:'Storage'}[key]}</dt><dd data-no-translate>{value}</dd></div>)}</dl>}
 {d.kind==='event'?<section class="alien-form-section"><h2>When & where</h2><p data-no-translate>{eventDate(d.starts_at)} – {eventDate(d.ends_at,true)}<br/>{d.timezone}{d.all_day?' · Daily times on the official page':''}</p><p>Organizer: <span data-no-translate>{d.organizer}</span></p><a class="alien-button alien-button--yellow" href={d.registration_url} target="_blank" rel="ugc nofollow noopener noreferrer">Official event & registration ↗</a>{d.source_url&&d.source_url!==d.registration_url&&<p><a href={d.source_url} target="_blank" rel="ugc nofollow noopener noreferrer">Source details ↗</a></p>}</section>:<><h2>Delivery</h2><p>{d.delivery.map(v=>deliveryOptions[v]).join(' · ')}</p></>}
 </div><aside class="alien-contact"><section class="alien-contact__member"><span class="alien-eyebrow">{item.source_kind==='official-source'?'Shared by':d.business?'Business member':'Community member'}</span><h2 data-no-translate>{item.seller.name}</h2><a href={`/people/${item.seller.handle}`} data-no-translate>@{item.seller.handle}</a><p class="alien-muted">Member since {new Date(item.seller.joined_at).toLocaleDateString('en',{month:'short',year:'numeric'})}</p>{item.owned?<a class="alien-button alien-button--violet" href={`/aliens-list/new?id=${item.id}`}>Edit your listing</a>:available?<form data-contact-form><label>Message this member<textarea name="message" rows="4" maxlength="4000" required placeholder={d.kind==='wanted'?'I may have what you need…':'Hi, is this still available?'}/></label><button class="alien-button alien-button--violet" type="submit">Send private message ↗</button><small>Free account required. Your email stays private.</small></form>:<p>This listing is {item.status}. Existing conversations remain in Messages.</p>}<p data-status class="alien-status" role="status"></p></section>
 <div class="alien-map alien-map--detail" data-alien-map data-tile-url={runtimeValue(Astro.locals,'ALIENS_MAP_TILES')??undefined} data-map-mode="detail" data-lat={d.lat} data-lon={d.lon} data-has-location="true" aria-label="Approximate listing location"></div><p class="alien-muted">Approximate location. Agree on exact details privately.</p>{d.kind!=='event'&&<p class="alien-muted">Inspect the item and agree on payment and delivery with the member. Super ii does not handle the transaction.</p>}<details class="alien-report"><summary>Report this listing</summary><form data-report-form><label>What should we review?<textarea name="reason" minlength="5" maxlength="2000" rows="3" required/></label><button class="alien-button" type="submit">Send report</button><p role="status" data-report-status></p></form></details></aside></div>
 </article>:<div class="alien-empty"><h1>{unavailable?'This listing could not be loaded.':'This listing is not available.'}</h1><p>{unavailable?'Please try again shortly.':'It may have been removed or made private.'}</p><a class="alien-button" href="/aliens-list">Browse Aliens List</a></div>}
</AliensLayout>
<script>import '@/scripts/aliens/detail';</script>
