---
import AliensLayout from '@/layouts/AliensLayout.astro';
import AlienLocation from '@/components/AlienLocation.astro';
import {runtimeValue} from '@/lib/db';
import {alienSession} from '@/lib/aliens/http';
import {listingDocument,hardwareCategories,eventCategories,conditions,deliveryOptions,type Listing} from '@/lib/aliens/input';
import {countryOptions} from '@/lib/countries';
const auth=typeof Astro.locals.auth==='function'?Astro.locals.auth():null;
if(!auth||!('userId'in auth)||!auth.userId)return Astro.redirect('/sign-in?redirect_url='+encodeURIComponent(Astro.url.pathname+Astro.url.search));
Astro.response.headers.set('cache-control','private, no-store');
let item:Listing|null=null,error='';const id=Astro.url.searchParams.get('id');
if(id){try{if(!/^[a-f0-9-]{36}$/.test(id))throw new Error();const {sql}=await alienSession(Astro.locals);const r=await sql`select app.alien_detail(${id}::uuid) as item`;if(!r[0]?.item?.owned)throw new Error();item=r[0].item;}catch{error='This listing is not available to edit.';Astro.response.status=404;}}
const kind=Astro.url.searchParams.get('kind');const d=item?.document??listingDocument.parse({kind:['sale','wanted','event'].includes(kind??'')?kind:'sale'});
const countries=countryOptions(Astro.locals.locale??'en');
---
<AliensLayout title={item?'Edit your listing':'Post to Aliens List'} noindex>
 {error?<div class="alien-empty"><h1>{error}</h1><a href="/aliens-list/mine">My listings</a></div>:<>
 <div class="alien-intro"><h1>{item?'Your listing':'What would you like to share?'}</h1><p>Start with the essentials. Save a draft whenever you need.</p></div>
 <form class="alien-editor" data-alien-editor data-id={item?.id??''} data-version={item?.version??0} data-published={item?.published_at??undefined} data-document={JSON.stringify(d)} novalidate>
 <div class="alien-editor__fields">
 <fieldset class="alien-kind-picker"><legend>Listing type</legend>{[['sale','▤','For sale'],['wanted','⌕','Wanted'],['event','▦','Event']].map(([value,icon,label])=><label><input type="radio" name="kind" value={value} checked={d.kind===value} disabled={!!item?.published_at&&d.kind!==value}/><span>{icon} {label}</span></label>)}</fieldset>
 <label>Title<input name="title" value={d.title} maxlength="120" placeholder="e.g. Mac Studio M2 Ultra · 128 GB" required/></label>
 <div class="alien-form-grid"><label>Category<select name="category" required><option value="">Choose a category</option>{Object.entries({...hardwareCategories,...eventCategories}).map(([v,label])=><option value={v} data-event-category={String(Object.hasOwn(eventCategories,v))} selected={d.category===v}>{label}</option>)}</select></label><label data-kind-field="hardware">Condition<select name="condition">{Object.entries(conditions).map(([v,label])=><option value={v} selected={d.condition===v}>{label}</option>)}</select></label></div>
 <label>Description<textarea name="description" rows="5" maxlength="6000" placeholder="What is included? What should the next person know?" required>{d.description}</textarea></label>
 <div class="alien-form-grid"><label data-price-label>Price / maximum budget<input type="number" name="amount" value={d.amount??''} min="0" max="1000000000" step="0.01" placeholder="0 for Free"/></label><label>Currency<select name="currency">{Array.from(new Set([d.currency,'USD','CNY','INR','EUR','GBP','JPY','KRW','HKD','SGD','AUD','CAD','AED','BRL','CHF','IDR','MXN','MYR','RUB','THB','TRY','TWD','VND','ZAR',...Intl.supportedValuesOf('currency')])).map(v=><option selected={v===d.currency}>{v}</option>)}</select></label></div>
 <label class="alien-check" data-kind-field="hardware"><input type="checkbox" name="negotiable" checked={d.negotiable}/> Negotiable</label>
 <fieldset data-kind-field="hardware"><legend>Delivery</legend><div class="alien-checks">{Object.entries(deliveryOptions).map(([v,label])=><label class="alien-check"><input type="checkbox" name="delivery" value={v} checked={d.delivery.includes(v as keyof typeof deliveryOptions)}/>{label}</label>)}</div></fieldset>
 <div data-kind-field="event" class="alien-form-section"><p class="alien-notice">Events start with San Francisco and Shenzhen. Link to the organizer’s official page.</p><label>Organizer<input name="organizer" value={d.organizer} maxlength="160"/></label><label>Official event / registration link<input name="registration_url" type="url" value={d.registration_url} placeholder="https://…" maxlength="2048"/></label><label class="alien-check"><input type="checkbox" name="all_day" checked={d.all_day}/> Dates only · daily times are on the official page</label><div class="alien-form-grid"><label>Starts at<input type="datetime-local" name="event_start"/></label><label>Ends at<input type="datetime-local" name="event_end"/></label></div><label>Event time zone<select name="timezone"><option value="America/Los_Angeles" selected={d.timezone==='America/Los_Angeles'}>San Francisco · Pacific time</option><option value="Asia/Shanghai" selected={d.timezone==='Asia/Shanghai'}>Shenzhen · China time</option></select></label><p class="alien-muted">Times are entered in the event’s time zone.</p></div>
 <details class="alien-filters" data-kind-field="hardware"><summary>Technical details <small>optional</small></summary><div class="alien-form-grid">{[['brand','Brand'],['model','Model'],['ram','System / unified memory'],['vram','GPU VRAM'],['chip','CPU / chip'],['storage','Storage']].map(([key,label])=><label>{label}<input name={`spec_${key}`} value={d.specs[key as keyof typeof d.specs]??''} maxlength="160"/></label>)}</div></details>
 <label class="alien-check"><input type="checkbox" name="business" checked={d.business}/> I am posting as a business or organization</label>
 </div>
 <div class="alien-editor__side"><section class="alien-form-section"><h2>Photos</h2><p class="alien-muted">For sale: two different photos of your actual item. Up to 8 photos. JPG, PNG or WebP.</p><label class="alien-upload">＋ Add photos<input type="file" accept="image/jpeg,image/png,image/webp" multiple data-photos/></label><div class="alien-photo-grid" data-photo-grid></div><progress data-upload-progress hidden max="100" value="0" aria-label="Photo upload progress"></progress><label class="alien-check" data-kind-field="hardware"><input type="checkbox" name="original_photos" checked={d.original_photos}/> These are my original photos of this item.</label></section>
 <section class="alien-form-section"><h2>Approximate location</h2><AlienLocation editor city={d.city} country={d.country} lat={d.lat} lon={d.lon}/><label>Country / region<select data-country-select><option value="">Choose</option>{countries.map(({code,label})=><option value={code} selected={code===d.country}>{label}</option>)}</select></label><label>Area <small>optional · no street address</small><input name="area" value={d.area} maxlength="100" placeholder="Neighborhood or district"/></label><div class="alien-map alien-map--editor" data-alien-map data-tile-url={runtimeValue(Astro.locals,'ALIENS_MAP_TILES')??undefined} data-map-mode="editor" data-lat={d.lat??20} data-lon={d.lon??0} data-has-location={String(d.lat!==null)} aria-label="Choose an approximate location"></div><p class="alien-muted">Only an approximate position is saved. Share pickup details privately.</p></section></div>
 <div class="alien-editor__footer"><p class="alien-status" data-status role="status" aria-live="polite"></p><div class="alien-actions">{!item?.published_at&&<button class="alien-button" type="submit" value="save">Save draft</button>}<button class="alien-button alien-button--yellow" type="submit" value="publish">{item?.status==='active'?'Update listing':'Publish free'} ↗</button><a href="/aliens-list/mine">My listings</a></div><small>By publishing, you confirm you can offer this item or share this event. <a href="/aliens-list/guide">Listing guidelines</a></small></div>
 </form></>}
</AliensLayout>
<script>import '@/scripts/aliens/editor';</script>
