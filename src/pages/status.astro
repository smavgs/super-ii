---
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { authIsConfigured } from '@/lib/site';
import { pingDatabase, sqlClient } from '@/lib/db';
import { pingRuntime } from '@/lib/runtime';
import { translateKnown } from '@/lib/i18n';

const locale = Astro.locals.locale ?? 'en';
const display = (value: string) => translateKnown(value, locale);

const authStatus = authIsConfigured(Astro.locals) ? 'Operational' : 'Activation pending';
const databaseHealth = await pingDatabase(Astro.locals);
const databaseStatus = databaseHealth === 'ok' ? 'Operational' : databaseHealth === 'unconfigured' ? 'Activation pending' : 'Degraded';
const runtimeHealth = await pingRuntime(Astro.locals);
const runtimeStatus = runtimeHealth.state === 'ready'
  ? 'Operational'
  : runtimeHealth.state === 'blocked'
    ? 'Connected · publishing blocked'
    : runtimeHealth.state === 'unconfigured'
      ? 'Not connected'
      : 'Unavailable';
const publishingStatus = runtimeHealth.publishing_enabled ? 'Automatic policy checks' : 'Closed safely';
let publicItems = 0;
const sql = sqlClient(Astro.locals);
if (sql) {
  try {
    const rows = await sql`
      select count(*)::integer as item_count
      from app.repositories
      where visibility = 'public' and status = 'published'
    `;
    publicItems = Number(rows[0]?.item_count ?? 0);
  } catch {}
}
const allOperational = authStatus === 'Operational'
  && databaseStatus === 'Operational'
  && runtimeHealth.state === 'ready';
const checkedAt = new Intl.DateTimeFormat(locale === 'ru' ? 'ru-RU' : 'en-US', {
  dateStyle: 'long',
  timeStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date());
---

<BaseLayout title="Status" description="Current operational status for the Super ii website, authentication, database, and public catalogs." noindex>
  <PageHero
    eyebrow="System status"
    title="Super ii service status"
    description="Live status of the Super ii website, accounts, database, publishing and processing services."
    compact
  />

  <section class="section">
    <div class="shell status-board">
      <div class="status-summary">
        <i class:list={['ph', allOperational ? 'ph-check-circle' : 'ph-info']} aria-hidden="true"></i>
        {display(allOperational ? 'Super ii is operating normally' : 'Super ii is online, but one or more services need attention')}
      </div>
      <div class="status-row"><span>Public website</span><span class="status-value">Operational</span></div>
      <div class="status-row"><span>Account authentication</span><span class="status-value">{display(authStatus)}</span></div>
      <div class="status-row"><span>Application database</span><span class="status-value">{display(databaseStatus)}</span></div>
      <div class="status-row"><span>Public catalog</span><span class="status-value">{display('Operational')} · {publicItems.toLocaleString(locale === 'ru' ? 'ru-RU' : 'en-US')} {locale === 'ru' ? 'объектов' : 'items'}</span></div>
      <div class="status-row"><span>Self-hosted runtime</span><span class="status-value">{display(runtimeStatus)}</span></div>
      <div class="status-row"><span>Artifact publishing</span><span class="status-value">{display(publishingStatus)}</span></div>
      <p>Publishing stays closed if any required storage or security check is unavailable. Passing releases publish automatically; failed or unknown checks return actionable reasons.</p>
      <p>Checked at request time: <time datetime={new Date().toISOString()}>{checkedAt} UTC</time></p>
    </div>
  </section>
</BaseLayout>
