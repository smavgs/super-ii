---
import ExploreLayout from '@/layouts/ExploreLayout.astro';
import '@/styles/tools.css';
import BuildShip from '@/components/BuildShip.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';
import type { Workroom } from '@/lib/workrooms';
import { z } from 'zod';
const requested = Astro.url.searchParams.get('workroom');
let room: Workroom | null = null;
if (requested) {
  Astro.response.headers.set('Cache-Control','private, no-store');
  try {
    const sql=sqlClient(Astro.locals);
    if (z.uuid().safeParse(requested).success && sql && await ensureAuthenticatedProfile(Astro.locals,sql)) {
      const rows=await sql`select app.read_workroom(${requested}::uuid) as room`;
      room=rows[0]?.room as Workroom|null;
    }
  } catch { room=null; }
}
const source=room?.repository && room.source_commit && room.repository.revision_status === 'published' && ['model','dataset'].includes(room.repository.kind)
  ? {kind:room.repository.kind,owner_handle:room.repository.owner,slug:room.repository.slug,commit_sha:room.source_commit} : undefined;
---
<ExploreLayout active="build" title="Build & Ship" eyebrow="Make a local project" description="Choose a result, connect published inputs, and prepare a project to run on your computer.">
  <Fragment slot="actions"><a class="button explore-cyan" href="/models"><i class="ph ph-cube" aria-hidden="true"></i>Find a model</a><a class="button button--secondary" href="/docs#build-ship"><i class="ph ph-book-open" aria-hidden="true"></i>Recipe guide</a></Fragment>
  <div class="shell tools-content">
    {room && <p class="tools-notice"><a href={`/workspace/workrooms/${room.id}`}>← {room.document.title}</a></p>}
    {requested && !room && <p class="tools-notice" role="status">The requested workroom is unavailable. You can still prepare a project below.</p>}
    <BuildShip expanded standalone source={source} workroomId={room?.can_edit?room.id:undefined} />
  </div>
</ExploreLayout>
