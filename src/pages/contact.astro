---
import CommunicationsHeading from '@/components/CommunicationsHeading.astro';
import CommunicationsLayout from '@/layouts/CommunicationsLayout.astro';

export const prerender = false;
---

<CommunicationsLayout active="contact" title="Contact" description="Contact Super ii about joining the Founding Circle, creator access, plans, enterprise requirements, security, privacy, or launch feedback.">
  <CommunicationsHeading
    audience="Message the Super ii team"
    title="Contact"
    description="Tell us what you need help with or what you would like to build together."
  />

  <section class="section">
    <div class="shell">
      <form class="form-card" data-contact-form>
        <div class="form-grid">
          <div class="field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required />
          </div>
          <div class="field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="field field--full">
            <label for="contact-interest">What can we help with?</label>
            <select id="contact-interest" name="interest" required>
              <option value="" selected disabled>Choose a topic</option>
              <option value="founding-circle">Join the Founding Circle</option>
              <option value="founding-team">Founding Team</option>
              <option value="creator">Creator and publishing access</option>
              <option value="pro">Pro plan</option>
              <option value="team">Team plan</option>
              <option value="enterprise">Enterprise proposal</option>
              <option value="security">Security report</option>
              <option value="privacy">Privacy request</option>
              <option value="feedback">Partnerships and feedback</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" maxlength="4000" required></textarea>
            <small>Please never send passwords, private keys, API keys, private files, health data or government identifiers.</small>
          </div>
        </div>
        <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button button--dark" type="submit"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>Send message</button>
        <p class="form-status" data-form-status hidden aria-live="polite"></p>
      </form>
    </div>
  </section>
</CommunicationsLayout>
