---
import ExploreLayout from '@/layouts/ExploreLayout.astro';
import '@/styles/guides.css';
import BrandMark from '@/components/BrandMark.astro';
import InfoTip from '@/components/InfoTip.astro';
import JourneyLabel from '@/components/JourneyLabel.astro';
import { officialNotebooks } from '@/lib/notebooks';

export const prerender = false;
---

<ExploreLayout active="notebooks" title="Notebooks" eyebrow="Learn · Official notebooks" titleHelp="notebook" description="Learn through small, reproducible examples. Read safely on Super ii; choose explicitly when and where to run code.">
  <Fragment slot="actions"><a class="button explore-cyan" href="/docs#notebooks"><i class="ph ph-shield-check" aria-hidden="true"></i>Read the safety model</a></Fragment>

  <section class="shell notebook-library" id="official-notebooks" data-explore-filter>
    <div class="section-heading">
      <p class="eyebrow">Versioned tutorials</p>
      <h2>Start with the fundamentals.</h2>
      <p>Each notebook is versioned, checked for validity, safe to read without running code, and designed to work without a paid Super ii service.</p>
    </div>

    <label class="guide-search"><span>Find a notebook</span><input type="search" placeholder="Search by topic or runtime" data-explore-search /></label>
    <p class="guide-result-count" data-explore-count aria-live="polite">{officialNotebooks.length} / {officialNotebooks.length}</p>
    <div class="notebook-library__grid">
      {officialNotebooks.map((notebook, index) => (
        <article class="notebook-card" data-explore-item data-search={`${notebook.title} ${notebook.summary} ${notebook.category} ${notebook.runtime} ${notebook.tags.join(" ")}`}>
          <div class="notebook-card__topline"><JourneyLabel kind="item" current={index + 1} /><span>{notebook.category}</span></div>
          <div>
            <p class="eyebrow">{notebook.level} · {notebook.durationMinutes} min</p>
            <h3><a href={`/notebooks/${notebook.slug}`}>{notebook.title}</a></h3>
            <p>{notebook.summary}</p>
          </div>
          <dl>
            <div><dt>Runtime</dt><dd>{notebook.runtime}</dd></div>
            <div><dt>Needs</dt><dd>{notebook.requirements.join(' · ')}</dd></div>
          </dl>
          <div class="notebook-card__tags">{notebook.tags.map((tag) => <span>{tag}</span>)}</div>
          <a class="button explore-cyan" href={`/notebooks/${notebook.slug}`}>Read notebook <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </article>
      ))}
    </div>
    <div class="empty-state" data-explore-empty hidden><p>No notebooks match this search.</p><button type="button" class="button button--secondary" data-explore-reset>Clear search</button></div>
  </section>
  <section class="shell guide-intro">
    <details class="explore-panel" id="notebook-safety"><summary><i class="ph ph-shield-check" aria-hidden="true"></i>Reading, source & execution</summary>
    <div class="notebook-principles">
      <article><i class="ph ph-shield-check" aria-hidden="true"></i><div class="heading-with-help"><h3>Static on Super ii</h3><InfoTip term="staticNotebook" /></div><p>Super ii shows the notebook text, code and safe outputs without running it. Active web content and automatic code execution stay off.</p></article>
      <article><i class="ph ph-git-commit" aria-hidden="true"></i><div class="heading-with-help"><h3>Exact source</h3><InfoTip term="checksum" /></div><p>Every official notebook has a recorded checksum and source link, so you can verify exactly which version you are reading.</p></article>
      <article><BrandMark brand="colab" size="md" label="Google Colab" /><h3>Clear handoff</h3><p>Colab links are external execution paths, visibly separated from Super ii's static reader and governed by the external provider.</p></article>
    </div>
  </details>
  </section>
</ExploreLayout>
