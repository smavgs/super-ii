---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NotebookDocument from '@/components/NotebookDocument.astro';
import { getOfficialNotebook, officialNotebooks } from '@/lib/notebooks';

export const prerender = true;

export function getStaticPaths() {
  return officialNotebooks.map((notebook) => ({ params: { slug: notebook.slug } }));
}

const tutorial = getOfficialNotebook(Astro.params.slug);
if (!tutorial) Astro.response.status = 404;
---

<BaseLayout
  title={tutorial?.meta.title ?? 'Notebook unavailable'}
  description={tutorial?.meta.summary ?? 'This official Super ii notebook is unavailable.'}
  noindex={!tutorial}
  className="notebook-page"
>
  {tutorial ? (
    <div class="shell notebook-page__shell">
      <NotebookDocument
        notebook={tutorial.notebook}
        backHref="/notebooks"
        backLabel="All notebooks"
        downloadUrl={tutorial.downloadUrl}
        sha256={tutorial.meta.sha256}
        githubUrl={tutorial.githubUrl}
        colabUrl={tutorial.colabUrl}
        official
      />
    </div>
  ) : (
    <section class="section shell"><h1>Notebook unavailable</h1><p>This tutorial could not be found.</p></section>
  )}
</BaseLayout>
