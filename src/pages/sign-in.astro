---
import { SignIn } from '@clerk/astro/components';
import AuthStory from '@/components/AuthStory.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedHref, localizedPath, stripLocalePrefix } from '@/lib/i18n';
import { authIsConfigured } from '@/lib/site';

const authConfigured = authIsConfigured(Astro.locals);
const locale = Astro.locals.locale ?? 'en';
const aiWorkerRedirect = '/account?welcome=ai-worker#ai-worker';
const agentAccessRedirect = '/account#agents';
const skillsRedirect = '/skills';
const frontierRedirect = '/frontier-ai';
const frontierSetupRedirect = '/frontier-ai#setup';
const allowedRedirects = new Set([
  aiWorkerRedirect,
  agentAccessRedirect,
  skillsRedirect,
  frontierRedirect,
  frontierSetupRedirect,
]);
const requestedRedirect = Astro.url.searchParams.get('redirect_url');
const requestedPlainRedirect = requestedRedirect ? stripLocalePrefix(requestedRedirect) : null;
const plainPostSignInRedirect = requestedPlainRedirect && allowedRedirects.has(requestedPlainRedirect)
  ? requestedPlainRedirect
  : '/account';
const postSignInRedirect = localizedHref(plainPostSignInRedirect, locale);
const plainSignUpUrl = plainPostSignInRedirect === '/account'
  ? '/sign-up'
  : `/sign-up?redirect_url=${encodeURIComponent(plainPostSignInRedirect)}`;
const signUpUrl = locale === 'ru' ? `/ru${plainSignUpUrl}` : plainSignUpUrl;
---

<BaseLayout title="Log in" description="Log in to Super ii with email, Google, or GitHub." noindex className="auth-body">
  <div class="auth-page">
    <AuthStory mode="sign-in" />
    <section class="auth-panel">
      <div class="auth-panel__inner">
        <h2>Log in to Super ii</h2>
        <p>Use the fastest secure option for you.</p>
        {authConfigured ? (
          <SignIn
            routing="path"
            path={localizedPath('/sign-in', locale)}
            signUpUrl={signUpUrl}
            forceRedirectUrl={postSignInRedirect}
            fallbackRedirectUrl={postSignInRedirect}
            appearance={{
              elements: {
                rootBox: 'sii-clerk-root',
                cardBox: 'sii-clerk-card',
              },
              variables: {
                colorPrimary: '#071a2f',
                borderRadius: '12px',
              },
            }}
          />
        ) : (
          <div class="auth-placeholder">
            <h3>Account activation is being connected</h3>
            <p>Account access is temporarily unavailable. Please try again later.</p>
            <a class="button button--secondary button--block" href="/">Return home</a>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
