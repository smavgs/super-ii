---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CreatorLink from '@/components/CreatorLink.astro';
import PageHero from '@/components/PageHero.astro';
import { sqlClient } from '@/lib/db';

type Paper = { owner: string; owner_name: string; owner_avatar_url: string | null; slug: string; title: string; abstract: string; doi: string | null; published_on: string | null; created_at: string; repository_count: number };
const sql = sqlClient(Astro.locals);
const dateLocale = Astro.locals.locale === 'ru' ? 'ru-RU' : 'en';
let papers: Paper[] = [];
let unavailable = false;
if (sql) {
  try {
    papers = await sql`
      select profile.handle as owner, profile.display_name as owner_name,
             profile.avatar_url as owner_avatar_url, paper.slug, paper.title, paper.abstract, paper.doi,
             paper.published_on, paper.created_at,
             (select count(*)::integer from app.paper_repository_links link where link.paper_id = paper.id) as repository_count
      from app.papers paper join app.profiles profile on profile.id = paper.owner_profile_id and profile.is_public
      where paper.is_public order by coalesce(paper.published_on::timestamptz, paper.created_at) desc limit 100
    ` as Paper[];
  } catch { unavailable = true; }
}
---

<BaseLayout title="Papers" description="Research papers connected to real Super ii models, datasets, and apps.">
  <PageHero eyebrow="Research and evidence 📄" title="Papers connected to working repositories." description="Share research and connect it to the models, datasets and apps it describes, uses or evaluates." compact><div class="button-row"><a class="button button--dark" href="/papers/new">Publish a paper</a><a class="button button--secondary" href="/feed">Open community feed</a></div></PageHero>
  <main class="section shell">
    {papers.length ? <div class="content-card-grid">{papers.map((paper) => <article class="content-card"><div class="content-card__byline"><CreatorLink compact handle={paper.owner} displayName={paper.owner_name} avatarUrl={paper.owner_avatar_url} /><span>{paper.repository_count} linked repositories</span></div><h2><a class="content-card__title-link" href={`/papers/${encodeURIComponent(paper.owner)}/${encodeURIComponent(paper.slug)}`}>{paper.title}</a></h2><p>{paper.abstract}</p><span>{paper.doi ? `DOI ${paper.doi}` : paper.published_on ? new Date(paper.published_on).toLocaleDateString(dateLocale, { dateStyle: 'medium' }) : 'Publication date not declared'}</span><a class="content-card__open" href={`/papers/${encodeURIComponent(paper.owner)}/${encodeURIComponent(paper.slug)}`}>Read paper <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></article>)}</div> : <div class="empty-state"><div class="empty-state__icon"><i class="ph ph-file-text" aria-hidden="true"></i></div><h2>{unavailable ? 'Papers are temporarily unavailable.' : 'Publish the first paper'}</h2><p>{unavailable ? 'Please try again shortly.' : 'Connect a real paper to reviewed public repositories.'}</p><a class="button button--dark" href="/papers/new">Publish a paper</a></div>}
  </main>
</BaseLayout>
