---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sqlClient } from '@/lib/db';
import { kindPath } from '@/lib/repository';
import type { RepositoryKind } from '@/lib/catalog';
type PaperView = { title: string; abstract: string; canonical_url: string | null; doi: string | null; published_on: string | null; owner: string; repositories: Array<{ kind: RepositoryKind; owner_handle: string; slug: string; title: string; relationship_type: string }> };
const sql = sqlClient(Astro.locals); let paper: PaperView | null = null;
if (sql) { try { const rows = await sql`select paper.title, paper.abstract, paper.canonical_url, paper.doi, paper.published_on, profile.handle as owner, coalesce((select jsonb_agg(jsonb_build_object('kind', repository.kind, 'owner_handle', repository.owner_handle, 'slug', repository.slug, 'title', repository.title, 'relationship_type', link.relationship_type) order by link.relationship_type) from app.paper_repository_links link join app.repositories repository on repository.id = link.repository_id where link.paper_id = paper.id and repository.visibility = 'public' and repository.status = 'published'), '[]'::jsonb) as repositories from app.papers paper join app.profiles profile on profile.id = paper.owner_profile_id where lower(profile.handle) = lower(${Astro.params.owner ?? ''}) and lower(paper.slug) = lower(${Astro.params.slug ?? ''}) and paper.is_public limit 1`; paper = (rows[0] as PaperView | undefined) ?? null; } catch { paper = null; } }
if (!paper) Astro.response.status = 404;
---
<BaseLayout title={paper?.title ?? 'Paper unavailable'} description={paper?.abstract ?? 'Public paper unavailable.'} noindex={!paper}>
  {paper ? <main class="shell repository-page"><header class="repository-header"><p class="eyebrow">Research paper 📄</p><p class="repository-path">@{paper.owner}</p><h1>{paper.title}</h1><p>{paper.abstract}</p><div class="repository-badges">{paper.doi && <span>DOI {paper.doi}</span>}{paper.published_on && <span>{new Date(paper.published_on).toLocaleDateString('en', { dateStyle: 'long' })}</span>}</div>{paper.canonical_url && <a class="button button--dark" href={paper.canonical_url} rel="canonical external">Read canonical paper</a>}</header><section class="repository-section"><div class="repository-section__heading"><div><p class="eyebrow">Evidence graph</p><h2>Connected repositories</h2></div></div>{paper.repositories.length ? <div class="content-card-grid">{paper.repositories.map((repository) => <a class="content-card" href={`/${kindPath(repository.kind)}/${repository.owner_handle}/${repository.slug}`}><p class="eyebrow">{repository.relationship_type} · {repository.kind}</p><h3>{repository.title}</h3><span>{repository.owner_handle}/{repository.slug}</span></a>)}</div> : <p>No reviewed public repository is linked yet.</p>}</section></main> : <main class="section shell"><div class="empty-state"><h1>Paper not found</h1><a class="button button--secondary" href="/papers">Browse papers</a></div></main>}
</BaseLayout>
