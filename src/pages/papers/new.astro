---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';
const sql = sqlClient(Astro.locals);
let repositories: Array<{ id: string; owner_handle: string; slug: string; kind: string }> = [];
if (sql) {
  try {
    const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
    if (profile) repositories = await sql`select id, owner_handle, slug, kind from app.repositories where visibility = 'public' and status = 'published' order by updated_at desc limit 200` as typeof repositories;
  } catch { repositories = []; }
}
---
<BaseLayout title="Publish paper" description="Publish research metadata and link it to Super ii repositories." noindex>
  <PageHero eyebrow="Research publishing 📄" title="Publish a paper" description="Use canonical metadata and connect the paper to the real repositories it introduces, trains, evaluates, references, or reproduces." compact />
  <main class="section shell creator-shell"><form class="form-card creator-form" data-paper-form>
    <div class="form-grid form-grid--two"><label>Slug <input name="slug" required maxlength="96" pattern="[a-z0-9][a-z0-9._-]{0,94}[a-z0-9]|[a-z0-9]" placeholder="open-model-evaluation" /></label><label>Published on <input name="published_on" type="date" /></label></div>
    <label>Title <input name="title" required minlength="3" maxlength="300" /></label>
    <label>Abstract <textarea name="abstract" required minlength="10" maxlength="20000" rows="10"></textarea></label>
    <div class="form-grid form-grid--two"><label>Canonical URL <span>(optional)</span><input name="canonical_url" type="url" maxlength="2048" placeholder="https://arxiv.org/abs/…" /></label><label>DOI <span>(optional)</span><input name="doi" maxlength="300" placeholder="10.1234/example" /></label></div>
    <label>Related public repository <span>(optional)</span><select name="repository_id"><option value="">None</option>{repositories.map((repository) => <option value={repository.id}>{repository.kind} · {repository.owner_handle}/{repository.slug}</option>)}</select></label>
    <label>Relationship <select name="relationship_type"><option value="introduces">Introduces</option><option value="trains">Trains</option><option value="evaluates">Evaluates</option><option value="references">References</option><option value="reproduces">Reproduces</option></select></label>
    <div class="form-actions"><button class="button button--dark" type="submit">Publish paper</button><a class="button button--secondary" href="/papers">Cancel</a></div><p class="form-status" data-form-status aria-live="polite"></p>
  </form></main>
</BaseLayout>
<script>
  const form = document.querySelector('[data-paper-form]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault(); if (!(form instanceof HTMLFormElement)) return;
    const submit = form.querySelector('button[type="submit"]'); const status = form.querySelector('[data-form-status]'); if (submit instanceof HTMLButtonElement) submit.disabled = true;
    try { const data = new FormData(form); const repositoryId = String(data.get('repository_id') ?? ''); const response = await fetch('/api/papers', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: data.get('slug'), title: data.get('title'), abstract: data.get('abstract'), canonical_url: data.get('canonical_url'), doi: data.get('doi'), published_on: data.get('published_on'), repository_links: repositoryId ? [{ repository_id: repositoryId, relationship_type: data.get('relationship_type') }] : [] }) }); const result = await response.json() as Record<string, unknown>; if (!response.ok || typeof result.href !== 'string') throw new Error(typeof result.error === 'string' ? result.error : 'Paper could not be published.'); location.assign(result.href); }
    catch (error) { if (status instanceof HTMLElement) { status.textContent = error instanceof Error ? error.message : 'Paper could not be published.'; status.dataset.state = 'error'; } if (submit instanceof HTMLButtonElement) submit.disabled = false; }
  });
</script>
