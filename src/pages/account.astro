---
import { Show, SignInButton, UserProfile } from '@clerk/astro/components';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { authIsConfigured } from '@/lib/site';

const authConfigured = authIsConfigured(Astro.locals);
---

<BaseLayout title="Account" description="Manage your Super ii account, security, organizations, and plan preferences." noindex>
  <PageHero eyebrow="Your workspace" title="Account" description="Manage your identity, security, organizations, and launch access." compact />
  <section class="shell account-shell">
    <nav class="account-nav" aria-label="Account sections">
      <a href="/account" aria-current="page">Profile</a>
      <a href="/organizations">Organizations</a>
      <a href="/pricing">Plans</a>
    </nav>

    <div>
      {authConfigured ? (
        <>
          <Show when="signed-out">
            <div class="account-card">
              <h2>Log in to continue</h2>
              <p>Your account settings are available after authentication.</p>
              <SignInButton mode="modal">
                <button class="button button--dark" type="button">Log in</button>
              </SignInButton>
            </div>
          </Show>
          <Show when="signed-in">
            <UserProfile
              routing="hash"
              appearance={{
                elements: {
                  rootBox: 'sii-clerk-profile-root',
                  cardBox: 'sii-clerk-profile-card',
                },
                variables: {
                  colorPrimary: '#071a2f',
                  borderRadius: '12px',
                },
              }}
            />
          </Show>
        </>
      ) : (
        <div class="account-card">
          <h2>Account activation is pending</h2>
          <p>The account interface is ready and will become available as soon as the production identity application is connected.</p>
          <a class="button button--secondary" href="/">Return home</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
