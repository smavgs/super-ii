---
import { Show, SignInButton, UserProfile } from '@clerk/astro/components';
import AgentStarter from '@/components/AgentStarter.astro';
import AgentWorkspace from '@/components/AgentWorkspace.astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { authIsConfigured } from '@/lib/site';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';

const authConfigured = authIsConfigured(Astro.locals);
const sql = sqlClient(Astro.locals);
let repositories: Array<{ id: string; kind: string; owner_handle: string; slug: string; title: string; status: string; revision_status: string }> = [];
let organizations: Array<{ handle: string; full_name: string; role: string }> = [];
let notifications: Array<{ id: string; title: string; body: string; href: string | null; read_at: string | null; created_at: string }> = [];
let subscriptions: Array<{ plan_id: string; status: string; current_period_end: string | null; owner_label: string }> = [];
let payments: Array<{ id: string; plan_id: string; price_amount_cents: number; status: string; created_at: string }> = [];
let bridgeSources: Array<{
  repository_id: string;
  provider_repo_id: string;
  source_url: string;
  source_revision: string;
  source_visibility: string;
  imported_at: string;
  sync_enabled: boolean;
}> = [];
if (sql) {
  try {
    const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
    if (profile) {
      repositories = await sql`
        select r.id, r.kind, r.owner_handle, r.slug, r.title, r.status, rr.status as revision_status
        from app.repositories r
        join app.repository_revisions rr on rr.id = coalesce(
          (select b.head_revision_id from app.repository_branches b where b.repository_id = r.id and b.is_default limit 1),
          r.latest_revision_id
        )
        where r.owner_profile_id = ${profile.profileId}::uuid
          or exists (
            select 1 from app.organization_members m
            where m.organization_id = r.owner_organization_id
              and m.profile_id = ${profile.profileId}::uuid
              and m.role in ('owner', 'admin', 'maintainer')
          )
        order by r.updated_at desc limit 50
      ` as typeof repositories;
      organizations = await sql`
        select o.handle, coalesce(o.full_name, o.name) as full_name, m.role
        from app.organization_members m
        join app.organizations o on o.id = m.organization_id
        where m.profile_id = ${profile.profileId}::uuid
        order by o.handle
      ` as typeof organizations;
      notifications = await sql`
        select id, title, body, href, read_at, created_at
        from app.notifications where profile_id = ${profile.profileId}::uuid
        order by created_at desc limit 20
      ` as typeof notifications;
      subscriptions = await sql`
        select s.plan_id, s.status, s.current_period_end,
               coalesce('@' || o.handle, 'Personal') as owner_label
        from app.subscriptions s
        left join app.profiles p on p.clerk_user_id = s.clerk_user_id
        left join app.organizations o
          on o.id = s.organization_id
          or (s.clerk_organization_id is not null and o.clerk_organization_id = s.clerk_organization_id)
        where p.id = ${profile.profileId}::uuid
          or exists (
            select 1 from app.organization_members member
            where member.organization_id = o.id and member.profile_id = ${profile.profileId}::uuid
          )
        order by s.updated_at desc limit 10
      ` as typeof subscriptions;
      payments = await sql`
        select id, plan_id, price_amount_cents, status, created_at
        from app.payment_orders where profile_id = ${profile.profileId}::uuid
        order by created_at desc limit 10
      ` as typeof payments;
      bridgeSources = await sql`
        select distinct on (source.repository_id)
          source.repository_id, source.provider_repo_id, source.source_url,
          source.source_revision, item.source_visibility, source.imported_at,
          coalesce(subscription.enabled, false) as sync_enabled
        from app.repository_sources source
        join app.repositories repository on repository.id = source.repository_id
        join app.bridge_import_items item on item.revision_id = source.revision_id
        left join app.bridge_sync_subscriptions subscription
          on subscription.repository_id = source.repository_id
          and subscription.provider = source.provider
          and subscription.provider_repo_id = source.provider_repo_id
        where source.destination_profile_id = ${profile.profileId}::uuid
          and repository.owner_profile_id = ${profile.profileId}::uuid
        order by source.repository_id, source.imported_at desc
      ` as typeof bridgeSources;
    }
  } catch {
    repositories = [];
  }
}
---

<BaseLayout title="Workspace" description="Manage your repositories, organizations, agents, imports, notifications, plan and account settings in one place." noindex>
  <PageHero eyebrow="Your workspace" title="Workspace" description="Manage your repositories, organizations, agents, imports, notifications, plan and account settings in one place." compact />
  <section class="shell account-shell">
    <nav class="account-nav" aria-label="Account sections">
      <a href="#agent-starter">Agent Starter</a>
      <a href="#agents">Agents</a>
      <a href="/account" aria-current="page">Profile</a>
      <a href="/bring-my-work">Bring my work</a>
      <a href="/new">Repositories</a>
      <a href="/organizations">Organizations</a>
      <a href="/pricing">Plans</a>
    </nav>

    <div>
      {authConfigured ? (
        <>
          <Show when="signed-out">
            <div class="account-card">
              <h2>Log in to continue</h2>
              <p>Your account settings are available after authentication.</p>
              <SignInButton asChild mode="modal">
                <button class="button button--dark" type="button">Log in</button>
              </SignInButton>
            </div>
          </Show>
          <Show when="signed-in">
            <div class="account-workspace">
              <AgentStarter />
              <AgentWorkspace />
              <section class="account-card">
                <div class="repository-section__heading"><div><p class="eyebrow">Creator workspace 🚀</p><h2>Your repositories</h2></div><a class="button button--dark button--small" href="/new">New repository</a></div>
                {repositories.length ? <div class="account-list">{repositories.map((repository) => <a href={`/repositories/${repository.id}/edit`}><span><strong>{repository.owner_handle}/{repository.slug}</strong><small>{repository.kind} · {repository.revision_status}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div> : <div><p>You do not have a repository yet. Start fresh or bring work you already built.</p><div class="button-row"><a class="button button--dark button--small" href="/bring-my-work">Bring my work</a><a class="button button--secondary button--small" href="/new">Create from scratch</a></div></div>}
              </section>
              <section class="account-card">
                <div class="repository-section__heading"><div><p class="eyebrow">Teams 🏢</p><h2>Organizations</h2></div><a class="button button--secondary button--small" href="/organizations/new">New organization</a></div>
                {organizations.length ? <div class="account-list">{organizations.map((organization) => <a href={`/organizations/${organization.handle}`}><span><strong>{organization.full_name}</strong><small>@{organization.handle} · {organization.role}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div> : <p>You do not belong to an organization yet.</p>}
              </section>
              {bridgeSources.length > 0 && <section class="account-card">
                <div class="repository-section__heading"><div><p class="eyebrow">Bridge sync 🌉</p><h2>Imported sources</h2></div><a class="button button--secondary button--small" href="/bring-my-work">Open Bridge</a></div>
                <p>When Super ii finds a new public source version, it imports it as a new revision and waits for your review before publishing.</p>
                <div class="account-list account-list--static bridge-source-list">
                  {bridgeSources.map((source) => <div>
                    <span>
                      <strong>{source.provider_repo_id}</strong>
                      <small>{source.source_visibility} · revision {source.source_revision.slice(0, 8)} · imported {new Date(source.imported_at).toLocaleDateString('en', { dateStyle: 'medium' })}</small>
                    </span>
                    {source.source_visibility === 'public' ? <button class:list={['button', 'button--small', source.sync_enabled ? 'button--secondary' : 'button--dark']} type="button" data-bridge-sync={source.repository_id} data-enabled={String(source.sync_enabled)}>{source.sync_enabled ? 'Pause checks' : 'Check for updates'}</button> : <span class="status-badge">manual only</span>}
                  </div>)}
                </div>
                <p class="form-status" data-bridge-sync-status aria-live="polite"></p>
              </section>}
              <section class="account-card">
                <div class="repository-section__heading"><div><p class="eyebrow">Notifications 🔔</p><h2>Recent activity</h2></div></div>
                {notifications.length ? <div class="notification-list">{notifications.map((notification) => <article data-notification={notification.id} data-read={String(Boolean(notification.read_at))}><div><strong>{notification.title}</strong><p>{notification.body}</p><time datetime={notification.created_at}>{new Date(notification.created_at).toLocaleString('en', { dateStyle: 'medium', timeStyle: 'short' })}</time></div>{notification.href && <a href={notification.href}>Open</a>}{!notification.read_at && <button class="text-button" type="button" data-mark-read>Mark read</button>}</article>)}</div> : <p>No notifications yet.</p>}
              </section>
              <section class="account-card">
                <div class="repository-section__heading"><div><p class="eyebrow">Plan and payments 💳</p><h2>Billing</h2></div><a class="button button--secondary button--small" href="/pricing">View plans</a></div>
                {subscriptions.length ? <div class="account-list account-list--static">{subscriptions.map((subscription) => <div><span><strong>{subscription.plan_id}</strong><small>{subscription.owner_label} · {subscription.status}{subscription.current_period_end ? ` · through ${new Date(subscription.current_period_end).toLocaleDateString('en', { dateStyle: 'medium' })}` : ''}</small></span></div>)}</div> : <p>No active paid plan.</p>}
                {payments.length > 0 && <div class="payment-history"><h3>Payment history</h3>{payments.map((payment) => <a href={`/checkout/${payment.id}`}><span>{payment.plan_id} · ${(payment.price_amount_cents / 100).toFixed(2)} USD</span><strong>{payment.status}</strong></a>)}</div>}
              </section>
              <section class="account-card"><p class="eyebrow">Identity and security</p><h2>Profile settings</h2><UserProfile
                routing="hash"
                appearance={{
                  elements: {
                    rootBox: 'sii-clerk-profile-root',
                    cardBox: 'sii-clerk-profile-card',
                  },
                  variables: {
                    colorPrimary: '#071a2f',
                    borderRadius: '12px',
                  },
                }}
              /></section>
            </div>
          </Show>
        </>
      ) : (
        <div class="account-card">
          <h2>Account activation is pending</h2>
          <p>Account access is temporarily unavailable. Please try again later.</p>
          <a class="button button--secondary" href="/">Return home</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('[data-notification] [data-mark-read]').forEach((button) => {
    button.addEventListener('click', async () => {
      const notification = button.closest('[data-notification]');
      if (!(button instanceof HTMLButtonElement) || !(notification instanceof HTMLElement)) return;
      button.disabled = true;
      const response = await fetch(`/api/notifications/${notification.dataset.notification}`, { method: 'POST' });
      if (response.ok) {
        notification.dataset.read = 'true';
        button.remove();
      } else {
        button.disabled = false;
      }
    });
  });

  const syncStatus = document.querySelector('[data-bridge-sync-status]');
  document.querySelectorAll('[data-bridge-sync]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const enabled = button.dataset.enabled !== 'true';
      button.disabled = true;
      if (syncStatus) syncStatus.textContent = enabled ? 'Enabling public-source checks…' : 'Pausing source checks…';
      const response = await fetch('/api/bridge/sync', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ repository_id: button.dataset.bridgeSync, enabled }),
      });
      if (response.ok) {
        button.dataset.enabled = String(enabled);
        button.textContent = enabled ? 'Pause checks' : 'Check for updates';
        button.classList.toggle('button--dark', !enabled);
        button.classList.toggle('button--secondary', enabled);
        if (syncStatus) syncStatus.textContent = enabled ? 'Public-source checks are on. New revisions will still require review.' : 'Source checks are paused.';
      } else {
        if (syncStatus) syncStatus.textContent = 'This source could not be changed. Only public imported sources can sync.';
      }
      button.disabled = false;
    });
  });
</script>
