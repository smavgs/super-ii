---
import { Show, SignInButton, UserProfile } from '@clerk/astro/components';
import MemberWorkspace from '@/components/MemberWorkspace.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { authIsConfigured } from '@/lib/site';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import { sqlClient } from '@/lib/db';

type MemberProfile = {
  id: string;
  handle: string;
  display_name: string;
  bio: string | null;
  avatar_url: string | null;
  interests: string[];
  x_username: string | null;
  github_username: string | null;
  linkedin_url: string | null;
  website_url: string | null;
  youtube_url: string | null;
};

const authConfigured = authIsConfigured(Astro.locals);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const sql = sqlClient(Astro.locals);
let repositories: Array<{ id: string; kind: string; owner_handle: string; slug: string; title: string; status: string; revision_status: string }> = [];
let notifications: Array<{ id: string; title: string; body: string; href: string | null; read_at: string | null; created_at: string }> = [];
let subscriptions: Array<{ plan_id: string; status: string; current_period_end: string | null; owner_label: string }> = [];
let payments: Array<{ id: string; plan_id: string; billing_term: string; price_amount_cents: number; status: string; created_at: string }> = [];
let bridgeSources: Array<{
  repository_id: string;
  provider_repo_id: string;
  source_url: string;
  source_revision: string;
  source_visibility: string;
  imported_at: string;
  sync_enabled: boolean;
}> = [];
let memberProfile: MemberProfile | null = null;
let unavailable = !sql;
if (sql) {
  try {
    const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
    if (profile) {
      const profileRows = await sql`
        select id, handle, display_name, bio, avatar_url, interests,
               x_username, github_username, linkedin_url, website_url, youtube_url
        from app.profiles
        where id = ${profile.profileId}::uuid
        limit 1
      `;
      memberProfile = (profileRows[0] as MemberProfile | undefined) ?? null;
      repositories = await sql`
        select r.id, r.kind, r.owner_handle, r.slug, r.title, r.status, rr.status as revision_status
        from app.repositories r
        join app.repository_revisions rr on rr.id = coalesce(
          (select b.head_revision_id from app.repository_branches b where b.repository_id = r.id and b.is_default limit 1),
          r.latest_revision_id
        )
        where r.owner_profile_id = ${profile.profileId}::uuid
          or exists (
            select 1 from app.organization_members m
            where m.organization_id = r.owner_organization_id
              and m.profile_id = ${profile.profileId}::uuid
              and m.role in ('owner', 'admin', 'maintainer')
          )
        order by r.updated_at desc limit 50
      ` as typeof repositories;
      notifications = await sql`
        select id, title, body, href, read_at, created_at
        from app.notifications where profile_id = ${profile.profileId}::uuid
        order by created_at desc limit 20
      ` as typeof notifications;
      subscriptions = await sql`
        select s.plan_id, s.status, s.current_period_end,
               coalesce('@' || o.handle, 'Personal') as owner_label
        from app.subscriptions s
        left join app.profiles p on p.clerk_user_id = s.clerk_user_id
        left join app.organizations o
          on o.id = s.organization_id
          or (s.clerk_organization_id is not null and o.clerk_organization_id = s.clerk_organization_id)
        where p.id = ${profile.profileId}::uuid
          or exists (
            select 1 from app.organization_members member
            where member.organization_id = o.id and member.profile_id = ${profile.profileId}::uuid
          )
        order by s.updated_at desc limit 10
      ` as typeof subscriptions;
      payments = await sql`
        select id, plan_id, billing_term, price_amount_cents, status, created_at
        from app.payment_orders where profile_id = ${profile.profileId}::uuid
        order by created_at desc limit 10
      ` as typeof payments;
      bridgeSources = await sql`
        select distinct on (source.repository_id)
          source.repository_id, source.provider_repo_id, source.source_url,
          source.source_revision, item.source_visibility, source.imported_at,
          coalesce(subscription.enabled, false) as sync_enabled
        from app.repository_sources source
        join app.repositories repository on repository.id = source.repository_id
        join app.bridge_import_items item on item.revision_id = source.revision_id
        left join app.bridge_sync_subscriptions subscription
          on subscription.repository_id = source.repository_id
          and subscription.provider = source.provider
          and subscription.provider_repo_id = source.provider_repo_id
        where source.destination_profile_id = ${profile.profileId}::uuid
          and repository.owner_profile_id = ${profile.profileId}::uuid
        order by source.repository_id, source.imported_at desc
      ` as typeof bridgeSources;
    }
  } catch {
    unavailable = true;
  }
}
---

<BaseLayout title="Workspace" description="Your work, tools and account." noindex>
  {authConfigured ? <>
    <Show when="signed-out">
      <section class="shell member-workspace"><h1>Workspace</h1><div class="account-card"><h2>Log in to continue</h2><p>Your work and account settings are available after authentication.</p><SignInButton asChild mode="modal"><button class="button button--dark" type="button">Log in</button></SignInButton></div></section>
    </Show>
    <Show when="signed-in">
      <MemberWorkspace {repositories} {notifications} {bridgeSources} {subscriptions} {payments} {memberProfile} {unavailable}>
        <UserProfile slot="identity" routing="hash" appearance={{
          elements: { rootBox: 'sii-clerk-profile-root', cardBox: 'sii-clerk-profile-card' },
          variables: { colorPrimary: '#071a2f', borderRadius: '12px' },
        }} />
      </MemberWorkspace>
    </Show>
  </> : <section class="shell member-workspace"><h1>Workspace</h1><div class="account-card"><h2>Account activation is pending</h2><p>Account access is temporarily unavailable. Please try again later.</p><a class="button button--secondary" href="/">Return home</a></div></section>}
</BaseLayout>
