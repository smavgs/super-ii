---
import ExploreLayout from '@/layouts/ExploreLayout.astro';
import { sqlClient } from '@/lib/db';
import { ensureAuthenticatedProfile } from '@/lib/auth';
import '@/styles/workspace.css';

type OrganizationSummary = {
  handle: string;
  name: string;
  full_name: string | null;
  organization_type: string;
  logo_url: string | null;
  description: string | null;
  member_count: number;
  repository_count: number;
};

const sql = sqlClient(Astro.locals);
const authentication = typeof Astro.locals.auth === 'function' ? Astro.locals.auth() : null;
const signedIn = Boolean(authentication && 'userId' in authentication && authentication.userId);
if (signedIn) Astro.response.headers.set('Cache-Control', 'private, no-store');
let myOrganizations: Array<{ id: string; handle: string; full_name: string; role: string }> = [];
let membershipsUnavailable = true;
let organizations: OrganizationSummary[] = [];
let unavailable = false;
if (sql) {
  try {
    organizations = await sql`
      select o.handle, o.name, o.full_name, o.organization_type, o.logo_url,
             o.description,
             count(distinct m.profile_id)::integer as member_count,
             count(distinct r.id)::integer as repository_count
      from app.organizations o
      left join app.organization_members m on m.organization_id = o.id
      left join app.repositories r on r.owner_organization_id = o.id
        and r.visibility = 'public' and r.status = 'published'
      where o.is_public
      group by o.id
      order by o.updated_at desc
      limit 100
    ` as OrganizationSummary[];
  } catch {
    unavailable = true;
  }
  if (signedIn) {
    try {
      const profile = await ensureAuthenticatedProfile(Astro.locals, sql);
      if (profile) {
        myOrganizations = await sql`
          select o.id, o.handle, coalesce(o.full_name, o.name) as full_name, m.role
          from app.organization_members m join app.organizations o on o.id = m.organization_id
          where m.profile_id = ${profile.profileId}::uuid order by o.handle
        ` as typeof myOrganizations;
        membershipsUnavailable = false;
      }
    } catch { membershipsUnavailable = true; }
  }
}
---

<ExploreLayout active="organizations" title="Organizations" titleHelp="organization" eyebrow="Build as a team" description="Find teams and their public work, or give your own team a shared home for products, repositories and collaboration.">
  <Fragment slot="actions"><a class="button button--dark" href="/organizations/new"><i class="ph ph-buildings" aria-hidden="true"></i>Create organization</a></Fragment>
  {signedIn && <div class="shell"><details class="workspace-disclosure personal-work" id="my-organizations">
    <summary>My organizations<small>Your memberships and team work.</small></summary>
    <div class="workspace-disclosure__body">
      {membershipsUnavailable ? <p role="status">Your memberships could not be loaded. Please refresh to try again.</p> : myOrganizations.length ? <div class="account-list">
        {myOrganizations.map((organization) => <a href={`/organizations/${organization.handle}`}><span><strong data-no-translate>{organization.full_name}</strong><small>@<span data-no-translate>{organization.handle}</span> · {organization.role}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}
      </div> : <p>You do not belong to an organization yet.</p>}
      <p><a href="/organizations/new">Create organization</a></p>
    </div>
  </details></div>}

  <section class="shell explore-content" data-explore-filter>
    <div>
      <div class="explore-section-title">
        <h2>Public organizations</h2>
        <span class="explore-count" data-explore-count>{organizations.length}</span>
      </div>
      {organizations.length > 0 && <div class="explore-filter"><label>Filter these organizations<input type="search" data-explore-search autocomplete="off" /></label><button class="button button--secondary" type="button" data-explore-reset>Clear</button></div>}
      {organizations.length ? (
        <div class="capability-grid">
          {organizations.map((organization) => (
            <a class="capability-card" data-explore-item data-search={`${organization.full_name ?? organization.name} ${organization.handle} ${organization.description ?? ''} ${organization.organization_type}`} href={`/organizations/${organization.handle}`}>
              <div>
                {organization.logo_url && <img class="organization-logo organization-logo--small" src={organization.logo_url} alt="" loading="lazy" referrerpolicy="no-referrer" />}
                <p class="eyebrow">{organization.organization_type}</p>
                <h3 data-no-translate>{organization.full_name ?? organization.name}</h3>
                {organization.description ? <p data-no-translate>{organization.description}</p> : <p>@<span data-no-translate>{organization.handle}</span> on Super ii</p>}
              </div>
              <span class="card-link"><span>{organization.repository_count} repositories · {organization.member_count} members</span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-state__icon"><i class="ph ph-buildings" aria-hidden="true"></i></div>
          <p class="eyebrow">{unavailable ? 'Temporarily unavailable' : 'A clean start'}</p>
          <h2>{unavailable ? 'Organizations cannot be loaded.' : 'Create the first public organization'}</h2>
          <p>{unavailable ? 'Please try again shortly.' : 'Set up a real team profile, add your interests, and publish under one shared identity.'}</p>
          <a class="button button--dark" href="/organizations/new">Create organization</a>
        </div>
      )}
    </div>
    <p data-explore-empty hidden role="status">No matches in this list. Try a different search.</p>
  </section>
  <div class="shell"><details class="explore-panel" id="team-tools"><summary><i class="ph ph-users-three" aria-hidden="true"></i>What your team can do</summary><div class="explore-panel__body">

    <div class="feature-rows">
      <article class="feature-row">
        <h2>Shared identity 🏢</h2>
        <div>
          <p>Bring models, datasets, and apps under a clear organization name. Public work remains discoverable while ownership and contributor roles stay understandable.</p>
          <ul>
            <li><i class="ph ph-check" aria-hidden="true"></i> Organization profiles and public collections</li>
            <li><i class="ph ph-check" aria-hidden="true"></i> Owner, admin, maintainer, member, and viewer roles</li>
            <li><i class="ph ph-check" aria-hidden="true"></i> Personal and organization workspaces</li>
          </ul>
        </div>
      </article>
      <article class="feature-row">
        <h2>Review without friction ✅</h2>
        <div><p>Keep discussions close to releases and preserve an activity trail. Every public release is checked before it appears on Super ii.</p></div>
      </article>
    </div>


    <a class="button explore-cyan" href="/contact?interest=team">Discuss a team plan</a>
  </div></details></div>
</ExploreLayout>

<script>
  import '@/scripts/personal-work';
</script>
