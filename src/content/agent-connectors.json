      "status_label": "Verified setup",
      "transport": "streamable-http",
      "configuration_family": "toml",
      "configuration_version": "2026-09-01",
      "command": "codex mcp add superii --url https://superii.site/mcp",
      "verify_command": "codex mcp list",
      "config_path": "~/.codex/config.toml",
      "config_example": "[mcp_servers.superii]\nurl = \"https://superii.site/mcp\"\ndefault_tools_approval_mode = \"prompt\"",
      "notes": "Shared by the Codex app, CLI, and IDE extension on the same Codex host.",
      "source_url": "https://developers.openai.com/codex/mcp",
      "source_label": "OpenAI Codex MCP documentation"
    },
    {
