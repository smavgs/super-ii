      "transport": "streamable-http",
      "configuration_family": "json",
      "configuration_version": "1.4.4",
      "command": "curl -fsSL https://dev.meta.ai/install.sh | bash",
      "verify_command": "muse --version",
      "config_path": "~/.config/muse/settings.json",
      "config_example": "{\n  \"schema_version\": 1,\n  \"mcpServers\": {\n    \"superii\": {\n      \"type\": \"streamable-http\",\n      \"url\": \"https://superii.site/mcp\",\n      \"enabled\": true,\n      \"required\": false\n    }\n  }\n}",
      "notes": "Install Muse Code, merge the Super ii entry into settings.json, and start a new Muse session. The server is optional so Muse can still start if Super ii is temporarily unavailable; /mcp shows the connection and tools.",
