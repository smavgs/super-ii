      "transport": "streamable-http",
      "configuration_family": "json",
      "configuration_version": "current + V2",
      "command": null,
      "verify_command": "opencode mcp list",
      "config_path": "opencode.json",
      "config_example": null,
      "configuration_variants": [
        {
          "label": "Current OpenCode",
          "configuration_version": "current",
          "config_path": "opencode.json",
          "config_example": "{\n  \"$schema\": \"https://opencode.ai/config.json\",\n  \"mcp\": {\n    \"superii\": {\n      \"type\": \"remote\",\n      \"url\": \"https://superii.site/mcp\",\n      \"enabled\": true\n    }\n  }\n}",
          "notes": "Use this shape when servers sit directly under mcp."
        },
        {
          "label": "OpenCode V2",
          "configuration_version": "v2",
          "config_path": "opencode.json",
          "config_example": "{\n  \"mcp\": {\n    \"servers\": {\n      \"superii\": {\n        \"type\": \"remote\",\n        \"url\": \"https://superii.site/mcp\",\n        \"disabled\": false\n      }\n    }\n  }\n}",
          "notes": "Use this shape only when your OpenCode installation uses mcp.servers."
        }
      ],
      "notes": "One OpenCode connection with two supported configuration shapes. Choose the shape your installed OpenCode schema uses; the Super ii connector CLI detects it automatically.",
      "source_url": "https://docs.opencode.ai/docs/mcp-servers/",
      "source_label": "OpenCode MCP server documentation"
    },
    {
      "id": "muse-code",
      "name": "Muse Code",
      "vendor": "Meta",
      "status": "verified",
